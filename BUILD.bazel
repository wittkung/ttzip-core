# TTZip Core: High-performance native archiving and compression engine.

load("@rules_swift//swift:swift.bzl", "swift_interop_hint", "swift_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "CTTZipBridge",
    srcs = ["Sources/CTTZipBridge/CTTZipBridge.c"],
    hdrs = [
        "Sources/CTTZipBridge/include/CTTZipBridge.h",
        "Sources/CTTZipBridge/include/ttzip_engineFFI.h",
    ],
    aspect_hints = [":cttzipbridge_swift_interop"],
    includes = ["Sources/CTTZipBridge/include"],
    linkopts = [
        "-larchive",
        "-lbz2",
        "-llzma",
        "-liconv",
        "-lc++",
        "-lcompression",
        "-framework", "Security",
    ],
    tags = ["swift_module=CTTZipBridge"],
    deps = [
        "//products/ttzip/core/rust/ttzip-engine:ttzip_engine_static",
        "//third_party/fast-lzma2:fast-lzma2",
        "//third_party/lzfse:lzfse",
        "@libdeflate//:libdeflate",
        "@lz4//:lz4",
        "@lz4//:lz4_hc",
        "@zstd//:zstd",
    ],
)

swift_interop_hint(
    name = "cttzipbridge_swift_interop",
    module_map = "Sources/CTTZipBridge/include/module.modulemap",
    module_name = "CTTZipBridge",
)

swift_library(
    name = "TTZipCore",
    srcs = glob(
        ["Sources/TTZipCore/**/*.swift"],
        exclude = [],
    ),
    module_name = "TTZipCore",
    package_name = "ttzip",
    visibility = ["//visibility:public"],
    deps = [
        ":CTTZipBridge",
        "//infra/ttlog:TTLogKit",
    ],
)
