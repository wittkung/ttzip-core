        "@crates//:sha2",
        "@crates//:snap",
        "@crates//:subtle",
        "@crates//:symphonia",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:tree-sitter",
        "@crates//:tree-sitter-c",
        "@crates//:tree-sitter-css",
        "@crates//:tree-sitter-html",
        "@crates//:tree-sitter-javascript",
