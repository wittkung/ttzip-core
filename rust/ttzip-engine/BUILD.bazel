load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "ttzip_engine",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "ttzip_engine",
    crate_features = [
        "default",
        "full",
        "archive",
        "probe",
        "syntax",
        "media-player",
        "device-android",
