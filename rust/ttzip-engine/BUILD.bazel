    compile_data = [
        "Cargo.toml",
        "src/codecs/brotli/data/rfc7932_dictionary.bin",
    ],
    edition = "2021",
    deps = [
        "//products/ttzip/core/rust/crates/ttzip-device-android:ttzip_device_android",
        "@crates//:adler2",
        "@crates//:aes",
        "@crates//:brotli",
