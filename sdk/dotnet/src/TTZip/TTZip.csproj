<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>TTZip</RootNamespace>
    <AssemblyName>TTZip</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Witt Kung, TTZip Contributors</Authors>
    <Company>TTZip Authors</Company>
    <Description>High-performance native archiving, extraction, and compression engine for .NET 8+.</Description>
    <PackageLicenseExpression>BSD-3-Clause OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wittkung/ttzip-core</RepositoryUrl>
    <PackageTags>compression;zip;7z;tar;zstd;lz4;snappy;brotli;crc32;ffi;native;simd</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Multi-RID Unmanaged Native Assets for Packaging & Runtime Resolution -->
    <!-- Out-of-tree package building with pre-staged runtimes or external native directory -->
    <None Include="runtimes\**"
          PackagePath="runtimes"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('runtimes')" />
    <Content Include="$(TTZipNativeRuntimesDir)\**"
             Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
             PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Condition="'$(TTZipNativeRuntimesDir)' != '' and Exists('$(TTZipNativeRuntimesDir)')" />
  </ItemGroup>

</Project>
