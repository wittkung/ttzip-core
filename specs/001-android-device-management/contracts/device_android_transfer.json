{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AndroidTransferJobSchema",
  "description": "JSON Schema validating file transfer and direct extraction job status contracts",
  "type": "object",
  "required": [
    "jobId",
    "direction",
    "sourcePath",
    "destinationPath",
    "totalBytes",
    "transferredBytes",
    "currentSpeedBps",
    "status"
  ],
  "properties": {
    "jobId": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "MacToAndroid",
        "AndroidToMac",
        "DirectPipelineExtract"
      ]
    },
    "sourcePath": {
      "type": "string"
    },
    "destinationPath": {
      "type": "string"
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0
    },
    "transferredBytes": {
      "type": "integer",
      "minimum": 0
    },
    "currentSpeedBps": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "Queued",
        "Transferring",
        "Paused",
        "Cancelling",
        "Completed",
        "Failed"
      ]
    },
    "errorMessage": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
