{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BenchmarkMatrixReport",
  "type": "object",
  "required": [
    "timestamp",
    "totalMatchups",
    "ttzipWins",
    "ttzipLosses",
    "winRatePercent",
    "results"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "totalMatchups": {
      "type": "integer",
      "minimum": 0
    },
    "ttzipWins": {
      "type": "integer",
      "minimum": 0
    },
    "ttzipLosses": {
      "type": "integer",
      "minimum": 0
    },
    "winRatePercent": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "format",
          "dimensionName",
          "level",
          "isEncrypted",
          "datasetSizeBytes",
          "ttzipCompressMBs",
          "ttzipExtractMBs",
          "competitorName",
          "competitorCompressMBs",
          "competitorExtractMBs",
          "compressSpeedup",
          "extractSpeedup",
          "isDominant"
        ],
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "7z", "zip", "tar", "tar.zst", "zst", "tar.gz", "gz",
              "tar.bz2", "bz2", "tar.xz", "xz", "lzip", "lz4",
              "brotli", "lrzip", "aar", "snappy", "wim", "dmg", "iso"
            ]
          },
          "dimensionName": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "isEncrypted": {
            "type": "boolean"
          },
          "datasetSizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "ttzipCompressMBs": {
            "type": "number",
            "minimum": 0.0
          },
          "ttzipExtractMBs": {
            "type": "number",
            "minimum": 0.0
          },
          "competitorName": {
            "type": "string"
          },
          "competitorCompressMBs": {
            "type": "number",
            "minimum": 0.0
          },
          "competitorExtractMBs": {
            "type": "number",
            "minimum": 0.0
          },
          "compressSpeedup": {
            "type": "number",
            "minimum": 0.0
          },
          "extractSpeedup": {
            "type": "number",
            "minimum": 0.0
          },
          "isDominant": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
