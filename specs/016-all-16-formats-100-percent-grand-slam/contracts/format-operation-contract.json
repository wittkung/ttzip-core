{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FormatOperationContract",
  "type": "object",
  "required": [
    "operationId",
    "format",
    "operationType",
    "inputPaths",
    "outputPath",
    "compressionLevel",
    "isEncrypted"
  ],
  "properties": {
    "operationId": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "7z", "zip", "tar", "tar.zst", "zst", "tar.gz", "gz",
        "tar.bz2", "bz2", "tar.xz", "xz", "lzip", "lz4",
        "brotli", "lrzip", "aar", "snappy", "wim", "dmg", "iso"
      ]
    },
    "operationType": {
      "type": "string",
      "enum": ["compress", "extract", "inspect"]
    },
    "inputPaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "outputPath": {
      "type": "string"
    },
    "compressionLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "isEncrypted": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
