{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZeroRegressionReport",
  "type": "object",
  "required": [
    "timestamp",
    "baselineFile",
    "latestFile",
    "totalMatchups",
    "improvedCount",
    "neutralCount",
    "warningCount",
    "criticalCount",
    "exitCode",
    "entries"
  ],
  "properties": {
    "timestamp": {
      "type": "string"
    },
    "baselineFile": {
      "type": "string"
    },
    "latestFile": {
      "type": "string"
    },
    "totalMatchups": {
      "type": "integer",
      "minimum": 0
    },
    "improvedCount": {
      "type": "integer",
      "minimum": 0
    },
    "neutralCount": {
      "type": "integer",
      "minimum": 0
    },
    "warningCount": {
      "type": "integer",
      "minimum": 0
    },
    "criticalCount": {
      "type": "integer",
      "minimum": 0
    },
    "exitCode": {
      "type": "integer",
      "enum": [0, 1, 2, 3]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "format",
          "dimensionName",
          "level",
          "isEncrypted",
          "operation",
          "beforeMBs",
          "afterMBs",
          "deltaPercent",
          "severity"
        ],
        "properties": {
          "format": {
            "type": "string"
          },
          "dimensionName": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "isEncrypted": {
            "type": "boolean"
          },
          "operation": {
            "type": "string",
            "enum": ["compress", "extract"]
          },
          "beforeMBs": {
            "type": "number",
            "minimum": 0
          },
          "afterMBs": {
            "type": "number",
            "minimum": 0
          },
          "deltaPercent": {
            "type": "number"
          },
          "severity": {
            "type": "string",
            "enum": ["PASS", "IMPROVEMENT", "WARNING", "CRITICAL_REGRESSION"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
