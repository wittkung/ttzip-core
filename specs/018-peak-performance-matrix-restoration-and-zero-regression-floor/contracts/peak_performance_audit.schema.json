{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PeakPerformanceAuditReport",
  "type": "object",
  "required": [
    "timestamp",
    "peakMatrixPath",
    "benchmarkReportPath",
    "totalCompared",
    "criticalRegressionCount",
    "isSuccess",
    "comparisons"
  ],
  "properties": {
    "timestamp": {
      "type": "string"
    },
    "peakMatrixPath": {
      "type": "string"
    },
    "benchmarkReportPath": {
      "type": "string"
    },
    "totalCompared": {
      "type": "integer",
      "minimum": 0
    },
    "criticalRegressionCount": {
      "type": "integer",
      "minimum": 0
    },
    "isSuccess": {
      "type": "boolean"
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "format",
          "dimensionName",
          "level",
          "isEncrypted",
          "operation",
          "peakMBs",
          "currentMBs",
          "dropPercent",
          "isCritical"
        ],
        "properties": {
          "format": { "type": "string" },
          "dimensionName": { "type": "string" },
          "level": { "type": "integer" },
          "isEncrypted": { "type": "boolean" },
          "operation": { "type": "string", "enum": ["compress", "extract"] },
          "peakMBs": { "type": "number", "minimum": 0 },
          "currentMBs": { "type": "number", "minimum": 0 },
          "dropPercent": { "type": "number" },
          "isCritical": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
