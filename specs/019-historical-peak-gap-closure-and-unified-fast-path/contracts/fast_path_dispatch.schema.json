{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FastPathDispatchDecision",
  "type": "object",
  "required": [
    "format",
    "containsDirectory",
    "totalBytes",
    "isHighEntropy",
    "engineType",
    "effectiveLevel"
  ],
  "properties": {
    "format": { "type": "string" },
    "containsDirectory": { "type": "boolean" },
    "totalBytes": { "type": "integer", "minimum": 0 },
    "isHighEntropy": { "type": "boolean" },
    "engineType": { "type": "string", "enum": ["C_NATIVE_DIRECT", "PARALLEL_STREAM", "IN_MEMORY_RAM"] },
    "effectiveLevel": { "type": "integer", "minimum": 0, "maximum": 9 }
  },
  "additionalProperties": false
}
