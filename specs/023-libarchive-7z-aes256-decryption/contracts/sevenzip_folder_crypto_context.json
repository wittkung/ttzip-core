{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SevenZipFolderCryptoContext",
  "description": "Schema for 7z folder decryption runtime context",
  "type": "object",
  "properties": {
    "is_encrypted": {
      "type": "integer",
      "enum": [0, 1],
      "description": "1 if folder is encrypted with AES-256-SHA256, 0 otherwise"
    },
    "props": {
      "$ref": "sevenzip_crypto_properties.json"
    },
    "derived_key_hex": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "256-bit AES key in hex encoding"
    },
    "key_is_cached": {
      "type": "integer",
      "enum": [0, 1],
      "description": "1 if derived key is cached, 0 otherwise"
    },
    "backend_type": {
      "type": "string",
      "enum": ["CommonCrypto", "OpenSSL", "WindowsCNG", "mbedTLS", "Nettle", "Fallback"],
      "description": "Active symmetric crypto backend provider"
    }
  },
  "required": [
    "is_encrypted",
    "props",
    "derived_key_hex",
    "key_is_cached",
    "backend_type"
  ],
  "additionalProperties": false
}
