{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArchiveEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "name",
    "uncompressedSize",
    "isDirectory",
    "isEncrypted",
    "isDataEncrypted",
    "isMetadataEncrypted"
  ],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Normalized internal archive path"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "File or folder base name"
    },
    "uncompressedSize": {
      "type": "integer",
      "minimum": 0,
      "description": "Uncompressed file size in bytes"
    },
    "isDirectory": {
      "type": "boolean",
      "description": "Whether the entry represents a directory"
    },
    "isEncrypted": {
      "type": "boolean",
      "description": "True if payload or header is encrypted"
    },
    "isDataEncrypted": {
      "type": "boolean",
      "description": "True if entry payload content is encrypted"
    },
    "isMetadataEncrypted": {
      "type": "boolean",
      "description": "True if entry metadata was encrypted"
    },
    "encryptionMethod": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "WinZip-AES-128",
        "WinZip-AES-256",
        "ZipCrypto",
        "7z-AES-256",
        "RAR4-AES-128",
        "RAR5-AES-256",
        "Unknown",
        null
      ],
      "description": "Identified encryption algorithm"
    },
    "modificationDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Entry modification timestamp in ISO 8601"
    },
    "detectedEncoding": {
      "type": [
        "string",
        "null"
      ],
      "description": "Detected text encoding string"
    }
  }
}
