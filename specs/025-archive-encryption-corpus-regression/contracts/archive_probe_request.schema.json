{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArchiveProbeRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "archivePath",
    "requestTimeoutMs"
  ],
  "properties": {
    "archivePath": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute filesystem path to target archive"
    },
    "requestTimeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000,
      "description": "Probe timeout limit in milliseconds"
    },
    "candidatePassphrases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional list of candidate passphrases to verify"
    }
  }
}
