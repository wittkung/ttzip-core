{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BenchmarkSamplingContract",
  "description": "Schema for microbenchmark multi-pass adaptive sampling and aggregation",
  "type": "object",
  "required": [
    "payloadBytes",
    "warmupPasses",
    "measuredPasses",
    "minDurationFloorSeconds",
    "minDuration",
    "medianDuration",
    "allDurations"
  ],
  "properties": {
    "payloadBytes": {
      "type": "integer",
      "minimum": 0
    },
    "warmupPasses": {
      "type": "integer",
      "minimum": 0
    },
    "measuredPasses": {
      "type": "integer",
      "minimum": 1
    },
    "minDurationFloorSeconds": {
      "type": "number",
      "minimum": 0
    },
    "minDuration": {
      "type": "number",
      "minimum": 0
    },
    "medianDuration": {
      "type": "number",
      "minimum": 0
    },
    "allDurations": {
      "type": "array",
      "items": {
        "type": "number"
      }
    }
  },
  "additionalProperties": false
}
