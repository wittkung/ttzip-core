{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FinalMileAuditContract",
  "description": "Schema for final mile zero regression and peak audit",
  "type": "object",
  "required": [
    "entryPathname",
    "isRootEntry",
    "sliceSizeBytes",
    "alignmentBytes",
    "useArmNeonCrypto"
  ],
  "properties": {
    "entryPathname": {
      "type": "string"
    },
    "isRootEntry": {
      "type": "boolean"
    },
    "sliceSizeBytes": {
      "type": "integer",
      "minimum": 1
    },
    "alignmentBytes": {
      "type": "integer",
      "minimum": 1
    },
    "useArmNeonCrypto": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
