{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LeapfrogAuditContract",
  "description": "Schema for full matrix leapfrog performance and deferred cleanup audit",
  "type": "object",
  "required": [
    "scenarioPrefix",
    "allocatedTempPaths",
    "isCleanupDeferred",
    "bufferCapacity",
    "isMagicMatched",
    "isDirectIOActive"
  ],
  "properties": {
    "scenarioPrefix": {
      "type": "string"
    },
    "allocatedTempPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "isCleanupDeferred": {
      "type": "boolean"
    },
    "bufferCapacity": {
      "type": "integer",
      "minimum": 0
    },
    "isMagicMatched": {
      "type": "boolean"
    },
    "isDirectIOActive": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
