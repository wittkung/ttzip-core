{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArchiveExtractionResponseContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "extractedFilesCount",
    "engineUsed"
  ],
  "properties": {
    "status": {
      "type": "integer",
      "description": "Result status code, 0 indicates success (TTZIP_OK)"
    },
    "extractedFilesCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of physical files extracted and verified"
    },
    "engineUsed": {
      "type": "string",
      "enum": [
        "native_parallel",
        "libarchive_fallback"
      ],
      "description": "Decompression and decryption engine that successfully extracted the archive"
    },
    "errorMessage": {
      "type": "string",
      "description": "Optional human-readable error or diagnostic message"
    }
  }
}
