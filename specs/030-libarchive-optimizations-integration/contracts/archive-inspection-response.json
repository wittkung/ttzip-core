{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArchiveInspectionResponseContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "entriesCount",
    "hasEncryptedEntries",
    "hasEncryptedHeader",
    "entries"
  ],
  "properties": {
    "status": {
      "type": "integer",
      "description": "Result status code, 0 indicates success (TTZIP_OK)"
    },
    "entriesCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of archive entries inspected"
    },
    "hasEncryptedEntries": {
      "type": "boolean",
      "description": "Whether any file in the archive has encrypted data payload"
    },
    "hasEncryptedHeader": {
      "type": "boolean",
      "description": "Whether the archive has encrypted central directory metadata"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pathname",
          "uncompressedSize",
          "isDirectory",
          "isDataEncrypted",
          "isMetadataEncrypted"
        ],
        "properties": {
          "pathname": {
            "type": "string",
            "minLength": 1,
            "description": "Relative path inside archive"
          },
          "uncompressedSize": {
            "type": "integer",
            "minimum": 0,
            "description": "Uncompressed file size in bytes"
          },
          "isDirectory": {
            "type": "boolean",
            "description": "True if entry is a directory"
          },
          "isDataEncrypted": {
            "type": "boolean",
            "description": "True if file payload is encrypted"
          },
          "isMetadataEncrypted": {
            "type": "boolean",
            "description": "True if filename and metadata are encrypted"
          }
        }
      }
    }
  }
}
