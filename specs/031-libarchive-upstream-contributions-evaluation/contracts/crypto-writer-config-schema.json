{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CryptoWriterConfig",
  "type": "object",
  "required": [
    "passphrase",
    "numCyclesPower",
    "saltBytes",
    "ivBytes",
    "headerEncryption"
  ],
  "additionalProperties": false,
  "properties": {
    "passphrase": {
      "type": "string",
      "minLength": 1
    },
    "numCyclesPower": {
      "type": "integer",
      "minimum": 10,
      "maximum": 24
    },
    "saltBytes": {
      "type": "integer",
      "enum": [16]
    },
    "ivBytes": {
      "type": "integer",
      "enum": [16]
    },
    "headerEncryption": {
      "type": "boolean"
    }
  }
}
