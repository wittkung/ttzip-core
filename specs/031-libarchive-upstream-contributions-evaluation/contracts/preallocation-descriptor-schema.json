{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PreallocationDescriptor",
  "type": "object",
  "required": [
    "filePath",
    "fileDescriptor",
    "expectedSize",
    "platformApi",
    "isContiguous"
  ],
  "additionalProperties": false,
  "properties": {
    "filePath": {
      "type": "string",
      "minLength": 1
    },
    "fileDescriptor": {
      "type": "integer",
      "minimum": 0
    },
    "expectedSize": {
      "type": "integer",
      "minimum": 1
    },
    "platformApi": {
      "type": "string",
      "enum": ["Darwin_F_PREALLOCATE", "POSIX_posix_fallocate", "Fallback_ftruncate"]
    },
    "isContiguous": {
      "type": "boolean"
    }
  }
}
