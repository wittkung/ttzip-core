{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UpstreamContributionProposal",
  "type": "object",
  "required": [
    "id",
    "title",
    "tier",
    "targetFiles",
    "upstreamStatus",
    "speedupFactor",
    "hasScalarFallback",
    "breakingChanges"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^C[0-9]{2}-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "tier": {
      "type": "string",
      "enum": ["Tier1", "Tier2", "Tier3"]
    },
    "targetFiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "upstreamStatus": {
      "type": "string",
      "enum": ["Proposed", "InDevelopment", "Submitted", "Merged", "InternalOnly"]
    },
    "prNumber": {
      "type": "integer",
      "minimum": 1
    },
    "speedupFactor": {
      "type": "number",
      "minimum": 1.0
    },
    "hasScalarFallback": {
      "type": "boolean"
    },
    "breakingChanges": {
      "type": "boolean",
      "enum": [false]
    }
  }
}
