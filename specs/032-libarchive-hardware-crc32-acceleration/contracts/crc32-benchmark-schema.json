{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRC32BenchmarkMetric",
  "type": "object",
  "required": [
    "bufferSizeBytes",
    "durationSeconds",
    "throughputMBs",
    "speedupVsBaseline",
    "isHardwareAccelerated"
  ],
  "additionalProperties": false,
  "properties": {
    "bufferSizeBytes": {
      "type": "integer",
      "minimum": 1
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0.0
    },
    "throughputMBs": {
      "type": "number",
      "minimum": 1.0
    },
    "speedupVsBaseline": {
      "type": "number",
      "minimum": 1.0
    },
    "isHardwareAccelerated": {
      "type": "boolean"
    }
  }
}
