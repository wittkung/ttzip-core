{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRC32ComputationContext",
  "type": "object",
  "required": [
    "initialCrc",
    "dataLength",
    "executionPath",
    "alignmentOffset",
    "unrolledChunksCount",
    "trailingBytesCount"
  ],
  "additionalProperties": false,
  "properties": {
    "initialCrc": {
      "type": "integer",
      "minimum": 0
    },
    "dataLength": {
      "type": "integer",
      "minimum": 0
    },
    "executionPath": {
      "type": "string",
      "enum": ["ARM_ACLE_8WAY", "ARM_ACLE_SCALAR", "PORTABLE_TABLE"]
    },
    "alignmentOffset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "unrolledChunksCount": {
      "type": "integer",
      "minimum": 0
    },
    "trailingBytesCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    }
  }
}
