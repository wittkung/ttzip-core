{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FullMatrixLeapfrogZeroFlatClosureSchema",
  "description": "JSON Schema contract for Feature 033 full matrix leapfrog zero flat closure",
  "type": "object",
  "required": ["streamConfig", "cryptoRoute", "auditResult"],
  "properties": {
    "streamConfig": {
      "$ref": "#/definitions/InProcessStreamConfig"
    },
    "cryptoRoute": {
      "$ref": "#/definitions/CryptoDispatchRoute"
    },
    "auditResult": {
      "$ref": "#/definitions/BenchmarkClosureAudit"
    }
  },
  "definitions": {
    "InProcessStreamConfig": {
      "type": "object",
      "required": ["format", "compressionLevel", "threadCount", "chunkSizeBytes", "useFastMode"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["lz4", "lzip", "lrzip", "tar.xz", "xz"]
        },
        "compressionLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "threadCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "chunkSizeBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        },
        "useFastMode": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "CryptoDispatchRoute": {
      "type": "object",
      "required": ["archivePath", "isEncrypted", "engineType", "useNeonSimd"],
      "properties": {
        "archivePath": {
          "type": "string",
          "minLength": 1
        },
        "isEncrypted": {
          "type": "boolean"
        },
        "engineType": {
          "type": "string",
          "enum": ["SevenZipEngine", "ZipParallelExtractor"]
        },
        "useNeonSimd": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "BenchmarkClosureAudit": {
      "type": "object",
      "required": ["totalDimensions", "improvedCount", "flatCount", "warningCount", "criticalCount", "allPassed"],
      "properties": {
        "totalDimensions": {
          "type": "integer",
          "minimum": 1
        },
        "improvedCount": {
          "type": "integer",
          "minimum": 0
        },
        "flatCount": {
          "type": "integer",
          "minimum": 0
        },
        "warningCount": {
          "type": "integer",
          "minimum": 0
        },
        "criticalCount": {
          "type": "integer",
          "minimum": 0
        },
        "allPassed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
