{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AtomicCommitSequence",
  "description": "Schema defining the atomic commit sequence for PR reconstruction.",
  "type": "object",
  "required": [
    "prNumber",
    "featureName",
    "totalCommits",
    "sequence"
  ],
  "properties": {
    "prNumber": {
      "type": "integer",
      "minimum": 1
    },
    "featureName": {
      "type": "string"
    },
    "totalCommits": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "tag",
          "summary",
          "stagedPaths",
          "bisectSafetyAssertion"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "tag": {
            "type": "string",
            "enum": ["infra", "feat", "test", "fix", "docs"]
          },
          "summary": {
            "type": "string"
          },
          "stagedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bisectSafetyAssertion": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
