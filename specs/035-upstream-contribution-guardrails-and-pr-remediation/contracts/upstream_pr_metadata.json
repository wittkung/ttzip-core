{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UpstreamPullRequestMetadata",
  "description": "Schema for upstream open source pull request submission metadata and review findings.",
  "type": "object",
  "required": [
    "title",
    "targetBranch",
    "sourceBranch",
    "baseCommitSha",
    "isDraft",
    "scopeValidationPassed",
    "commits"
  ],
  "properties": {
    "prNumber": {
      "type": "integer",
      "minimum": 1,
      "description": "Upstream GitHub Pull Request number."
    },
    "issueNumber": {
      "type": "integer",
      "minimum": 1,
      "description": "Associated upstream Issue number."
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120,
      "description": "Standard PR title following upstream conventions."
    },
    "targetBranch": {
      "type": "string",
      "enum": ["master", "main"],
      "description": "Target branch in upstream repository."
    },
    "sourceBranch": {
      "type": "string",
      "minLength": 3,
      "description": "Feature branch name on contributor fork."
    },
    "baseCommitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Clean ancestor commit SHA from upstream."
    },
    "isDraft": {
      "type": "boolean",
      "description": "Whether the PR is submitted as draft."
    },
    "scopeValidationPassed": {
      "type": "boolean",
      "description": "Assertion that git diff base..HEAD contains zero unrelated file changes."
    },
    "commits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequenceIndex",
          "commitType",
          "subject",
          "body",
          "filesIncluded",
          "compileCommand"
        ],
        "properties": {
          "sequenceIndex": {
            "type": "integer",
            "minimum": 1
          },
          "commitType": {
            "type": "string",
            "enum": ["infra", "feat", "test", "fix", "docs"]
          },
          "subject": {
            "type": "string",
            "maxLength": 72
          },
          "body": {
            "type": "string"
          },
          "filesIncluded": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "compileCommand": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
