{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LibarchiveArchitectureSpec",
  "description": "Schema for libarchive stream pipeline, OOP polymorphism and micro-buffering architecture specification.",
  "type": "object",
  "required": [
    "spec_version",
    "oop_polymorphism",
    "filter_pipeline",
    "micro_buffering",
    "state_machine"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "oop_polymorphism": {
      "type": "object",
      "required": [
        "inheritance_pattern",
        "vtable_tiers",
        "registration_strategy"
      ],
      "properties": {
        "inheritance_pattern": {
          "type": "string",
          "enum": ["STRUCT_FIRST_MEMBER_BASE"]
        },
        "vtable_tiers": {
          "type": "integer",
          "enum": [2]
        },
        "registration_strategy": {
          "type": "string",
          "enum": ["STATIC_SLOT_ARRAY_16"]
        }
      },
      "additionalProperties": false
    },
    "filter_pipeline": {
      "type": "object",
      "required": [
        "max_filter_depth",
        "bidding_protocol",
        "bid_score_unit"
      ],
      "properties": {
        "max_filter_depth": {
          "type": "integer",
          "enum": [25]
        },
        "bidding_protocol": {
          "type": "string",
          "enum": ["BIDIRECTIONAL_PEEK_SCORE"]
        },
        "bid_score_unit": {
          "type": "string",
          "enum": ["MATCHED_BIT_COUNT"]
        }
      },
      "additionalProperties": false
    },
    "micro_buffering": {
      "type": "object",
      "required": [
        "lookahead_api",
        "consume_api",
        "zero_copy_fast_path",
        "growth_factor"
      ],
      "properties": {
        "lookahead_api": {
          "type": "string",
          "enum": ["__archive_read_ahead"]
        },
        "consume_api": {
          "type": "string",
          "enum": ["__archive_read_consume"]
        },
        "zero_copy_fast_path": {
          "type": "boolean",
          "enum": [true]
        },
        "growth_factor": {
          "type": "number",
          "enum": [2.0]
        }
      },
      "additionalProperties": false
    },
    "state_machine": {
      "type": "object",
      "required": [
        "state_representation",
        "fatal_state_mask",
        "monotonic_error_chaining"
      ],
      "properties": {
        "state_representation": {
          "type": "string",
          "enum": ["BITMASK_FLAGS"]
        },
        "fatal_state_mask": {
          "type": "string",
          "enum": ["0x8000"]
        },
        "monotonic_error_chaining": {
          "type": "boolean",
          "enum": [true]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
