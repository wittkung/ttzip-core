{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepoLayoutBlueprint",
  "description": "Schema for multi-tier repository architecture layout and dependency isolation blueprint.",
  "type": "object",
  "required": [
    "blueprint_version",
    "tiers",
    "header_isolation_rules",
    "upstream_patch_workflow"
  ],
  "properties": {
    "blueprint_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "tiers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "tier_level",
          "name",
          "path",
          "responsibilities",
          "allowed_dependencies"
        ],
        "properties": {
          "tier_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "name": {
            "type": "string",
            "minLength": 5
          },
          "path": {
            "type": "string",
            "minLength": 3
          },
          "responsibilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "allowed_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "header_isolation_rules": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "upstream_patch_workflow": {
      "type": "object",
      "required": [
        "worktree_directory",
        "commit_convention",
        "bisect_guarantee"
      ],
      "properties": {
        "worktree_directory": {
          "type": "string",
          "enum": ["Vendor/worktrees/"]
        },
        "commit_convention": {
          "type": "string",
          "enum": ["INFRA_FEAT_TEST_THREE_STAGE"]
        },
        "bisect_guarantee": {
          "type": "boolean",
          "enum": [true]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
