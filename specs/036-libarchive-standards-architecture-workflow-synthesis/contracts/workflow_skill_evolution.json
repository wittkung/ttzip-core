{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowSkillEvolution",
  "description": "Schema for Agent Skills and Prompt/Workflow evolution specifications.",
  "type": "object",
  "required": [
    "evolution_version",
    "code_review_enhancements",
    "upstream_contribution_rules",
    "design_patterns_additions",
    "prompt_invariants"
  ],
  "properties": {
    "evolution_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "code_review_enhancements": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "upstream_contribution_rules": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "design_patterns_additions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "prompt_invariants": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  },
  "additionalProperties": false
}
