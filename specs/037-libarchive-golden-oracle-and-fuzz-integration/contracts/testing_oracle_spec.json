{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestingOracleSpec",
  "description": "Schema for Golden Oracle, Mutation Fuzzing, and System Differential testing specifications.",
  "type": "object",
  "required": [
    "spec_version",
    "uu_decoder",
    "fuzz_mutation",
    "differential_oracle"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "uu_decoder": {
      "type": "object",
      "required": [
        "algorithm",
        "min_throughput_mb_s"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["STANDARD_6BIT_TABLE_EXPANSION"]
        },
        "min_throughput_mb_s": {
          "type": "number",
          "enum": [100.0]
        }
      },
      "additionalProperties": false
    },
    "fuzz_mutation": {
      "type": "object",
      "required": [
        "mutation_ratio",
        "iterations_per_run",
        "crash_dump_filename",
        "dual_mode_consumption"
      ],
      "properties": {
        "mutation_ratio": {
          "type": "number",
          "enum": [0.01]
        },
        "iterations_per_run": {
          "type": "integer",
          "minimum": 100
        },
        "crash_dump_filename": {
          "type": "string",
          "enum": ["fuzz_crash_reproducer.bin"]
        },
        "dual_mode_consumption": {
          "type": "boolean",
          "enum": [true]
        }
      },
      "additionalProperties": false
    },
    "differential_oracle": {
      "type": "object",
      "required": [
        "system_tools",
        "byte_exact_sha256"
      ],
      "properties": {
        "system_tools": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "byte_exact_sha256": {
          "type": "boolean",
          "enum": [true]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
