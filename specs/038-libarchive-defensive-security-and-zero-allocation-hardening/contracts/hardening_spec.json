{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HardeningSpec",
  "description": "Schema for defensive security and zero-allocation hardening specifications.",
  "type": "object",
  "required": [
    "spec_version",
    "security_flags",
    "zero_allocation_enabled",
    "password_wipe_function"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "security_flags": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "ARCHIVE_EXTRACT_SECURE_SYMLINKS",
          "ARCHIVE_EXTRACT_SECURE_NODOTDOT",
          "ARCHIVE_EXTRACT_SECURE_NOABSOLUTEPATHS",
          "ARCHIVE_EXTRACT_UNLINK"
        ]
      }
    },
    "zero_allocation_enabled": {
      "type": "boolean",
      "enum": [true]
    },
    "password_wipe_function": {
      "type": "string",
      "enum": ["memset_s"]
    }
  },
  "additionalProperties": false
}
