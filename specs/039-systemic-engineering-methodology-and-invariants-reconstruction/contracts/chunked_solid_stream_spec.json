{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChunkedSolidStreamSpec",
  "description": "Schema for 7z Chunked Solid Streaming Pipeline specification.",
  "type": "object",
  "required": [
    "spec_version",
    "chunk_size_mb",
    "max_memory_budget_mb",
    "substreams_info_enabled",
    "streaming_write_enabled"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "chunk_size_mb": {
      "type": "integer",
      "enum": [32, 64]
    },
    "max_memory_budget_mb": {
      "type": "integer",
      "maximum": 128
    },
    "substreams_info_enabled": {
      "type": "boolean",
      "enum": [true]
    },
    "streaming_write_enabled": {
      "type": "boolean",
      "enum": [true]
    }
  },
  "additionalProperties": false
}
