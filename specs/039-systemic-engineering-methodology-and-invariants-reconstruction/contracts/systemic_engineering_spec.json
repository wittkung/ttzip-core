{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SystemicEngineeringSpec",
  "description": "Schema for TTZip Systemic Engineering Methodology & Core Invariants.",
  "type": "object",
  "required": [
    "spec_version",
    "core_invariants",
    "stream_first_constraints",
    "invariant_first_constraints",
    "bounds_first_constraints",
    "oracle_first_constraints"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "core_invariants": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "Stream-First",
          "Invariant-First",
          "Bounds-First",
          "Oracle-First"
        ]
      }
    },
    "stream_first_constraints": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "invariant_first_constraints": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "bounds_first_constraints": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "oracle_first_constraints": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
