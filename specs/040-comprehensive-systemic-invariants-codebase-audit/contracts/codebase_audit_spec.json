{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodebaseAuditReportSpec",
  "description": "Schema for TTZip Full Codebase Systemic Invariants Audit.",
  "type": "object",
  "required": [
    "spec_version",
    "audited_layers",
    "total_files_scanned",
    "risk_categories"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "audited_layers": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "total_files_scanned": {
      "type": "integer",
      "minimum": 50
    },
    "risk_categories": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "level",
          "dimension",
          "defect_count",
          "description"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": ["P0_CRITICAL", "P1_HIGH", "P2_MEDIUM", "P3_LOW"]
          },
          "dimension": {
            "type": "string",
            "enum": [
              "Stream-First",
              "Invariant-First",
              "Bounds-First",
              "Oracle-First"
            ]
          },
          "defect_count": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
