{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FuzzingHarnessSpec",
  "description": "Coverage-guided Fuzzing harness contract adhering to LLVMFuzzerTestOneInput standards",
  "type": "object",
  "required": [
    "entry_symbol",
    "corpus_directory",
    "crash_reproducer_file",
    "max_input_bytes"
  ],
  "additionalProperties": false,
  "properties": {
    "entry_symbol": {
      "type": "string",
      "enum": ["LLVMFuzzerTestOneInput"]
    },
    "corpus_directory": {
      "type": "string",
      "enum": ["Tests/Fuzz/Corpus"]
    },
    "crash_reproducer_file": {
      "type": "string",
      "enum": ["fuzz_crash_reproducer.bin"]
    },
    "max_input_bytes": {
      "type": "integer",
      "enum": [10485760]
    }
  }
}
