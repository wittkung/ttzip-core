{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlatformPathNormalizationResult",
  "description": "Cross-platform path sanitization and security analysis result schema",
  "type": "object",
  "required": [
    "originalPath",
    "normalizedPath",
    "isAbsolute",
    "isUNCPath",
    "isLongPath",
    "containsWindowsReservedDeviceName",
    "win32FormattedPath"
  ],
  "additionalProperties": false,
  "properties": {
    "originalPath": {
      "type": "string"
    },
    "normalizedPath": {
      "type": "string"
    },
    "isAbsolute": {
      "type": "boolean"
    },
    "isUNCPath": {
      "type": "boolean"
    },
    "isLongPath": {
      "type": "boolean"
    },
    "containsWindowsReservedDeviceName": {
      "type": "boolean"
    },
    "strippedAlternateDataStream": {
      "type": ["string", "null"]
    },
    "win32FormattedPath": {
      "type": "string"
    }
  }
}
