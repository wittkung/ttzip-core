{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipStatus",
  "description": "Schema for 6-level engine status and error codes aligned with libarchive",
  "type": "object",
  "required": [
    "code",
    "name",
    "isFatal",
    "allowsDataRecovery"
  ],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "integer",
      "enum": [1, 0, -10, -20, -25, -30]
    },
    "name": {
      "type": "string",
      "enum": ["EOF", "OK", "RETRY", "WARN", "FAILED", "FATAL"]
    },
    "isFatal": {
      "type": "boolean"
    },
    "allowsDataRecovery": {
      "type": "boolean"
    }
  }
}
