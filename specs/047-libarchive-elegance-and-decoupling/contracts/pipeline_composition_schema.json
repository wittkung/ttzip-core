{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArchivePipelineComposition",
  "description": "Schema for orthogonal container and stream filter composition in TTZip",
  "type": "object",
  "required": [
    "container",
    "filter",
    "supportsFastPathBypass",
    "displayName",
    "primaryFileExtension"
  ],
  "additionalProperties": false,
  "properties": {
    "container": {
      "type": "string",
      "enum": ["zip", "7z", "tar", "cpio", "ar", "iso", "wim", "raw"]
    },
    "filter": {
      "type": "string",
      "enum": ["none", "gzip", "bzip2", "xz", "zstd", "lz4", "brotli", "lzip", "lrzip"]
    },
    "supportsFastPathBypass": {
      "type": "boolean"
    },
    "displayName": {
      "type": "string"
    },
    "primaryFileExtension": {
      "type": "string"
    }
  }
}
