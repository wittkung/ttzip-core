{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CBridgeContractAudit",
  "description": "Schema for C bridge header and source file craftsmanship audit",
  "type": "object",
  "required": [
    "headerFile",
    "sourceFile",
    "hasDoxygenDocBlock",
    "hasOwnershipAnnotation",
    "hasClampingProtection",
    "hasSymmetricDeallocation"
  ],
  "additionalProperties": false,
  "properties": {
    "headerFile": {
      "type": "string"
    },
    "sourceFile": {
      "type": "string"
    },
    "hasDoxygenDocBlock": {
      "type": "boolean"
    },
    "hasOwnershipAnnotation": {
      "type": "boolean"
    },
    "hasClampingProtection": {
      "type": "boolean"
    },
    "hasSymmetricDeallocation": {
      "type": "boolean"
    }
  }
}
