{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ttzip.dev/schemas/silesia-benchmark-report.json",
  "title": "SilesiaBenchmarkReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "platform",
    "architecture",
    "cpuCores",
    "totalCorpusThroughputMBps",
    "records",
    "allPassed"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "type": "string",
      "enum": ["arm64", "x86_64"]
    },
    "cpuCores": {
      "type": "integer",
      "minimum": 1
    },
    "totalCorpusThroughputMBps": {
      "type": "number",
      "minimum": 0.0
    },
    "allPassed": {
      "type": "boolean"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fileName",
          "format",
          "uncompressedBytes",
          "compressedBytes",
          "compressionRatioPercent",
          "compressionDurationSeconds",
          "compressionThroughputMBps",
          "decompressionDurationSeconds",
          "decompressionThroughputMBps",
          "coefficientOfVariationPercent",
          "checksumMatched",
          "passedRegressionFloor"
        ],
        "properties": {
          "fileName": {
            "type": "string",
            "enum": [
              "dickens",
              "mozilla",
              "mr",
              "nci",
              "ooffice",
              "osdb",
              "reymont",
              "samba",
              "sao",
              "webster",
              "xml",
              "x-ray"
            ]
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "uncompressedBytes": {
            "type": "integer",
            "minimum": 1
          },
          "compressedBytes": {
            "type": "integer",
            "minimum": 1
          },
          "compressionRatioPercent": {
            "type": "number",
            "exclusiveMinimum": 0.0
          },
          "compressionDurationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0.0
          },
          "compressionThroughputMBps": {
            "type": "number",
            "exclusiveMinimum": 0.0
          },
          "decompressionDurationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0.0
          },
          "decompressionThroughputMBps": {
            "type": "number",
            "exclusiveMinimum": 0.0
          },
          "coefficientOfVariationPercent": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          "checksumMatched": {
            "type": "boolean"
          },
          "passedRegressionFloor": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
