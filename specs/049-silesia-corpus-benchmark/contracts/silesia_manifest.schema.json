{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ttzip.dev/schemas/silesia-manifest.json",
  "title": "SilesiaCorpusManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "corpusName",
    "totalFiles",
    "totalBytes",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "http://json-schema.org/draft-07/schema#"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "corpusName": {
      "type": "string",
      "minLength": 1
    },
    "totalFiles": {
      "type": "integer",
      "const": 12
    },
    "totalBytes": {
      "type": "integer",
      "const": 211945550
    },
    "files": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size",
          "sha256",
          "category",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "dickens",
              "mozilla",
              "mr",
              "nci",
              "ooffice",
              "osdb",
              "reymont",
              "samba",
              "sao",
              "webster",
              "xml",
              "x-ray"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "text",
              "executable",
              "image",
              "database",
              "source_code",
              "binary_data",
              "structured_text"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
