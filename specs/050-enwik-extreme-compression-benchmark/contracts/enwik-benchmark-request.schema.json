{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnwikBenchmarkRequest",
  "type": "object",
  "description": "Specification for executing an enwik corpus compression and decompression benchmark run.",
  "additionalProperties": false,
  "required": [
    "corpusId",
    "format",
    "algorithm",
    "compressionLevel",
    "threadCount",
    "enableLongDistanceMatching",
    "maxAllowedPeakRSSBytes"
  ],
  "properties": {
    "corpusId": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier of the corpus payload (e.g., 'enwik8', 'enwik9', 'synthetic-1gb')."
    },
    "format": {
      "type": "string",
      "enum": ["7z", "zstd", "tar.zst", "tar.xz", "bzip2", "zip"],
      "description": "Target container archive format."
    },
    "algorithm": {
      "type": "string",
      "enum": ["lzma2", "zstd", "bzip2", "deflate"],
      "description": "Compression algorithm utilized."
    },
    "compressionLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 22,
      "description": "Compression effort level."
    },
    "threadCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128,
      "description": "Concurrency worker thread count."
    },
    "enableLongDistanceMatching": {
      "type": "boolean",
      "description": "Whether Long Distance Matching (LDM) or extended match finder windows are activated."
    },
    "maxAllowedPeakRSSBytes": {
      "type": "integer",
      "minimum": 1048576,
      "description": "Maximum permissible peak resident set size in bytes before memory gating fails."
    }
  }
}
