{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HyperCompressBatchResult",
  "description": "Benchmark execution result schema for a single archive format under HyperCompressBench micro-file workload",
  "type": "object",
  "required": [
    "archiveFormat",
    "compressionLevel",
    "totalFiles",
    "totalUncompressedBytes",
    "compressedBytes",
    "compressionRatio",
    "compressionDurationSeconds",
    "compressionThroughputMBs",
    "extractionDurationSeconds",
    "extractionThroughputMBs",
    "peakResidentSetSizeMB",
    "byteExactVerified",
    "passedPerformanceFloor"
  ],
  "additionalProperties": false,
  "properties": {
    "archiveFormat": {
      "type": "string",
      "enum": ["zip", "7z", "tar.zst", "tar.gz", "tar.bz2", "tar.xz", "lz4", "wim"]
    },
    "compressionLevel": {
      "type": "string",
      "minLength": 1
    },
    "totalFiles": {
      "type": "integer",
      "minimum": 500
    },
    "totalUncompressedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "compressedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "compressionRatio": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 2.0
    },
    "compressionDurationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0.0
    },
    "compressionThroughputMBs": {
      "type": "number",
      "minimum": 0.0
    },
    "extractionDurationSeconds": {
      "type": "number",
      "exclusiveMinimum": 0.0
    },
    "extractionThroughputMBs": {
      "type": "number",
      "minimum": 0.0
    },
    "peakResidentSetSizeMB": {
      "type": "number",
      "minimum": 0.0
    },
    "byteExactVerified": {
      "type": "boolean"
    },
    "passedPerformanceFloor": {
      "type": "boolean"
    }
  }
}
