{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HyperCompressSuiteReport",
  "description": "Comprehensive telemetry report schema for full HyperCompressBench benchmark suite execution",
  "type": "object",
  "required": [
    "suiteVersion",
    "platformOS",
    "hardwareArchitecture",
    "profile",
    "scanMetric",
    "batchResults",
    "executionTimestamp",
    "allGatesPassed"
  ],
  "additionalProperties": false,
  "properties": {
    "suiteVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "platformOS": {
      "type": "string",
      "minLength": 1
    },
    "hardwareArchitecture": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "object",
      "required": [
        "profileId",
        "fileCount",
        "minFileSizeBytes",
        "maxFileSizeBytes",
        "jsonRatio",
        "logRatio",
        "highEntropyRatio",
        "maxDirectoryDepth",
        "directoryFanout",
        "seed"
      ],
      "additionalProperties": false,
      "properties": {
        "profileId": { "type": "string" },
        "fileCount": { "type": "integer", "minimum": 500 },
        "minFileSizeBytes": { "type": "integer", "minimum": 1 },
        "maxFileSizeBytes": { "type": "integer", "maximum": 65536 },
        "jsonRatio": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "logRatio": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "highEntropyRatio": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "maxDirectoryDepth": { "type": "integer", "minimum": 1 },
        "directoryFanout": { "type": "integer", "minimum": 2 },
        "seed": { "type": "string" }
      }
    },
    "scanMetric": {
      "type": "object",
      "required": [
        "totalNodesScanned",
        "directoryCount",
        "fileCount",
        "scanDurationSeconds",
        "nodesPerSecond",
        "peakOpenFDCount"
      ],
      "additionalProperties": false,
      "properties": {
        "totalNodesScanned": { "type": "integer", "minimum": 0 },
        "directoryCount": { "type": "integer", "minimum": 0 },
        "fileCount": { "type": "integer", "minimum": 0 },
        "scanDurationSeconds": { "type": "number", "exclusiveMinimum": 0.0 },
        "nodesPerSecond": { "type": "number", "minimum": 0.0 },
        "peakOpenFDCount": { "type": "integer", "minimum": 0, "maximum": 256 }
      }
    },
    "batchResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "archiveFormat",
          "compressionLevel",
          "totalFiles",
          "totalUncompressedBytes",
          "compressedBytes",
          "compressionRatio",
          "compressionDurationSeconds",
          "compressionThroughputMBs",
          "extractionDurationSeconds",
          "extractionThroughputMBs",
          "peakResidentSetSizeMB",
          "byteExactVerified",
          "passedPerformanceFloor"
        ],
        "additionalProperties": false,
        "properties": {
          "archiveFormat": { "type": "string" },
          "compressionLevel": { "type": "string" },
          "totalFiles": { "type": "integer" },
          "totalUncompressedBytes": { "type": "integer" },
          "compressedBytes": { "type": "integer" },
          "compressionRatio": { "type": "number" },
          "compressionDurationSeconds": { "type": "number" },
          "compressionThroughputMBs": { "type": "number" },
          "extractionDurationSeconds": { "type": "number" },
          "extractionThroughputMBs": { "type": "number" },
          "peakResidentSetSizeMB": { "type": "number" },
          "byteExactVerified": { "type": "boolean" },
          "passedPerformanceFloor": { "type": "boolean" }
        }
      }
    },
    "executionTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "allGatesPassed": {
      "type": "boolean"
    }
  }
}
