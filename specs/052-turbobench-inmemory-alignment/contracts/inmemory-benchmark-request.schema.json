{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InMemoryBenchmarkRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedFormats",
    "selectedLevels",
    "bufferSizeBytes",
    "warmupPasses",
    "minDurationMs",
    "useBinaryUnits",
    "turboBenchOutput"
  ],
  "properties": {
    "selectedFormats": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["zip", "7z", "tar", "zstd", "gz", "bz2", "xz", "lz4", "lzip", "lrzip", "brotli", "snappy", "wim", "dmg", "aar", "iso"]
      },
      "minItems": 1
    },
    "selectedLevels": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9
      },
      "minItems": 1
    },
    "bufferSizeBytes": {
      "type": "integer",
      "minimum": 1048576,
      "maximum": 1073741824
    },
    "warmupPasses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "minDurationMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    },
    "useBinaryUnits": {
      "type": "boolean"
    },
    "turboBenchOutput": {
      "type": "boolean"
    }
  }
}
