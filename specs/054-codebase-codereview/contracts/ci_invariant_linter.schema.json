{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CIInvariantLinterSchema",
  "type": "object",
  "required": ["scanTimestamp", "totalViolationsCount", "passed", "violations"],
  "properties": {
    "scanTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "totalViolationsCount": {
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "boolean"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "filePath", "lineNumber", "snippet", "remediationHint"],
        "properties": {
          "ruleId": {
            "type": "string",
            "enum": [
              "NO_HARDCODED_USERS_PATH",
              "NO_BARE_PRINT_LOGGING",
              "NO_HOTPATH_DATA_COUNT",
              "NO_CONCURRENT_PERFORM_LOCK"
            ]
          },
          "filePath": {
            "type": "string"
          },
          "lineNumber": {
            "type": "integer",
            "minimum": 1
          },
          "snippet": {
            "type": "string"
          },
          "remediationHint": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
