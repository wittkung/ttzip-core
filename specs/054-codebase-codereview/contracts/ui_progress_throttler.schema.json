{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UIProgressThrottlerEventSchema",
  "type": "object",
  "required": [
    "fractionCompleted",
    "processedBytes",
    "totalBytes",
    "currentFileName",
    "isTerminal",
    "timestampUptimeNanoseconds"
  ],
  "properties": {
    "fractionCompleted": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "processedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0
    },
    "currentFileName": {
      "type": "string"
    },
    "isTerminal": {
      "type": "boolean"
    },
    "timestampUptimeNanoseconds": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
