{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Adler32ChecksumResult",
  "description": "Schema for Adler-32 hardware accelerated calculation result and telemetry metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adler32",
    "bytesProcessed",
    "engineType",
    "elapsedNanoseconds"
  ],
  "properties": {
    "adler32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "Calculated 32-bit Adler-32 checksum value"
    },
    "bytesProcessed": {
      "type": "integer",
      "minimum": 0,
      "description": "Total bytes of payload processed"
    },
    "engineType": {
      "type": "string",
      "enum": [
        "arm_neon_dotprod",
        "arm_neon_baseline",
        "x86_avx2",
        "scalar_fallback"
      ],
      "description": "Actual hardware vectorized dispatch tier executed"
    },
    "elapsedNanoseconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Physical execution duration in nanoseconds"
    }
  }
}
