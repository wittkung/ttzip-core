{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BranchlessBitbufState",
  "description": "Schema for 64-bit branchless bitbuffer decoder state telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bitbuf64",
    "bitsLeft",
    "consumedBytes",
    "refillCount"
  ],
  "properties": {
    "bitbuf64": {
      "type": "integer",
      "minimum": 0,
      "description": "Current 64-bit unsigned accumulator word"
    },
    "bitsLeft": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63,
      "description": "Number of consumable bits currently available in accumulator"
    },
    "consumedBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Total bytes consumed from input bitstream buffer"
    },
    "refillCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Total invocation count of REFILL_BITS_BRANCHLESS"
    }
  }
}
