{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LZMA2MatchFinderContract",
  "description": "Strong-typed contract specification for LZMA2 SWAR Match Finder and Level 1 Fast Encoder pipeline",
  "type": "object",
  "required": ["match_len_function", "fast_encode_function", "performance_floors"],
  "properties": {
    "match_len_function": {
      "type": "object",
      "required": ["symbol_name", "input_parameters", "return_bounds"],
      "properties": {
        "symbol_name": {
          "type": "string",
          "enum": ["ttzip_match_len_neon"]
        },
        "input_parameters": {
          "type": "object",
          "required": ["p1_type", "p2_type", "max_len_type"],
          "properties": {
            "p1_type": { "type": "string", "enum": ["const uint8_t*"] },
            "p2_type": { "type": "string", "enum": ["const uint8_t*"] },
            "max_len_type": { "type": "string", "enum": ["uint32_t"] }
          },
          "additionalProperties": false
        },
        "return_bounds": {
          "type": "object",
          "required": ["min_value", "max_value_expression"],
          "properties": {
            "min_value": { "type": "integer", "minimum": 0 },
            "max_value_expression": { "type": "string", "enum": ["<= max_len"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fast_encode_function": {
      "type": "object",
      "required": ["symbol_name", "return_code_success", "zero_bypass_supported"],
      "properties": {
        "symbol_name": {
          "type": "string",
          "enum": ["ttzip_lzma2_fast_encode"]
        },
        "return_code_success": {
          "type": "integer",
          "enum": [0]
        },
        "zero_bypass_supported": {
          "type": "boolean",
          "enum": [true]
        }
      },
      "additionalProperties": false
    },
    "performance_floors": {
      "type": "object",
      "required": ["level1_10mb_min_mbs_debug", "level1_10mb_min_mbs_release", "level5_min_mbs_debug"],
      "properties": {
        "level1_10mb_min_mbs_debug": { "type": "number", "minimum": 3200.0 },
        "level1_10mb_min_mbs_release": { "type": "number", "minimum": 3900.0 },
        "level5_min_mbs_debug": { "type": "number", "minimum": 480.0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
