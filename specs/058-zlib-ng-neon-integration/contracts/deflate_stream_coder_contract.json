{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeflateStreamCoderContract",
  "description": "JSON Schema defining interface contract for dual-tier Deflate streaming operations in TTZip",
  "type": "object",
  "required": ["config", "session_id", "input_stream", "output_stream"],
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique session identifier for the streaming stream instance"
    },
    "config": {
      "type": "object",
      "required": ["tier_mode", "compression_level", "window_bits", "mem_level", "strategy"],
      "additionalProperties": false,
      "properties": {
        "tier_mode": {
          "type": "integer",
          "enum": [1, 2],
          "description": "1 = libdeflate block fast-path, 2 = zlib-ng streaming pipeline"
        },
        "compression_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9,
          "description": "Deflate compression level (1-9)"
        },
        "window_bits": {
          "type": "integer",
          "enum": [-15, 15, 31],
          "description": "Window bits format: 15 (zlib header), 31 (gzip header), -15 (raw deflate)"
        },
        "mem_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9,
          "description": "Internal memory allocation level (default 8)"
        },
        "strategy": {
          "type": "integer",
          "enum": [0, 1, 2, 3, 4],
          "description": "Deflate strategy: 0=Default, 1=Filtered, 2=HuffmanOnly, 3=RLE, 4=Fixed"
        }
      }
    },
    "input_stream": {
      "type": "object",
      "required": ["chunk_size_bytes", "total_expected_bytes"],
      "additionalProperties": false,
      "properties": {
        "chunk_size_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216,
          "description": "Size of each input chunk in bytes"
        },
        "total_expected_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Total expected uncompressed size, or 0 if unknown streaming length"
        }
      }
    },
    "output_stream": {
      "type": "object",
      "required": ["buffer_capacity_bytes", "flush_mode"],
      "additionalProperties": false,
      "properties": {
        "buffer_capacity_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216,
          "description": "Size of output buffer allocated for receiving compressed bytes"
        },
        "flush_mode": {
          "type": "string",
          "enum": ["NO_FLUSH", "SYNC_FLUSH", "FULL_FLUSH", "FINISH"],
          "description": "Deflate flush mode on processing step"
        }
      }
    }
  }
}
