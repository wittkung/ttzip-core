{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRC64CBridgeInvocationContract",
  "description": "Interface contract for CTTZipBridge C native CRC64 acceleration functions",
  "type": "object",
  "required": [
    "function_name",
    "buffer_length_bytes",
    "initial_seed",
    "expected_return_type"
  ],
  "properties": {
    "function_name": {
      "type": "string",
      "enum": [
        "ttzip_crc64",
        "ttzip_crc64_pmull"
      ]
    },
    "buffer_length_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Buffer byte count passed as size_t"
    },
    "initial_seed": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{1,16}$|^[0-9]+$",
      "description": "Initial 64-bit seed (typically 0)"
    },
    "expected_return_type": {
      "type": "string",
      "enum": [
        "uint64_t"
      ]
    },
    "memory_invariants": {
      "type": "object",
      "required": [
        "zero_copy",
        "null_safe",
        "unaligned_safe"
      ],
      "properties": {
        "zero_copy": {
          "type": "boolean",
          "const": true
        },
        "null_safe": {
          "type": "boolean",
          "const": true
        },
        "unaligned_safe": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "additionalProperties": false
}
