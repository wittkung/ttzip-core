{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CRC64SwiftChecksumContract",
  "description": "Interface contract for Swift TTZipCore.CRC64Checksum API",
  "type": "object",
  "required": [
    "module",
    "type_name",
    "methods",
    "concurrency_model"
  ],
  "properties": {
    "module": {
      "type": "string",
      "const": "TTZipCore"
    },
    "type_name": {
      "type": "string",
      "const": "CRC64Checksum"
    },
    "concurrency_model": {
      "type": "string",
      "enum": [
        "Sendable",
        "Stateless"
      ]
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "parameters",
          "return_type",
          "inlinable"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "calculate(for:seed:)",
              "calculate(buffer:seed:)"
            ]
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "type"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "default_value": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "return_type": {
            "type": "string",
            "const": "UInt64"
          },
          "inlinable": {
            "type": "boolean",
            "const": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
