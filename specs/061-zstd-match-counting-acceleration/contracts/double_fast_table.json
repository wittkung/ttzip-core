{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DoubleFastTableSchema",
  "type": "object",
  "description": "Schema for TTZip Double-Fast Dual-Table Match Finder Workspace",
  "properties": {
    "table_small_entries": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 65536,
      "description": "Number of entries in small (4-byte) hash table"
    },
    "table_long_entries": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 65536,
      "description": "Number of entries in long (8-byte) hash table"
    },
    "hash_mask_small": {
      "type": "integer",
      "minimum": 65535,
      "maximum": 65535,
      "description": "Mask for 4-byte hash table index"
    },
    "hash_mask_long": {
      "type": "integer",
      "minimum": 65535,
      "maximum": 65535,
      "description": "Mask for 8-byte hash table index"
    },
    "workspace_size_bytes": {
      "type": "integer",
      "minimum": 524288,
      "maximum": 524288,
      "description": "Total contiguous workspace allocation size in bytes"
    }
  },
  "required": [
    "table_small_entries",
    "table_long_entries",
    "hash_mask_small",
    "hash_mask_long",
    "workspace_size_bytes"
  ],
  "additionalProperties": false
}
