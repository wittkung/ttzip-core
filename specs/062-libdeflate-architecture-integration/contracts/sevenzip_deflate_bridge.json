{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SevenZipDeflateBridgeContract",
  "description": "Strongly-typed contract for 7z raw DEFLATE (0x040108) in-process payload decoding",
  "type": "object",
  "required": ["method_id", "compressed_bytes", "expected_uncompressed_bytes", "crc32_match_required"],
  "properties": {
    "method_id": {
      "type": "integer",
      "enum": [262408, 40108]
    },
    "compressed_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "expected_uncompressed_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "crc32_match_required": {
      "type": "boolean"
    },
    "expected_crc32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "additionalProperties": false
}
