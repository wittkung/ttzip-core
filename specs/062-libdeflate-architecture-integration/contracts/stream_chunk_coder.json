{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StreamChunkCoderContract",
  "description": "Strongly-typed interface contract for unified libdeflate chunk streaming operations",
  "type": "object",
  "required": ["action", "stream_id", "window_bits", "level"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["init", "process_chunk", "flush", "destroy"]
    },
    "stream_id": {
      "type": "string",
      "format": "uuid"
    },
    "window_bits": {
      "type": "integer",
      "enum": [-15, 15, 31]
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "input_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "output_capacity": {
      "type": "integer",
      "minimum": 0
    },
    "flush_mode": {
      "type": "string",
      "enum": ["none", "sync", "finish"]
    }
  },
  "additionalProperties": false
}
