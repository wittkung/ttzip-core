{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LZ4EngineAndVFSSubsystemContract",
  "description": "Strongly-typed contract schema for TTZip LZ4 Engine operations, TAR.LZ4 streaming inspection and VFS caching subsystem.",
  "type": "object",
  "required": ["version", "operation", "requestId"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "compressBlock",
        "decompressBlock",
        "decompressBlockPartial",
        "inspectTarLz4Archive",
        "queryVfsCacheStats"
      ]
    },
    "request": {
      "type": "object",
      "oneOf": [
        {
          "title": "CompressBlockRequest",
          "required": ["operationType", "uncompressedSize", "dataBufferBase64", "acceleration"],
          "properties": {
            "operationType": {
              "type": "string",
              "enum": ["compressBlock"]
            },
            "uncompressedSize": {
              "type": "integer",
              "minimum": 0
            },
            "dataBufferBase64": {
              "type": "string"
            },
            "acceleration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65537
            }
          },
          "additionalProperties": false
        },
        {
          "title": "DecompressBlockRequest",
          "required": ["operationType", "compressedSize", "dataBufferBase64", "originalSizeHint"],
          "properties": {
            "operationType": {
              "type": "string",
              "enum": ["decompressBlock"]
            },
            "compressedSize": {
              "type": "integer",
              "minimum": 0
            },
            "dataBufferBase64": {
              "type": "string"
            },
            "originalSizeHint": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "title": "DecompressBlockPartialRequest",
          "required": ["operationType", "compressedSize", "dataBufferBase64", "targetDecompressedSize"],
          "properties": {
            "operationType": {
              "type": "string",
              "enum": ["decompressBlockPartial"]
            },
            "compressedSize": {
              "type": "integer",
              "minimum": 0
            },
            "dataBufferBase64": {
              "type": "string"
            },
            "targetDecompressedSize": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "title": "InspectTarLz4ArchiveRequest",
          "required": ["operationType", "archivePath"],
          "properties": {
            "operationType": {
              "type": "string",
              "enum": ["inspectTarLz4Archive"]
            },
            "archivePath": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "title": "QueryVfsCacheStatsRequest",
          "required": ["operationType"],
          "properties": {
            "operationType": {
              "type": "string",
              "enum": ["queryVfsCacheStats"]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "response": {
      "type": "object",
      "required": ["status", "requestId"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "error"]
        },
        "requestId": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "payload": {
          "type": "object",
          "properties": {
            "uncompressedSize": {
              "type": "integer",
              "minimum": 0
            },
            "compressedSize": {
              "type": "integer",
              "minimum": 0
            },
            "actualDecompressedSize": {
              "type": "integer",
              "minimum": 0
            },
            "isCompressed": {
              "type": "boolean"
            },
            "dataBufferBase64": {
              "type": "string"
            },
            "throughputMBs": {
              "type": "number",
              "minimum": 0.0
            },
            "tarEntries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "entryPath",
                  "tarHeaderOffset",
                  "payloadOffset",
                  "fileSize",
                  "fileMode",
                  "isDirectory",
                  "mtime"
                ],
                "properties": {
                  "entryPath": {
                    "type": "string"
                  },
                  "tarHeaderOffset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "payloadOffset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "fileSize": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "fileMode": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "isDirectory": {
                    "type": "boolean"
                  },
                  "mtime": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              }
            },
            "vfsCacheStats": {
              "type": "object",
              "required": [
                "ramBlockCount",
                "diskBlockCount",
                "totalRawBytesCached",
                "totalCompressedBytesStored",
                "compressionRatio",
                "cacheHitRate"
              ],
              "properties": {
                "ramBlockCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "diskBlockCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "totalRawBytesCached": {
                  "type": "integer",
                  "minimum": 0
                },
                "totalCompressedBytesStored": {
                  "type": "integer",
                  "minimum": 0
                },
                "compressionRatio": {
                  "type": "number",
                  "minimum": 1.0
                },
                "cacheHitRate": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "broadcastEvent": {
      "type": "object",
      "required": ["eventType", "timestamp", "payload"],
      "properties": {
        "eventType": {
          "type": "string",
          "enum": ["vfsCacheEviction", "tarScanProgress", "compressionAlert"]
        },
        "timestamp": {
          "type": "integer"
        },
        "payload": {
          "type": "object",
          "required": ["message"],
          "properties": {
            "message": {
              "type": "string"
            },
            "evictedChunkIndex": {
              "type": "integer"
            },
            "currentBytesScanned": {
              "type": "integer"
            },
            "totalBytes": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
