{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LZ4DeepIntegrationPerformanceAuditContract",
  "description": "Contract for verifying LZ4 deep integration throughput and zero regression audit.",
  "type": "object",
  "required": ["version", "records", "auditStatus"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "auditStatus": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "benchmarkScenario",
          "payloadSizeMB",
          "compressedSizeMB",
          "compressionRatio",
          "preThroughputMBs",
          "postThroughputMBs",
          "gainPercentage",
          "status"
        ],
        "properties": {
          "benchmarkScenario": {
            "type": "string"
          },
          "payloadSizeMB": {
            "type": "number",
            "minimum": 0.0
          },
          "compressedSizeMB": {
            "type": "number",
            "minimum": 0.0
          },
          "compressionRatio": {
            "type": "number",
            "minimum": 0.0
          },
          "preThroughputMBs": {
            "type": "number",
            "minimum": 0.0
          },
          "postThroughputMBs": {
            "type": "number",
            "minimum": 0.0
          },
          "gainPercentage": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": ["optimal", "acceptable", "regression"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
