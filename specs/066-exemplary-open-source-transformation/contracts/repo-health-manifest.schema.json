{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepositoryHealthManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_name",
    "version",
    "license",
    "supported_platforms",
    "architectures",
    "supported_formats_count",
    "ci_runners",
    "has_security_policy",
    "has_code_of_conduct",
    "has_contributing_guide"
  ],
  "properties": {
    "project_name": {
      "type": "string",
      "enum": ["TTZip"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "license": {
      "type": "string",
      "enum": ["MIT"]
    },
    "supported_platforms": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "architectures": {
      "type": "array",
      "items": { "type": "string", "enum": ["arm64", "x86_64"] },
      "minItems": 2
    },
    "supported_formats_count": {
      "type": "integer",
      "minimum": 16
    },
    "ci_runners": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "has_security_policy": {
      "type": "boolean"
    },
    "has_code_of_conduct": {
      "type": "boolean"
    },
    "has_contributing_guide": {
      "type": "boolean"
    }
  }
}
