{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLIReleaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "target_triple",
    "architectures",
    "sha256_checksum",
    "tarball_filename"
  ],
  "properties": {
    "name": {
      "type": "string",
      "enum": ["ttzip-cli"]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "target_triple": {
      "type": "string"
    },
    "architectures": {
      "type": "array",
      "items": { "type": "string", "enum": ["arm64", "x86_64"] },
      "minItems": 1
    },
    "sha256_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tarball_filename": {
      "type": "string"
    }
  }
}
