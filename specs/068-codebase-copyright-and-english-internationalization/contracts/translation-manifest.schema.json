{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodebaseTranslationManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "total_files_processed",
    "headers_injected",
    "comments_translated",
    "remaining_chinese_lines",
    "license_identifier",
    "copyright_holder"
  ],
  "properties": {
    "total_files_processed": {
      "type": "integer",
      "minimum": 1
    },
    "headers_injected": {
      "type": "integer",
      "minimum": 0
    },
    "comments_translated": {
      "type": "integer",
      "minimum": 0
    },
    "remaining_chinese_lines": {
      "type": "integer",
      "enum": [0]
    },
    "license_identifier": {
      "type": "string",
      "enum": ["BSD-3-Clause"]
    },
    "copyright_holder": {
      "type": "string"
    }
  }
}
