{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLICommandContract",
  "description": "Schema for TTZip POSIX CLI invocation arguments, options, and execution context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "positionalArguments",
    "options",
    "isInteractiveTTY",
    "terminalColumns",
    "language"
  ],
  "properties": {
    "command": {
      "type": "string",
      "enum": [
        "archive",
        "extract",
        "list",
        "test",
        "bench",
        "info",
        "diff",
        "recover",
        "repair",
        "completion",
        "man"
      ],
      "description": "Normalized primary subcommand"
    },
    "positionalArguments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Non-option positional file or directory arguments"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verboseLevel",
        "quiet",
        "assumeYes",
        "dryRun",
        "jsonOutput",
        "threads"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "zip",
            "7z",
            "tar",
            "tar.gz",
            "tar.zst",
            "tar.bz2",
            "tar.xz",
            "lz4",
            "zstd",
            "wim",
            "dmg",
            "iso",
            "brotli",
            "lzip",
            "lrzip",
            "aar",
            "snappy",
            "ALL"
          ]
        },
        "compressionLevel": {
          "type": "string",
          "pattern": "^(store|fastest|fast|normal|maximum|ultra|[0-9])$"
        },
        "password": {
          "type": "string"
        },
        "outputPath": {
          "type": "string"
        },
        "splitSize": {
          "type": "string",
          "pattern": "^[0-9]+[kKmMgGtT]?[bB]?$"
        },
        "verboseLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "quiet": {
          "type": "boolean"
        },
        "assumeYes": {
          "type": "boolean"
        },
        "dryRun": {
          "type": "boolean"
        },
        "jsonOutput": {
          "type": "boolean"
        },
        "threads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "colorMode": {
          "type": "string",
          "enum": ["always", "never", "auto"]
        },
        "filterTier": {
          "type": "string",
          "pattern": "^[0-5](,[0-5])*$"
        }
      }
    },
    "isInteractiveTTY": {
      "type": "boolean",
      "description": "Whether standard output is connected to an interactive TTY device"
    },
    "terminalColumns": {
      "type": "integer",
      "minimum": 10,
      "maximum": 1000,
      "description": "Current terminal column width from ioctl TIOCGWINSZ"
    },
    "language": {
      "type": "string",
      "enum": ["en", "zh-Hans", "zh-Hant", "ja", "de", "fr", "es"]
    }
  }
}
