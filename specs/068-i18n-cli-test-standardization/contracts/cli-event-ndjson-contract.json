{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLIEventNDJSONContract",
  "description": "Schema for TTZip NDJSON machine-readable event stream emitted on stdout in --json mode",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "timestamp"],
  "properties": {
    "event": {
      "type": "string",
      "enum": ["progress", "completed", "error", "security_intercept", "unlock_vault"]
    },
    "timestamp": {
      "type": "number",
      "description": "Monotonic timestamp in seconds since epoch"
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fraction", "bytes_processed", "total_bytes", "speed_mbs", "current_file"],
      "properties": {
        "fraction": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "bytes_processed": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "speed_mbs": {
          "type": "number",
          "minimum": 0.0
        },
        "current_file": {
          "type": "string"
        }
      }
    },
    "completed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "duration_seconds", "total_bytes", "average_throughput_mbs"],
      "properties": {
        "exit_code": {
          "type": "integer",
          "enum": [0, 64, 65, 66, 69, 70, 73, 74, 77, 130]
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0.0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "average_throughput_mbs": {
          "type": "number",
          "minimum": 0.0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "error_code", "message"],
      "properties": {
        "exit_code": {
          "type": "integer",
          "enum": [64, 65, 66, 69, 70, 73, 74, 77, 130]
        },
        "error_code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "target_path": {
          "type": "string"
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "event": { "const": "progress" }
      },
      "required": ["progress"]
    },
    {
      "properties": {
        "event": { "const": "completed" }
      },
      "required": ["completed"]
    },
    {
      "properties": {
        "event": { "const": "error" }
      },
      "required": ["error"]
    }
  ]
}
