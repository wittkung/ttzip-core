{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "I18nCatalogContract",
  "description": "Schema for TTZip static localization dictionary and locale packs",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "displayName", "bcp47Code", "fallbackLanguage", "entries"],
  "properties": {
    "language": {
      "type": "string",
      "enum": ["en", "zh-Hans", "zh-Hant", "ja", "de", "fr", "es"],
      "description": "Standard ISO 639-1 / BCP 47 language identifier"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "description": "Native display name of the language"
    },
    "bcp47Code": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$",
      "description": "Strict BCP 47 language tag"
    },
    "fallbackLanguage": {
      "type": "string",
      "enum": ["en", "zh-Hans"],
      "description": "Cascading fallback language if a key is missing"
    },
    "entries": {
      "type": "object",
      "description": "Key-value mapping of type-safe localization strings",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
      }
    }
  }
}
