{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestReportContract",
  "description": "Schema for TTZip structured test execution session and JSON report export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "timestamp",
    "hostHardware",
    "osVersion",
    "targetTiers",
    "totalTests",
    "passedTests",
    "failedTests",
    "skippedTests",
    "totalDurationSeconds",
    "testCases"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "hostHardware": {
      "type": "string",
      "minLength": 1
    },
    "osVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetTiers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tier0Micro",
          "tier1Integration",
          "tier2Differential",
          "tier3PerformanceGate",
          "tier4CrashFuzz",
          "tier5StressScale"
        ]
      },
      "minItems": 1
    },
    "totalTests": {
      "type": "integer",
      "minimum": 0
    },
    "passedTests": {
      "type": "integer",
      "minimum": 0
    },
    "failedTests": {
      "type": "integer",
      "minimum": 0
    },
    "skippedTests": {
      "type": "integer",
      "minimum": 0
    },
    "totalDurationSeconds": {
      "type": "number",
      "minimum": 0.0
    },
    "testCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "className",
          "tier",
          "durationSeconds",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "className": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string",
            "enum": [
              "tier0Micro",
              "tier1Integration",
              "tier2Differential",
              "tier3PerformanceGate",
              "tier4CrashFuzz",
              "tier5StressScale"
            ]
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0.0
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped"]
          },
          "failureMessage": {
            "type": "string"
          },
          "hexdumpDiff": {
            "type": "string"
          },
          "throughputMBs": {
            "type": "number",
            "minimum": 0.0
          }
        }
      }
    }
  }
}
