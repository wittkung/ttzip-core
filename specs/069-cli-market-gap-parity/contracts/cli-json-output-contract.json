{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLIJsonOutputContract",
  "description": "Discriminated schema for all structured machine-readable JSON outputs emitted by ttzip-cli",
  "type": "object",
  "required": ["schema_version", "event", "exit_code", "status", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "event": {
      "type": "string",
      "enum": [
        "completed",
        "error",
        "archive_metadata",
        "archive_tree",
        "test_results",
        "hash_results"
      ]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "status": {
      "type": "string",
      "enum": ["success", "warning", "error", "aborted"]
    },
    "payload": {
      "type": "object",
      "oneOf": [
        {
          "title": "CompletedPayload",
          "additionalProperties": false,
          "required": [
            "operation",
            "duration_seconds",
            "total_bytes",
            "throughput_mbs"
          ],
          "properties": {
            "operation": { "type": "string" },
            "duration_seconds": { "type": "number", "minimum": 0.0 },
            "total_bytes": { "type": "integer", "minimum": 0 },
            "throughput_mbs": { "type": "number", "minimum": 0.0 },
            "destination_dir": { "type": "string" },
            "output_path": { "type": "string" },
            "files_processed": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "title": "ErrorPayload",
          "additionalProperties": false,
          "required": ["error_message", "error_domain", "error_code"],
          "properties": {
            "error_message": { "type": "string" },
            "error_domain": { "type": "string" },
            "error_code": { "type": "integer" },
            "target_path": { "type": "string" },
            "suggestion": { "type": "string" }
          }
        },
        {
          "title": "ArchiveMetadataPayload",
          "additionalProperties": false,
          "required": ["archive_path", "total_entries", "entries"],
          "properties": {
            "archive_path": { "type": "string" },
            "total_entries": { "type": "integer", "minimum": 0 },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "uncompressed_size",
                  "compressed_size",
                  "is_directory",
                  "crc32",
                  "mtime_epoch",
                  "encoding"
                ],
                "properties": {
                  "path": { "type": "string" },
                  "uncompressed_size": { "type": "integer", "minimum": 0 },
                  "compressed_size": { "type": "integer", "minimum": 0 },
                  "is_directory": { "type": "boolean" },
                  "crc32": { "type": "string" },
                  "sha256": { "type": "string" },
                  "mtime_epoch": { "type": "integer" },
                  "permissions": { "type": "integer" },
                  "is_encrypted": { "type": "boolean" },
                  "encoding": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "title": "ArchiveTreePayload",
          "additionalProperties": false,
          "required": ["archive_path", "total_files", "total_directories", "root"],
          "properties": {
            "archive_path": { "type": "string" },
            "total_files": { "type": "integer", "minimum": 0 },
            "total_directories": { "type": "integer", "minimum": 0 },
            "root": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "path", "is_directory", "size_bytes", "children"],
              "properties": {
                "name": { "type": "string" },
                "path": { "type": "string" },
                "is_directory": { "type": "boolean" },
                "size_bytes": { "type": "integer", "minimum": 0 },
                "children": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "path", "is_directory", "size_bytes"],
                    "properties": {
                      "name": { "type": "string" },
                      "path": { "type": "string" },
                      "is_directory": { "type": "boolean" },
                      "size_bytes": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "title": "HashResultsPayload",
          "additionalProperties": false,
          "required": ["archive_path", "algorithm", "hashes"],
          "properties": {
            "archive_path": { "type": "string" },
            "algorithm": { "type": "string", "enum": ["crc32", "sha256", "md5"] },
            "hashes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "hash", "size"],
                "properties": {
                  "path": { "type": "string" },
                  "hash": { "type": "string" },
                  "size": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
