{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLIOptionsContract",
  "description": "Validated CLI command line execution options and filters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "positionals",
    "threads",
    "dryRun",
    "jsonOutput",
    "noColor",
    "assumeYes",
    "force",
    "verbosity",
    "overwritePolicy",
    "filterOptions"
  ],
  "properties": {
    "positionals": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Positional non-option arguments"
    },
    "outputPath": {
      "type": ["string", "null"],
      "description": "Destination directory or output file path ('-' for stdout)"
    },
    "password": {
      "type": ["string", "null"],
      "description": "Decryption/encryption passphrase"
    },
    "passwordFile": {
      "type": ["string", "null"],
      "description": "Path to file containing password"
    },
    "format": {
      "type": ["string", "null"],
      "description": "Archive compression format (zip, 7z, tar.zst, etc.)"
    },
    "level": {
      "type": ["string", "null"],
      "description": "Compression level (0..9, store, fast, ultra)"
    },
    "splitSize": {
      "type": ["string", "null"],
      "description": "Split volume size specification (e.g. 100M, 1G)"
    },
    "threads": {
      "type": "integer",
      "minimum": 0,
      "description": "Concurrency thread count (0 for auto)"
    },
    "dryRun": {
      "type": "boolean",
      "description": "Dry-run simulation mode"
    },
    "jsonOutput": {
      "type": "boolean",
      "description": "Output machine-readable NDJSON stream"
    },
    "noColor": {
      "type": "boolean",
      "description": "Disable ANSI color escape sequences"
    },
    "assumeYes": {
      "type": "boolean",
      "description": "Assume yes on all interactive prompts"
    },
    "force": {
      "type": "boolean",
      "description": "Force binary output to TTY or bypass safety checks"
    },
    "verbosity": {
      "type": "integer",
      "minimum": -1,
      "maximum": 2,
      "description": "Log verbosity level (-1: quiet, 0: default, 1: verbose, 2: debug)"
    },
    "overwritePolicy": {
      "type": "string",
      "enum": ["prompt", "always", "never", "newer", "backup"],
      "description": "File collision overwrite policy"
    },
    "filterOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "excludePatterns",
        "includePatterns",
        "stripComponents",
        "excludeVCS",
        "noMacMetadata",
        "flattenPaths",
        "nullDelimiter"
      ],
      "properties": {
        "excludePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "POSIX glob exclusion wildcards"
        },
        "includePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "POSIX glob inclusion wildcards"
        },
        "stripComponents": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of leading path elements to strip"
        },
        "excludeVCS": {
          "type": "boolean",
          "description": "Exclude VCS files and directories (.git, .svn)"
        },
        "noMacMetadata": {
          "type": "boolean",
          "description": "Exclude macOS metadata files (.DS_Store, __MACOSX)"
        },
        "flattenPaths": {
          "type": "boolean",
          "description": "Extract all files flat into destination folder"
        },
        "filesFromPath": {
          "type": ["string", "null"],
          "description": "Path to file containing newline-separated file list"
        },
        "nullDelimiter": {
          "type": "boolean",
          "description": "Read file list separated by NUL bytes"
        }
      }
    },
    "treeDepth": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Maximum recursion depth for tree rendering"
    }
  }
}
