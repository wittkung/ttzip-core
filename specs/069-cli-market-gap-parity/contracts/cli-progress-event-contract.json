{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLIProgressEventContract",
  "description": "Schema for real-time progress broadcast events emitted in NDJSON mode",
  "type": "object",
  "required": ["event", "payload"],
  "additionalProperties": false,
  "properties": {
    "event": {
      "type": "string",
      "enum": ["progress", "status_change", "threat_intercepted"]
    },
    "payload": {
      "type": "object",
      "oneOf": [
        {
          "title": "ProgressPayload",
          "additionalProperties": false,
          "required": [
            "fraction",
            "bytes_processed",
            "total_bytes",
            "speed_mbs",
            "current_file"
          ],
          "properties": {
            "fraction": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "bytes_processed": { "type": "integer", "minimum": 0 },
            "total_bytes": { "type": "integer", "minimum": 0 },
            "speed_mbs": { "type": "number", "minimum": 0.0 },
            "current_file": { "type": "string" },
            "eta_seconds": { "type": "number", "minimum": 0.0 }
          }
        },
        {
          "title": "ThreatPayload",
          "additionalProperties": false,
          "required": ["threat_type", "target_path", "action_taken"],
          "properties": {
            "threat_type": { "type": "string" },
            "target_path": { "type": "string" },
            "action_taken": { "type": "string" }
          }
        }
      ]
    }
  }
}
