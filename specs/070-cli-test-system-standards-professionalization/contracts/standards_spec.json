{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArchiveFormatStandardSpec",
  "description": "Standard metadata and compliance rules for compression and archive formats",
  "type": "object",
  "required": [
    "id",
    "format",
    "officialName",
    "standardCitations",
    "mimeType",
    "appleUTI",
    "magicSignatures",
    "supportedEncryption",
    "supportsMultiVolume",
    "supportedExtraFields"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for format (e.g. zip, 7z, tar.zst)"
    },
    "format": {
      "type": "string",
      "enum": [
        "zip",
        "sevenZip",
        "tar",
        "tarGz",
        "tarBz2",
        "tarXz",
        "tarZst",
        "gz",
        "bz2",
        "xz",
        "zst",
        "lzip",
        "lz4",
        "brotli",
        "lrzip",
        "snappy",
        "wim",
        "dmg",
        "iso",
        "aar",
        "rar",
        "cab"
      ]
    },
    "officialName": {
      "type": "string",
      "description": "Official name of the specification"
    },
    "standardCitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["organization", "standardNumber", "title", "canonicalURL"],
        "properties": {
          "organization": { "type": "string" },
          "standardNumber": { "type": "string" },
          "title": { "type": "string" },
          "canonicalURL": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    },
    "mimeType": {
      "type": "string"
    },
    "appleUTI": {
      "type": "string"
    },
    "magicSignatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["anchorType", "offset", "bytesHex", "description"],
        "properties": {
          "anchorType": {
            "type": "string",
            "enum": ["head", "tail", "sector", "tarOffset"]
          },
          "offset": { "type": "integer" },
          "bytesHex": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "supportedEncryption": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["standardName", "keyDerivationFunction", "cipher"],
        "properties": {
          "standardName": { "type": "string" },
          "keyDerivationFunction": { "type": "string" },
          "cipher": { "type": "string" },
          "authenticationTag": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "supportsMultiVolume": {
      "type": "boolean"
    },
    "supportedExtraFields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["headerID", "name", "sourceSpecification"],
        "properties": {
          "headerID": { "type": "integer" },
          "name": { "type": "string" },
          "sourceSpecification": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
