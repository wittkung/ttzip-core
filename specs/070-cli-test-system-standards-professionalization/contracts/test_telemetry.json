{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestTelemetryEvent",
  "description": "Structured NDJSON telemetry event emitted during test execution",
  "type": "object",
  "required": ["eventType", "timestamp", "sessionID"],
  "properties": {
    "eventType": {
      "type": "string",
      "enum": [
        "testRunStarted",
        "suiteStarted",
        "testCaseStarted",
        "testCasePassed",
        "testCaseFailed",
        "testCaseSkipped",
        "suiteFinished",
        "testRunFinished"
      ]
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 formatted timestamp"
    },
    "sessionID": {
      "type": "string",
      "description": "Unique session identifier"
    },
    "suiteName": {
      "type": "string"
    },
    "testCaseName": {
      "type": "string"
    },
    "durationMs": {
      "type": "number"
    },
    "error": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string" },
        "diff": { "type": "string" },
        "stackTrace": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["totalTests", "passedTests", "failedTests", "skippedTests", "passRate"],
      "properties": {
        "totalTests": { "type": "integer" },
        "passedTests": { "type": "integer" },
        "failedTests": { "type": "integer" },
        "skippedTests": { "type": "integer" },
        "passRate": { "type": "number" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
