{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShellCompletionRequest",
  "description": "Request schema for generating shell tab completion scripts",
  "type": "object",
  "properties": {
    "shellTarget": {
      "type": "string",
      "enum": [
        "zsh",
        "bash",
        "fish",
        "nushell"
      ]
    },
    "binaryName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "includeAliases": {
      "type": "boolean"
    }
  },
  "required": [
    "shellTarget",
    "binaryName",
    "includeAliases"
  ],
  "additionalProperties": false
}
