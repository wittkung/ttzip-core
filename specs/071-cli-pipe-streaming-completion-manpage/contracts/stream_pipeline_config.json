{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StreamPipelineConfig",
  "description": "Configuration schema governing UNIX stream pipeline execution in TTZip CLI",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "directFile",
        "standardInputPipe",
        "standardOutputPipe",
        "duplexPipe",
        "singleEntryStdout"
      ]
    },
    "inputPath": {
      "type": ["string", "null"]
    },
    "outputPath": {
      "type": ["string", "null"]
    },
    "singleEntryName": {
      "type": ["string", "null"]
    },
    "forceBinary": {
      "type": "boolean"
    },
    "progressRouting": {
      "type": "string",
      "enum": [
        "suppressed",
        "standardError",
        "inlineTty"
      ]
    },
    "streamBlockSize": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 16777216
    }
  },
  "required": [
    "mode",
    "forceBinary",
    "progressRouting",
    "streamBlockSize"
  ],
  "additionalProperties": false
}
