{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MediaAuditReport",
  "type": "object",
  "required": [
    "rawImageByteSize",
    "downsampledImageByteSize",
    "memoryReductionPercentage",
    "isAVPlayerCleanlyTornDown",
    "isTimeObserverRemoved",
    "isCoreAudioHALReleased",
    "virtualDragPromiseSupported",
    "spacebarQuickLookLatencyMs"
  ],
  "properties": {
    "rawImageByteSize": {
      "type": "integer",
      "minimum": 0,
      "description": "Original uncompressed bitmap size in bytes"
    },
    "downsampledImageByteSize": {
      "type": "integer",
      "minimum": 0,
      "description": "Downsampled thumbnail bitmap size in bytes"
    },
    "memoryReductionPercentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "RAM savings percentage from thumbnailing"
    },
    "isAVPlayerCleanlyTornDown": {
      "type": "boolean",
      "description": "Asserts player.replaceCurrentItem(with: nil) executed"
    },
    "isTimeObserverRemoved": {
      "type": "boolean",
      "description": "Asserts player.removeTimeObserver executed"
    },
    "isCoreAudioHALReleased": {
      "type": "boolean",
      "description": "Asserts CoreAudio hardware unit unmapped"
    },
    "virtualDragPromiseSupported": {
      "type": "boolean",
      "description": "Asserts NSFilePromiseProvider handles virtual subpaths"
    },
    "spacebarQuickLookLatencyMs": {
      "type": "number",
      "minimum": 0,
      "description": "Latency in milliseconds to open QLPreviewPanel"
    }
  },
  "additionalProperties": false
}
