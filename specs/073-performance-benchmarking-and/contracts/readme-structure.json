{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReadmeStructureContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentTitle",
    "badgeCount",
    "requiredSections",
    "requiredFormatCount",
    "requiredCliSubcommands"
  ],
  "properties": {
    "documentTitle": {
      "type": "string"
    },
    "badgeCount": {
      "type": "integer",
      "minimum": 5
    },
    "requiredSections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredFormatCount": {
      "type": "integer",
      "minimum": 16
    },
    "requiredCliSubcommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
