{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FinderActionEvent",
  "description": "Event dispatched when a user triggers a TTZip action from Finder context menus or QuickLook",
  "type": "object",
  "properties": {
    "actionIdentifier": {
      "type": "string",
      "enum": [
        "extract_here",
        "extract_to_subfolder",
        "inspect_archive",
        "autofill_password",
        "compute_hash",
        "compress_quick_7z",
        "compress_quick_zip",
        "compress_separate",
        "compress_and_delete_source",
        "compress_modal_advanced"
      ]
    },
    "title": {
      "type": "string"
    },
    "iconSystemName": {
      "type": "string"
    },
    "targetURLs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "isArchiveTarget": {
      "type": "boolean"
    }
  },
  "required": [
    "actionIdentifier",
    "title",
    "iconSystemName",
    "targetURLs",
    "isArchiveTarget"
  ],
  "additionalProperties": false
}
