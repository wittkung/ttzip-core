{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeflateStreamCoderProtocol",
  "description": "Strict JSON Schema for TTZip Tier 2 Deflate Streaming Engine Requests, Responses, and Stream Chunk Lifecycle Events",
  "type": "object",
  "required": ["sessionId", "messageType", "payload"],
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique session identifier for the streaming session"
    },
    "messageType": {
      "type": "string",
      "enum": ["streamInitRequest", "streamChunkRequest", "streamFinishRequest", "streamResponse", "streamProgressEvent"]
    },
    "payload": {
      "type": "object",
      "description": "Polymorphic payload discriminated by messageType"
    }
  },
  "oneOf": [
    {
      "properties": {
        "messageType": { "const": "streamInitRequest" },
        "payload": {
          "type": "object",
          "required": ["operation", "tierMode", "compressionLevel", "windowBits", "memLevel", "strategy"],
          "additionalProperties": false,
          "properties": {
            "operation": {
              "type": "string",
              "enum": ["compress", "decompress"]
            },
            "tierMode": {
              "type": "integer",
              "enum": [1, 2],
              "description": "1 = Tier 1 (libdeflate block), 2 = Tier 2 (zlib-ng stream)"
            },
            "compressionLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "windowBits": {
              "type": "integer",
              "enum": [-15, 15, 31],
              "description": "-15 = Raw Deflate, 15 = Zlib wrapped, 31 = Gzip wrapped"
            },
            "memLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "strategy": {
              "type": "integer",
              "enum": [0, 1, 2, 3, 4]
            }
          }
        }
      }
    },
    {
      "properties": {
        "messageType": { "const": "streamChunkRequest" },
        "payload": {
          "type": "object",
          "required": ["inputBytesBase64", "byteCount", "flushMode", "outputChunkSize"],
          "additionalProperties": false,
          "properties": {
            "inputBytesBase64": {
              "type": "string",
              "description": "Base64 encoded binary chunk payload"
            },
            "byteCount": {
              "type": "integer",
              "minimum": 0
            },
            "flushMode": {
              "type": "string",
              "enum": ["NO_FLUSH", "SYNC_FLUSH", "FULL_FLUSH", "FINISH"]
            },
            "outputChunkSize": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 16777216
            }
          }
        }
      }
    },
    {
      "properties": {
        "messageType": { "const": "streamFinishRequest" },
        "payload": {
          "type": "object",
          "required": ["outputChunkSize"],
          "additionalProperties": false,
          "properties": {
            "outputChunkSize": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 16777216
            }
          }
        }
      }
    },
    {
      "properties": {
        "messageType": { "const": "streamResponse" },
        "payload": {
          "type": "object",
          "required": ["success", "producedBytesBase64", "producedCount", "consumedCount", "isFinished", "metrics"],
          "additionalProperties": false,
          "properties": {
            "success": { "type": "boolean" },
            "producedBytesBase64": { "type": "string" },
            "producedCount": { "type": "integer", "minimum": 0 },
            "consumedCount": { "type": "integer", "minimum": 0 },
            "isFinished": { "type": "boolean" },
            "error": {
              "type": "object",
              "required": ["errorCode", "errorMessage"],
              "additionalProperties": false,
              "properties": {
                "errorCode": { "type": "string", "enum": ["INITIALIZATION_FAILED", "PROCESSING_FAILED", "STREAM_ALREADY_CLOSED", "INVALID_PARAMETERS", "CORRUPTED_DATA"] },
                "errorMessage": { "type": "string" },
                "zlibStatusCode": { "type": "integer" }
              }
            },
            "metrics": {
              "type": "object",
              "required": ["totalIn", "totalOut", "adler32", "crc32", "isFinished"],
              "additionalProperties": false,
              "properties": {
                "totalIn": { "type": "integer", "minimum": 0 },
                "totalOut": { "type": "integer", "minimum": 0 },
                "adler32": { "type": "integer", "minimum": 0 },
                "crc32": { "type": "integer", "minimum": 0 },
                "isFinished": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "messageType": { "const": "streamProgressEvent" },
        "payload": {
          "type": "object",
          "required": ["totalIn", "totalOut", "throughputMBs", "isFinished"],
          "additionalProperties": false,
          "properties": {
            "totalIn": { "type": "integer", "minimum": 0 },
            "totalOut": { "type": "integer", "minimum": 0 },
            "throughputMBs": { "type": "number", "minimum": 0.0 },
            "isFinished": { "type": "boolean" }
          }
        }
      }
    }
  ]
}
