{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHygieneConfigModel",
  "description": "JSON Schema contract for gitignore and gitattributes configuration assertions",
  "type": "object",
  "required": [
    "ignoredCategories",
    "lineEndingNormalization",
    "binaryProtectionPatterns",
    "linguistOverrides"
  ],
  "additionalProperties": false,
  "properties": {
    "ignoredCategories": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "enum": [
          "macos_metadata",
          "swiftpm_build",
          "c_intermediate",
          "vendor_upstream",
          "benchmark_scratch",
          "local_env"
        ]
      }
    },
    "lineEndingNormalization": {
      "type": "string",
      "enum": ["* text=auto eol=lf"]
    },
    "binaryProtectionPatterns": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    },
    "linguistOverrides": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["pattern", "attribute"],
        "additionalProperties": false,
        "properties": {
          "pattern": {
            "type": "string"
          },
          "attribute": {
            "type": "string",
            "enum": [
              "linguist-vendored",
              "linguist-generated",
              "linguist-documentation"
            ]
          }
        }
      }
    }
  }
}
