{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IssueFormDefinition",
  "description": "JSON Schema contract for GitHub YAML Issue Forms (.github/ISSUE_TEMPLATE/*.yml)",
  "type": "object",
  "required": ["name", "description", "title", "labels", "body"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "title": {
      "type": "string",
      "pattern": "^\\[[A-Za-z0-9 _-]+\\]: "
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "body": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "attributes"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["markdown", "textarea", "input", "dropdown", "checkboxes"]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "attributes": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": true,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "placeholder": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "anyOf": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "required": ["label", "required"],
                      "additionalProperties": false,
                      "properties": {
                        "label": { "type": "string" },
                        "required": { "type": "boolean" }
                      }
                    }
                  ]
                }
              },
              "render": {
                "type": "string",
                "enum": ["shell", "swift", "c", "json"]
              }
            }
          },
          "validations": {
            "type": "object",
            "required": ["required"],
            "additionalProperties": false,
            "properties": {
              "required": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
