{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PullRequestTemplateModel",
  "description": "JSON Schema contract for Pull Request Template structure and verification checklists",
  "type": "object",
  "required": [
    "summary",
    "relatedIssue",
    "changeType",
    "affectedSubsystems",
    "verificationGates"
  ],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "relatedIssue": {
      "type": "string",
      "pattern": "^(Closes|Fixes|Resolves) #[0-9]+$"
    },
    "changeType": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "bug_fix",
          "perf_optimization",
          "feature",
          "refactor",
          "security_upstream"
        ]
      }
    },
    "affectedSubsystems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "Sources/CTTZipBridge/",
          "Sources/TTZipCore/",
          "Sources/TTZipApp/",
          "Sources/TTZipCLI/",
          "Tests/TTZipTests/",
          "Vendor/"
        ]
      }
    },
    "verificationGates": {
      "type": "object",
      "required": [
        "performanceFloorPassed",
        "frontendGatePassed",
        "zeroAllocationHotPath",
        "swiftConcurrencyPassed",
        "addressSanitizerPassed",
        "threadSanitizerPassed",
        "pointerSafetyVerified",
        "dualChannelCompatibility"
      ],
      "additionalProperties": false,
      "properties": {
        "performanceFloorPassed": { "type": "boolean" },
        "frontendGatePassed": { "type": "boolean" },
        "zeroAllocationHotPath": { "type": "boolean" },
        "swiftConcurrencyPassed": { "type": "boolean" },
        "addressSanitizerPassed": { "type": "boolean" },
        "threadSanitizerPassed": { "type": "boolean" },
        "pointerSafetyVerified": { "type": "boolean" },
        "dualChannelCompatibility": { "type": "boolean" }
      }
    },
    "benchmarkTable": {
      "type": "object",
      "required": ["hardwareProfile", "compilerFlags", "rows"],
      "additionalProperties": false,
      "properties": {
        "hardwareProfile": { "type": "string" },
        "compilerFlags": { "type": "string" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scenario", "baselineMBs", "observedMBs", "deltaPercent", "status"],
            "additionalProperties": false,
            "properties": {
              "scenario": { "type": "string" },
              "baselineMBs": { "type": "number" },
              "observedMBs": { "type": "number" },
              "deltaPercent": { "type": "number" },
              "status": { "type": "string", "enum": ["GREEN", "WHITE", "RED"] }
            }
          }
        }
      }
    }
  }
}
