{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DMGExtractionServiceContract",
  "description": "Bi-directional triad IPC / CLI contract for Apple DMG penetration, inspection, and extraction service.",
  "type": "object",
  "required": [
    "type",
    "timestamp",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "extract_request",
        "extract_response",
        "progress_event",
        "inspect_request",
        "inspect_response"
      ]
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "object",
      "oneOf": [
        {
          "title": "DMGExtractRequest",
          "type": "object",
          "required": [
            "archivePath",
            "destinationDir",
            "skipMacJunk"
          ],
          "additionalProperties": false,
          "properties": {
            "archivePath": {
              "type": "string",
              "minLength": 1
            },
            "destinationDir": {
              "type": "string",
              "minLength": 1
            },
            "skipMacJunk": {
              "type": "boolean"
            },
            "targetPartitionId": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
          }
        },
        {
          "title": "DMGExtractResponse",
          "type": "object",
          "required": [
            "success",
            "extractedFilesCount",
            "totalBytesExtracted",
            "durationMs",
            "throughputMBs"
          ],
          "additionalProperties": false,
          "properties": {
            "success": {
              "type": "boolean"
            },
            "errorCode": {
              "type": "integer"
            },
            "errorMessage": {
              "type": "string"
            },
            "extractedFilesCount": {
              "type": "integer",
              "minimum": 0
            },
            "totalBytesExtracted": {
              "type": "integer",
              "minimum": 0
            },
            "durationMs": {
              "type": "number",
              "minimum": 0.0
            },
            "throughputMBs": {
              "type": "number",
              "minimum": 0.0
            }
          }
        },
        {
          "title": "DMGProgressEvent",
          "type": "object",
          "required": [
            "state",
            "bytesProcessed",
            "totalBytes",
            "currentChunkIndex",
            "totalChunks",
            "currentFileName",
            "throughputMBs"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "reading_header",
                "parsing_chunks",
                "decompressing_sectors",
                "extracting_files",
                "completed",
                "failed"
              ]
            },
            "bytesProcessed": {
              "type": "integer",
              "minimum": 0
            },
            "totalBytes": {
              "type": "integer",
              "minimum": 1
            },
            "currentChunkIndex": {
              "type": "integer",
              "minimum": 0
            },
            "totalChunks": {
              "type": "integer",
              "minimum": 1
            },
            "currentFileName": {
              "type": "string"
            },
            "throughputMBs": {
              "type": "number",
              "minimum": 0.0
            }
          }
        },
        {
          "title": "DMGInspectRequest",
          "type": "object",
          "required": [
            "archivePath"
          ],
          "additionalProperties": false,
          "properties": {
            "archivePath": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "title": "DMGInspectResponse",
          "type": "object",
          "required": [
            "success",
            "partitionsCount",
            "totalLogicalSectors",
            "detectedBlockTypes"
          ],
          "additionalProperties": false,
          "properties": {
            "success": {
              "type": "boolean"
            },
            "errorMessage": {
              "type": "string"
            },
            "partitionsCount": {
              "type": "integer",
              "minimum": 0
            },
            "totalLogicalSectors": {
              "type": "integer",
              "minimum": 0
            },
            "detectedBlockTypes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
