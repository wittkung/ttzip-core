{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ttzip.app/schemas/finder-sync-action.json",
  "title": "FinderSyncActionRequest",
  "description": "Schema for IPC action requests dispatched from FinderSync context menus or Services.",
  "type": "object",
  "required": [
    "actionIdentifier",
    "sourcePaths",
    "sanitizeMacMetadata"
  ],
  "additionalProperties": false,
  "properties": {
    "actionIdentifier": {
      "type": "string",
      "enum": [
        "extract_here",
        "extract_to_subfolder",
        "inspect_archive",
        "compress_quick_7z",
        "compress_quick_zip",
        "compress_separate",
        "compress_and_delete_source",
        "compress_modal_advanced",
        "autofill_password",
        "compute_hash"
      ],
      "description": "Identifier of the requested Finder action."
    },
    "sourcePaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Array of selected filesystem paths."
    },
    "destinationDirectory": {
      "type": "string",
      "minLength": 1,
      "description": "Optional destination folder path for extraction or output."
    },
    "sanitizeMacMetadata": {
      "type": "boolean",
      "description": "If true, automatically strip .DS_Store, __MACOSX, and macOS extended attributes."
    },
    "password": {
      "type": "string",
      "description": "Optional decryption password."
    }
  }
}
