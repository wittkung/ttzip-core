{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ttzip.app/schemas/global-operations-queue-event.json",
  "title": "GlobalOperationsQueueEvent",
  "description": "Schema for real-time task lifecycle and progress telemetry events emitted by the global operations scheduler.",
  "type": "object",
  "required": [
    "taskId",
    "taskName",
    "operationType",
    "state",
    "priority",
    "bytesProcessed",
    "totalBytes",
    "fractionCompleted",
    "throughputMBs"
  ],
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier of the task (UUID v4)."
    },
    "taskName": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable label or target filename."
    },
    "operationType": {
      "type": "string",
      "enum": ["compress", "extract", "test", "repair", "batch_compress", "batch_extract"],
      "description": "Operation classification."
    },
    "state": {
      "type": "string",
      "enum": ["queued", "running", "paused", "completed", "failed", "cancelled"],
      "description": "Current lifecycle status of the task."
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "userInitiated", "utility", "background"],
      "description": "Execution priority tier."
    },
    "bytesProcessed": {
      "type": "integer",
      "minimum": 0,
      "description": "Processed payload volume in bytes."
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Expected total volume in bytes."
    },
    "fractionCompleted": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Completion fraction."
    },
    "throughputMBs": {
      "type": "number",
      "minimum": 0.0,
      "description": "Instantaneous I/O and processing speed in MB/s."
    },
    "estimatedTimeRemainingSeconds": {
      "type": "number",
      "minimum": 0.0,
      "description": "ETA in seconds until task completion."
    },
    "errorMessage": {
      "type": "string",
      "description": "Error details if task failed."
    }
  }
}
