{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ttzip.app/schemas/quicklook-preview-payload.json",
  "title": "QuickLookPreviewPayload",
  "description": "Schema for archive metadata and file hierarchy delivered to Quick Look preview extensions.",
  "type": "object",
  "required": [
    "archivePath",
    "archiveName",
    "formatIdentifier",
    "uncompressedSizeBytes",
    "compressedSizeBytes",
    "compressionRatioPercent",
    "totalEntriesCount",
    "isEncrypted",
    "rootNodes"
  ],
  "additionalProperties": false,
  "properties": {
    "archivePath": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute filesystem path to the archive."
    },
    "archiveName": {
      "type": "string",
      "minLength": 1,
      "description": "Filename of the archive."
    },
    "formatIdentifier": {
      "type": "string",
      "enum": [
        "zip", "7z", "tar", "gz", "bz2", "xz", "zst", "lz4", "lz", "lrz",
        "aar", "sz", "wim", "dmg", "iso", "rar", "cab"
      ],
      "description": "Standardized format identifier string."
    },
    "uncompressedSizeBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Total uncompressed payload size in bytes."
    },
    "compressedSizeBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Physical size of the archive on disk in bytes."
    },
    "compressionRatioPercent": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0,
      "description": "Space savings percentage."
    },
    "totalEntriesCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of files and directories in archive."
    },
    "isEncrypted": {
      "type": "boolean",
      "description": "True if one or more entries require password decryption."
    },
    "rootNodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PreviewTreeNode"
      },
      "description": "Top-level directory and file nodes in the archive tree."
    }
  },
  "definitions": {
    "PreviewTreeNode": {
      "type": "object",
      "required": [
        "id",
        "name",
        "relativePath",
        "isDirectory",
        "uncompressedSizeBytes",
        "isEncrypted"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique node path or identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Basename of the node."
        },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "description": "Full relative path within archive."
        },
        "isDirectory": {
          "type": "boolean",
          "description": "True if node is a folder."
        },
        "uncompressedSizeBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "File uncompressed size in bytes."
        },
        "isEncrypted": {
          "type": "boolean",
          "description": "True if this specific entry is encrypted."
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PreviewTreeNode"
          },
          "description": "Children nodes if directory."
        }
      }
    }
  }
}
