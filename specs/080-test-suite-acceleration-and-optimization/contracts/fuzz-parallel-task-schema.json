{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FuzzParallelTask",
  "type": "object",
  "required": [
    "format",
    "iterationIndex",
    "deterministicSeed",
    "mutationOperator",
    "inMemorySourceBytes",
    "expectedDefenseResult",
    "actualStatus",
    "isMemorySafe"
  ],
  "properties": {
    "format": {
      "type": "string",
      "enum": ["zip", "sevenZip", "tar", "zstd", "gzip"]
    },
    "iterationIndex": {
      "type": "integer",
      "minimum": 0
    },
    "deterministicSeed": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{16}$"
    },
    "mutationOperator": {
      "type": "string",
      "enum": [
        "bitFlip",
        "byteShuffle",
        "truncateStream",
        "oversizeHeader",
        "corruptCRC",
        "invalidDictSize",
        "corruptMagic",
        "injectZipSlipPath"
      ]
    },
    "inMemorySourceBytes": {
      "type": "integer",
      "minimum": 1
    },
    "expectedDefenseResult": {
      "type": "string",
      "enum": ["errorRejected", "safeDecompressed"]
    },
    "actualStatus": {
      "type": "integer"
    },
    "isMemorySafe": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
