{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestSuiteExecutionConfig",
  "type": "object",
  "required": [
    "mode",
    "isDeepFuzzEnabled",
    "isBenchmarkModeEnabled",
    "maxConcurrentTasks",
    "defaultFuzzIterationsPerFormat",
    "matrixFuzzIterationsPerFormat"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["default", "deepFuzz", "fullBenchmark"]
    },
    "isDeepFuzzEnabled": {
      "type": "boolean"
    },
    "isBenchmarkModeEnabled": {
      "type": "boolean"
    },
    "maxConcurrentTasks": {
      "type": "integer",
      "minimum": 1
    },
    "defaultFuzzIterationsPerFormat": {
      "type": "integer",
      "minimum": 1
    },
    "matrixFuzzIterationsPerFormat": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
