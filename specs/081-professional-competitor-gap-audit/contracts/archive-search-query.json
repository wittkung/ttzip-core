{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArchiveSearchQuery",
  "description": "Schema for in-archive deep search queries and result metrics in TTZip",
  "type": "object",
  "required": [
    "queryText",
    "isRegex",
    "caseSensitive"
  ],
  "properties": {
    "queryText": {
      "type": "string",
      "description": "Search keyword or regular expression pattern"
    },
    "isRegex": {
      "type": "boolean",
      "description": "Whether query is a regex"
    },
    "caseSensitive": {
      "type": "boolean",
      "description": "Whether matching is case sensitive"
    },
    "minSizeBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional minimum uncompressed size filter"
    },
    "maxSizeBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional maximum uncompressed size filter"
    },
    "fileExtensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional file extension whitelist"
    }
  },
  "additionalProperties": false
}
