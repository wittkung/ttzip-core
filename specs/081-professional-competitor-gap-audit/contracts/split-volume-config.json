{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SplitVolumeConfig",
  "description": "Configuration schema for multi-volume archive split creation in TTZip",
  "type": "object",
  "required": [
    "volumeSizeBytes",
    "preset",
    "namingPattern",
    "cleanOnFailure"
  ],
  "properties": {
    "volumeSizeBytes": {
      "type": "integer",
      "minimum": 65536,
      "description": "Target slice size in bytes per volume"
    },
    "preset": {
      "type": "string",
      "enum": [
        "cd_700mb",
        "dvd_4700mb",
        "fat32_4gb",
        "email_25mb",
        "wechat_100mb",
        "custom"
      ],
      "description": "Predefined media size preset"
    },
    "namingPattern": {
      "type": "string",
      "enum": [
        "numbered_extension",
        "pkzip_spanned",
        "raw_split"
      ],
      "description": "Volume filename extension convention"
    },
    "cleanOnFailure": {
      "type": "boolean",
      "description": "Whether to clean up partially written volumes on failure"
    }
  },
  "additionalProperties": false
}
