{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BiometricAuthContract",
  "description": "JSON Schema for TTZip Touch ID / Apple Watch Biometric Authentication & Keychain Hardware Decryption",
  "type": "object",
  "required": [
    "action",
    "request",
    "response"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "authenticateUser",
        "evaluateBiometricAvailability"
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "authReason",
        "policy",
        "allowPasscodeFallback"
      ],
      "additionalProperties": false,
      "properties": {
        "authReason": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "enum": [
            "deviceOwnerAuthentication",
            "deviceOwnerAuthenticationWithBiometrics"
          ]
        },
        "allowPasscodeFallback": {
          "type": "boolean"
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "success",
        "authState",
        "hardwareBiometryType"
      ],
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "boolean"
        },
        "authState": {
          "type": "string",
          "enum": [
            "idle",
            "authenticating",
            "authenticated",
            "failed",
            "lockedOut",
            "canceled"
          ]
        },
        "hardwareBiometryType": {
          "type": "string",
          "enum": [
            "touchID",
            "appleWatch",
            "none"
          ]
        },
        "decryptedVaultKeyBase64": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
