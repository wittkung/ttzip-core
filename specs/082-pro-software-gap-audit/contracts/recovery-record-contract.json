{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RecoveryRecordContract",
  "description": "JSON Schema for TTZip Reed-Solomon (RS-FEC) Recovery Record Generation, Erasure Localization & Disaster Repair",
  "type": "object",
  "required": [
    "action",
    "request",
    "response"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "generateRecoveryRecord",
        "repairCorruptedArchive"
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "archiveURL",
        "recoveryPercent"
      ],
      "additionalProperties": false,
      "properties": {
        "archiveURL": {
          "type": "string",
          "minLength": 1
        },
        "recoveryPercent": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.10
        },
        "parityBlockSizeBytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 262144
        },
        "eccAlgorithm": {
          "type": "string",
          "enum": [
            "cauchyReedSolomonGF16",
            "vandermondeGF16"
          ]
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "success",
        "totalDataSlices",
        "totalParitySlices",
        "corruptedSlicesDetected",
        "slicesSuccessfullyRepaired"
      ],
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "boolean"
        },
        "totalDataSlices": {
          "type": "integer",
          "minimum": 1
        },
        "totalParitySlices": {
          "type": "integer",
          "minimum": 1
        },
        "corruptedSlicesDetected": {
          "type": "integer",
          "minimum": 0
        },
        "slicesSuccessfullyRepaired": {
          "type": "integer",
          "minimum": 0
        },
        "repairedArchiveHash": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
