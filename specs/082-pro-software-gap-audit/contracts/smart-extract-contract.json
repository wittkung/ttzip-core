{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SmartExtractContract",
  "description": "JSON Schema for TTZip Smart Extraction Strategy, Resolution & Post-Action Pipeline",
  "type": "object",
  "required": [
    "action",
    "request",
    "response"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "evaluateAndExtract",
        "resolveExtractionTarget"
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "sourceArchiveURL",
        "destinationDirectory",
        "collisionPolicy",
        "postAction"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceArchiveURL": {
          "type": "string",
          "format": "uri"
        },
        "destinationDirectory": {
          "type": "string",
          "minLength": 1
        },
        "collisionPolicy": {
          "type": "string",
          "enum": [
            "autoRenameNumbered",
            "overwriteExisting",
            "skipExisting",
            "abortWithError"
          ]
        },
        "postAction": {
          "type": "object",
          "required": [
            "moveToTrashAfterExtract",
            "revealInFinder",
            "playCompletionSound",
            "sendSystemNotification"
          ],
          "additionalProperties": false,
          "properties": {
            "moveToTrashAfterExtract": {
              "type": "boolean"
            },
            "revealInFinder": {
              "type": "boolean"
            },
            "playCompletionSound": {
              "type": "boolean"
            },
            "sendSystemNotification": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "success",
        "resolutionMode",
        "effectiveRootCount",
        "finalExtractionPath"
      ],
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "boolean"
        },
        "resolutionMode": {
          "type": "string",
          "enum": [
            "directExtract",
            "wrapInFolder",
            "emptyArchive"
          ]
        },
        "effectiveRootCount": {
          "type": "integer",
          "minimum": 0
        },
        "singleRootName": {
          "type": "string"
        },
        "finalExtractionPath": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
