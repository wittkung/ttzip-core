{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SplitVolumeContract",
  "description": "JSON Schema for TTZip Adaptive Multi-Volume Archive Creation & Stitching",
  "type": "object",
  "required": [
    "action",
    "request",
    "response"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "createSplitArchive",
        "mergeSplitArchive"
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "baseArchiveURL",
        "targetFormat",
        "volumeNamingConvention",
        "volumeSizeBytes",
        "cleanIncompleteVolumesOnFailure"
      ],
      "additionalProperties": false,
      "properties": {
        "baseArchiveURL": {
          "type": "string",
          "minLength": 1
        },
        "targetFormat": {
          "type": "string",
          "enum": [
            "sevenZip",
            "zip",
            "tar"
          ]
        },
        "volumeNamingConvention": {
          "type": "string",
          "enum": [
            "numericExtension",
            "pkwareSpanned"
          ]
        },
        "volumeSizeBytes": {
          "type": "integer",
          "minimum": 65536
        },
        "cleanIncompleteVolumesOnFailure": {
          "type": "boolean"
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "success",
        "totalVolumeCount",
        "generatedVolumeURLs",
        "totalBytesWritten"
      ],
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "boolean"
        },
        "totalVolumeCount": {
          "type": "integer",
          "minimum": 1
        },
        "generatedVolumeURLs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "totalBytesWritten": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
