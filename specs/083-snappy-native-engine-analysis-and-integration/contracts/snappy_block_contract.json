{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SnappyBlockContract",
  "description": "JSON Schema contract for Snappy raw block compression and decompression engine interface",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["compress_block"]
        },
        "request": {
          "type": "object",
          "properties": {
            "input_bytes": {
              "type": "string",
              "description": "Base64 encoded raw uncompressed payload"
            },
            "input_length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "max_output_capacity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": ["input_bytes", "input_length", "max_output_capacity"],
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["ok", "buffer_too_small", "invalid_parameter"]
            },
            "compressed_length": {
              "type": "integer",
              "minimum": 0
            },
            "compressed_bytes": {
              "type": "string",
              "description": "Base64 encoded Snappy compressed payload"
            },
            "ratio": {
              "type": "number",
              "minimum": 0.0
            }
          },
          "required": ["status", "compressed_length", "compressed_bytes", "ratio"],
          "additionalProperties": false
        }
      },
      "required": ["operation", "request", "response"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["decompress_block"]
        },
        "request": {
          "type": "object",
          "properties": {
            "compressed_bytes": {
              "type": "string",
              "description": "Base64 encoded Snappy compressed payload"
            },
            "compressed_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "max_allowed_uncompressed_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": ["compressed_bytes", "compressed_length"],
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "corrupt_varint",
                "corrupt_tag",
                "offset_out_of_bounds",
                "literal_overrun",
                "buffer_too_small"
              ]
            },
            "uncompressed_length": {
              "type": "integer",
              "minimum": 0
            },
            "uncompressed_bytes": {
              "type": "string",
              "description": "Base64 encoded restored uncompressed bytes"
            }
          },
          "required": ["status", "uncompressed_length", "uncompressed_bytes"],
          "additionalProperties": false
        }
      },
      "required": ["operation", "request", "response"],
      "additionalProperties": false
    }
  ]
}
