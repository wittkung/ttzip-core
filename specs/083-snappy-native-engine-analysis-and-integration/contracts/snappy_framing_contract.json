{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SnappyFramingContract",
  "description": "JSON Schema contract for Snappy Framed Stream format encoder, decoder, and chunk validation",
  "type": "object",
  "properties": {
    "stream_config": {
      "type": "object",
      "properties": {
        "max_chunk_size": {
          "type": "integer",
          "enum": [65536]
        },
        "enable_arm64_hardware_crc32c": {
          "type": "boolean"
        },
        "verify_crc_on_decompression": {
          "type": "boolean"
        },
        "allow_cascade_streams": {
          "type": "boolean"
        }
      },
      "required": [
        "max_chunk_size",
        "enable_arm64_hardware_crc32c",
        "verify_crc_on_decompression",
        "allow_cascade_streams"
      ],
      "additionalProperties": false
    },
    "chunk_header": {
      "type": "object",
      "properties": {
        "chunk_type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "chunk_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777215
        },
        "masked_crc32c": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": ["chunk_type", "chunk_length"],
      "additionalProperties": false
    },
    "stream_event": {
      "type": "object",
      "properties": {
        "event_type": {
          "type": "string",
          "enum": [
            "stream_identifier_matched",
            "chunk_compressed_emitted",
            "chunk_uncompressed_emitted",
            "chunk_skipped",
            "stream_completed",
            "stream_error"
          ]
        },
        "processed_input_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "emitted_output_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "error_code": {
          "type": "string",
          "enum": [
            "none",
            "invalid_magic",
            "corrupt_chunk_header",
            "crc32c_mismatch",
            "unsupported_chunk_type",
            "unexpected_eof"
          ]
        }
      },
      "required": [
        "event_type",
        "processed_input_bytes",
        "emitted_output_bytes",
        "error_code"
      ],
      "additionalProperties": false
    }
  },
  "required": ["stream_config", "chunk_header", "stream_event"],
  "additionalProperties": false
}
