{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SnappyTarPipelineContract",
  "description": "JSON Schema contract for in-process TAR.SZ archive creation and extraction pipeline without external subprocesses",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": ["create_archive", "extract_archive"]
    },
    "archive_path": {
      "type": "string",
      "minLength": 1
    },
    "target_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "skip_mac_junk": {
      "type": "boolean"
    },
    "in_process_mode": {
      "type": "boolean",
      "enum": [true]
    },
    "pipeline_result": {
      "type": "object",
      "properties": {
        "status_code": {
          "type": "integer"
        },
        "total_entries_processed": {
          "type": "integer",
          "minimum": 0
        },
        "total_raw_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_compressed_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "error_message": {
          "type": "string"
        }
      },
      "required": [
        "status_code",
        "total_entries_processed",
        "total_raw_bytes",
        "total_compressed_bytes",
        "error_message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "action",
    "archive_path",
    "target_paths",
    "skip_mac_junk",
    "in_process_mode",
    "pipeline_result"
  ],
  "additionalProperties": false
}
