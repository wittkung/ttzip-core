{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrefetchPipelineContract",
  "type": "object",
  "required": ["slot_count", "slot_capacity_bytes", "alignment_bytes", "current_state"],
  "properties": {
    "slot_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8
    },
    "slot_capacity_bytes": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 67108864
    },
    "alignment_bytes": {
      "type": "integer",
      "enum": [64, 128, 4096]
    },
    "current_state": {
      "type": "string",
      "enum": ["EMPTY", "LOADING", "READY", "CONSUMING"]
    }
  },
  "additionalProperties": false
}
