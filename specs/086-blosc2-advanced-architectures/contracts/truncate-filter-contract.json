{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TruncateFilterContract",
  "type": "object",
  "required": ["element_type", "keep_mantissa_bits", "enable_half_bit_rounding"],
  "properties": {
    "element_type": {
      "type": "string",
      "enum": ["float32", "float64"]
    },
    "keep_mantissa_bits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52
    },
    "enable_half_bit_rounding": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
