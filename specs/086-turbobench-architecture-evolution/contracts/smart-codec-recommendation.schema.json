{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SmartCodecScenarioRecommendation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario",
    "measuredEntropy",
    "trialCompressibilityRatio",
    "recommendedAlgorithm",
    "recommendedLevel",
    "rationale",
    "projectedThroughputMBs",
    "projectedSpaceSavingsPct",
    "probeDurationMs"
  ],
  "properties": {
    "scenario": {
      "type": "string",
      "enum": [
        "Instant Transfer (AirDrop/10G LAN)",
        "Balanced Daily Archive",
        "Cold Storage / Maximum Ratio"
      ]
    },
    "measuredEntropy": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 8.0
    },
    "trialCompressibilityRatio": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.5
    },
    "recommendedAlgorithm": {
      "type": "string",
      "minLength": 1
    },
    "recommendedLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 22
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "projectedThroughputMBs": {
      "type": "number",
      "minimum": 0.0
    },
    "projectedSpaceSavingsPct": {
      "type": "number"
    },
    "probeDurationMs": {
      "type": "number",
      "minimum": 0.0
    }
  }
}
