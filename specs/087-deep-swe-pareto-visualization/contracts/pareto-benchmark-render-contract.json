{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParetoBenchmarkRenderContract",
  "description": "Strongly-typed interface contract for DeepSWE-style academic Pareto chart rendering in TTZip.",
  "type": "object",
  "required": [
    "renderMode",
    "chartDimensions",
    "styleTheme",
    "trajectories",
    "allPoints"
  ],
  "properties": {
    "renderMode": {
      "type": "string",
      "enum": [
        "raster_png",
        "vector_svg",
        "dual_export"
      ]
    },
    "chartDimensions": {
      "type": "object",
      "required": [
        "width",
        "height",
        "scaleFactor",
        "marginLeft",
        "marginRight",
        "marginTop",
        "marginBottom"
      ],
      "properties": {
        "width": { "type": "number", "minimum": 800 },
        "height": { "type": "number", "minimum": 500 },
        "scaleFactor": { "type": "number", "minimum": 1.0, "maximum": 4.0 },
        "marginLeft": { "type": "number", "minimum": 50 },
        "marginRight": { "type": "number", "minimum": 50 },
        "marginTop": { "type": "number", "minimum": 50 },
        "marginBottom": { "type": "number", "minimum": 50 }
      },
      "additionalProperties": false
    },
    "styleTheme": {
      "type": "object",
      "required": [
        "themeName",
        "backgroundColorHex",
        "gridLineColorHex",
        "heroColorHex",
        "heroRibbonOpacity",
        "axisTextColorHex"
      ],
      "properties": {
        "themeName": { "type": "string", "enum": ["deepswe_minimalist_white", "dark_slate_hud"] },
        "backgroundColorHex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "gridLineColorHex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "heroColorHex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "heroRibbonOpacity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "axisTextColorHex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      },
      "additionalProperties": false
    },
    "trajectories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "familyId",
          "familyName",
          "brandColorHex",
          "isHero",
          "pointIds"
        ],
        "properties": {
          "familyId": { "type": "string", "enum": ["ttzip", "seven_zip", "apple_native", "keka", "the_unarchiver", "other"] },
          "familyName": { "type": "string" },
          "brandColorHex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "isHero": { "type": "boolean" },
          "pointIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "allPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "algorithm",
          "level",
          "throughputMBs",
          "spaceSavingsPct",
          "compressedBytes",
          "uncompressedBytes",
          "paretoRank",
          "isParetoOptimal",
          "isOnConvexEnvelope"
        ],
        "properties": {
          "id": { "type": "string" },
          "algorithm": { "type": "string" },
          "level": { "type": "integer", "minimum": 0 },
          "throughputMBs": { "type": "number", "minimum": 0.0 },
          "spaceSavingsPct": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
          "compressedBytes": { "type": "integer", "minimum": 0 },
          "uncompressedBytes": { "type": "integer", "minimum": 0 },
          "paretoRank": { "type": "integer", "minimum": 1 },
          "isParetoOptimal": { "type": "boolean" },
          "isOnConvexEnvelope": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
