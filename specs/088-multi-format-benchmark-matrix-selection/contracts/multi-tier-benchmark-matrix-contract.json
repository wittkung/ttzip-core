{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MultiTierBenchmarkMatrixContract",
  "description": "Strongly-typed interface contract for multi-tier benchmark format selection and composite scoring in TTZip.",
  "type": "object",
  "required": [
    "preset",
    "tiers",
    "softwareReports",
    "corpusInfo"
  ],
  "properties": {
    "preset": {
      "type": "string",
      "enum": [
        "4tier",
        "classic",
        "modern",
        "all16"
      ]
    },
    "corpusInfo": {
      "type": "object",
      "required": [
        "corpusName",
        "totalSizeBytes",
        "fileCount",
        "estimatedEntropy"
      ],
      "properties": {
        "corpusName": { "type": "string" },
        "totalSizeBytes": { "type": "integer", "minimum": 1 },
        "fileCount": { "type": "integer", "minimum": 1 },
        "estimatedEntropy": { "type": "number", "minimum": 0.0, "maximum": 8.0 }
      },
      "additionalProperties": false
    },
    "tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tierId",
          "tierName",
          "primaryFormat",
          "algorithm",
          "weight"
        ],
        "properties": {
          "tierId": { "type": "string", "enum": ["tier1_universal", "tier2_extreme", "tier3_modern", "tier4_inMemory"] },
          "tierName": { "type": "string" },
          "primaryFormat": { "type": "string" },
          "algorithm": { "type": "string" },
          "weight": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        },
        "additionalProperties": false
      }
    },
    "softwareReports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "softwareName",
          "compositeScore",
          "geometricMeanThroughputMBs",
          "averageSpaceSavingsPct",
          "paretoEfficiencyIndex"
        ],
        "properties": {
          "softwareName": { "type": "string" },
          "compositeScore": { "type": "number", "minimum": 0.0 },
          "geometricMeanThroughputMBs": { "type": "number", "minimum": 0.0 },
          "averageSpaceSavingsPct": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
          "paretoEfficiencyIndex": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
