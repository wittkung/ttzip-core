{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipKernelOptimizationContract",
  "description": "Formal contract defining input parameters, execution results, and differential audit reports for algebraic and SWAR optimized kernels in TTZip.",
  "type": "object",
  "required": [
    "action",
    "timestamp",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "VERIFY_CHECKSUM_KERNEL",
        "VERIFY_TAR_HEADER_KERNEL",
        "VERIFY_VARINT_KERNEL",
        "BENCHMARK_KERNEL_SUITE"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "oneOf": [
        {
          "title": "VerifyChecksumKernelPayload",
          "required": [
            "kernel_type",
            "test_buffer_size_bytes",
            "unaligned_offset_bytes",
            "iterations"
          ],
          "additionalProperties": false,
          "properties": {
            "kernel_type": {
              "type": "string",
              "enum": [
                "ADLER32_SCALAR",
                "ADLER32_NEON_DOTPROD",
                "CRC64_PMULL",
                "CRC64_SCALAR",
                "CRC32_ARM64"
              ]
            },
            "test_buffer_size_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 67108864
            },
            "unaligned_offset_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "iterations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        {
          "title": "VerifyTarHeaderKernelPayload",
          "required": [
            "header_format",
            "octal_size_representation",
            "use_signed_checksum_compat"
          ],
          "additionalProperties": false,
          "properties": {
            "header_format": {
              "type": "string",
              "enum": [
                "POSIX_USTAR",
                "GNU_TAR",
                "PAX_EXTENDED",
                "LEGACY_V7"
              ]
            },
            "octal_size_representation": {
              "type": "string",
              "enum": [
                "STANDARD_OCTAL_11",
                "GNU_BASE256_BINARY",
                "ZERO_EOA_BLOCK"
              ]
            },
            "use_signed_checksum_compat": {
              "type": "boolean"
            }
          }
        },
        {
          "title": "VerifyVarintKernelPayload",
          "required": [
            "raw_byte_length",
            "leading_ones_count",
            "expected_uint64_value"
          ],
          "additionalProperties": false,
          "properties": {
            "raw_byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "leading_ones_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "expected_uint64_value": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        },
        {
          "title": "BenchmarkKernelSuitePayload",
          "required": [
            "hardware_target",
            "cpu_instruction_sets",
            "target_kernels"
          ],
          "additionalProperties": false,
          "properties": {
            "hardware_target": {
              "type": "string",
              "enum": [
                "APPLE_SILICON_M_SERIES",
                "X86_64_AVX2"
              ]
            },
            "cpu_instruction_sets": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ARM64_NEON",
                  "ARM64_DOTPROD",
                  "ARM64_PMULL",
                  "ARM64_CRC32",
                  "X86_64_SSE42",
                  "X86_64_PCLMUL"
                ]
              },
              "minItems": 1
            },
            "target_kernels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
