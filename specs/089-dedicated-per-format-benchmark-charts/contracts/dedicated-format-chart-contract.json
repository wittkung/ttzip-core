{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DedicatedFormatChartContract",
  "description": "Strongly-typed contract for dedicated per-format Pareto chart generation and export.",
  "type": "object",
  "required": [
    "sessions",
    "corpusName",
    "totalSizeBytes"
  ],
  "properties": {
    "corpusName": { "type": "string" },
    "totalSizeBytes": { "type": "integer", "minimum": 1 },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sessionId",
          "title",
          "pngFileName",
          "svgFileName",
          "pointCount",
          "paretoWinnerId"
        ],
        "properties": {
          "sessionId": { "type": "string", "enum": ["zip", "7z", "tar_zst", "lz4", "full_composite"] },
          "title": { "type": "string" },
          "pngFileName": { "type": "string" },
          "svgFileName": { "type": "string" },
          "pointCount": { "type": "integer", "minimum": 1 },
          "paretoWinnerId": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
