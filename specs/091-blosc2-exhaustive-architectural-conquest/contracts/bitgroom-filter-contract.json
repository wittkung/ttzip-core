{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipBitGroomFilterContract",
  "description": "Interface contract for scientific floating-point Bit-Grooming and mantissa precision quantization",
  "type": "object",
  "properties": {
    "data_type": {
      "type": "string",
      "enum": ["float32", "float64"]
    },
    "nsd": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "retained_bits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52
    },
    "discarded_bits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 51
    },
    "mode": {
      "type": "string",
      "enum": ["truncate", "bitgroom", "bitround"]
    },
    "bounded_relative_error": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "required": [
    "data_type",
    "nsd",
    "retained_bits",
    "discarded_bits",
    "mode",
    "bounded_relative_error"
  ],
  "additionalProperties": false
}
