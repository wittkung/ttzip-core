{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipLazySliceContract",
  "description": "Interface contract for block-level lazy chunk decompression and sub-chunk slicing",
  "type": "object",
  "properties": {
    "start_byte": {
      "type": "integer",
      "minimum": 0
    },
    "length": {
      "type": "integer",
      "minimum": 1
    },
    "block_size": {
      "type": "integer",
      "enum": [32768, 65536, 131072, 262144]
    },
    "first_block_idx": {
      "type": "integer",
      "minimum": 0
    },
    "last_block_idx": {
      "type": "integer",
      "minimum": 0
    },
    "blocks_skipped_count": {
      "type": "integer",
      "minimum": 0
    },
    "special_value_bypass": {
      "type": "boolean"
    }
  },
  "required": [
    "start_byte",
    "length",
    "block_size",
    "first_block_idx",
    "last_block_idx",
    "blocks_skipped_count",
    "special_value_bypass"
  ],
  "additionalProperties": false
}
