{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZipExtremeModeContract",
  "description": "Schema for ZIP Extreme Speed Multi-Core Block-Parallel Mode options and result",
  "type": "object",
  "properties": {
    "blockSize": {
      "type": "integer",
      "minimum": 65536,
      "maximum": 16777216,
      "description": "Block chunk partition size in bytes"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "description": "Compression level (1..12)"
    },
    "uncompressedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "compressedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "crc32": {
      "type": "integer",
      "minimum": 0
    },
    "throughputMBs": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "blockSize",
    "level",
    "uncompressedBytes",
    "compressedBytes",
    "crc32",
    "throughputMBs"
  ]
}
