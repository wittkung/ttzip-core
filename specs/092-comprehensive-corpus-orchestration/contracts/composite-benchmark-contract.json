{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompositeBenchmarkContract",
  "description": "Schema for 5-Tier multi-corpus geometric mean composite benchmark report",
  "type": "object",
  "properties": {
    "reportId": { "type": "string" },
    "timestamp": { "type": "string" },
    "systemInfo": { "type": "string" },
    "referenceBaseline": { "type": "string" },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "algorithm": { "type": "string" },
          "level": { "type": "integer" },
          "geomCompSpeedMBs": { "type": "number", "minimum": 0 },
          "geomDecompSpeedMBs": { "type": "number", "minimum": 0 },
          "geomCompressionRatio": { "type": "number", "minimum": 1.0 },
          "geomSpaceSavingsPct": { "type": "number", "minimum": 0, "maximum": 100 },
          "compositeEfficiencyIndex": { "type": "number", "minimum": 0 },
          "normalizedSpecScore": { "type": "number", "minimum": 0 },
          "isParetoOptimal": { "type": "boolean" },
          "paretoRank": { "type": "integer", "minimum": 1 }
        },
        "required": [
          "algorithm",
          "level",
          "geomCompSpeedMBs",
          "geomDecompSpeedMBs",
          "geomCompressionRatio",
          "geomSpaceSavingsPct",
          "compositeEfficiencyIndex",
          "normalizedSpecScore",
          "isParetoOptimal",
          "paretoRank"
        ]
      }
    }
  },
  "required": [
    "reportId",
    "timestamp",
    "systemInfo",
    "referenceBaseline",
    "scores"
  ]
}
