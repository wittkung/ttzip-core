{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipHeuristicProbeContract",
  "description": "Interface contract for 16KB micro-sampling Shannon entropy and adaptive Store downgrade",
  "type": "object",
  "properties": {
    "file_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "sample_size_bytes": {
      "type": "integer",
      "enum": [16384, 32768, 65536]
    },
    "shannon_entropy": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 8.0
    },
    "is_incompressible": {
      "type": "boolean"
    },
    "is_uniform_special": {
      "type": "boolean"
    },
    "selected_codec_action": {
      "type": "string",
      "enum": ["DIRECT_STORE", "COMPRESS_DEFLATE", "COMPRESS_LZMA2", "COMPRESS_ZSTD", "SPECIAL_VALUE_BYPASS"]
    },
    "probe_duration_us": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10.0
    }
  },
  "required": [
    "file_size_bytes",
    "sample_size_bytes",
    "shannon_entropy",
    "is_incompressible",
    "is_uniform_special",
    "selected_codec_action",
    "probe_duration_us"
  ],
  "additionalProperties": false
}
