{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipScientificFloatContract",
  "description": "Interface contract for scientific float auto-detection and transparent Bit-Grooming filter injection",
  "type": "object",
  "properties": {
    "stride_autocorrelation_r4": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "normalized_float_ratio": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "exponent_std_dev": {
      "type": "number",
      "minimum": 0.0
    },
    "is_scientific_float32": {
      "type": "boolean"
    },
    "is_scientific_float64": {
      "type": "boolean"
    },
    "injected_filters": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["BITGROOM", "BITROUND", "BITSHUFFLE", "SHUFFLE", "BYTEDELTA"]
      }
    },
    "retained_significant_digits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "max_relative_error": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 0.05
    }
  },
  "required": [
    "stride_autocorrelation_r4",
    "normalized_float_ratio",
    "exponent_std_dev",
    "is_scientific_float32",
    "is_scientific_float64",
    "injected_filters",
    "retained_significant_digits",
    "max_relative_error"
  ],
  "additionalProperties": false
}
