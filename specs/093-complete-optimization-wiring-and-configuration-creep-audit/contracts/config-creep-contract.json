{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipConfigCreepContract",
  "description": "Interface contract asserting zero configuration creep and transparent physical default parameterization",
  "type": "object",
  "properties": {
    "option_model_name": {
      "type": "string"
    },
    "cpu_threads_auto_resolved": {
      "type": "boolean"
    },
    "hardware_cores_count": {
      "type": "integer",
      "minimum": 1
    },
    "ldm_window_log_auto_clamped": {
      "type": "boolean"
    },
    "inert_or_dead_knobs_count": {
      "type": "integer",
      "enum": [0]
    },
    "zero_configuration_creep_verified": {
      "type": "boolean"
    }
  },
  "required": [
    "option_model_name",
    "cpu_threads_auto_resolved",
    "hardware_cores_count",
    "ldm_window_log_auto_clamped",
    "inert_or_dead_knobs_count",
    "zero_configuration_creep_verified"
  ],
  "additionalProperties": false
}
