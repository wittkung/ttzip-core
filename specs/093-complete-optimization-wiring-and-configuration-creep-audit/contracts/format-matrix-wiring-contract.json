{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipFormatMatrixWiringContract",
  "description": "Interface contract verifying 100% in-process C/SIMD fast-path wiring across all 16 formats",
  "type": "object",
  "properties": {
    "total_supported_formats": {
      "type": "integer",
      "enum": [16]
    },
    "formats_with_native_c_engine": {
      "type": "integer",
      "enum": [16]
    },
    "formats_using_cli_subprocess": {
      "type": "integer",
      "enum": [0]
    },
    "zero_copy_mmap_enabled": {
      "type": "boolean"
    },
    "all_16_formats_passed_diff_oracle": {
      "type": "boolean"
    }
  },
  "required": [
    "total_supported_formats",
    "formats_with_native_c_engine",
    "formats_using_cli_subprocess",
    "zero_copy_mmap_enabled",
    "all_16_formats_passed_diff_oracle"
  ],
  "additionalProperties": false
}
