{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EntropyAdaptiveRoutingContract",
  "description": "Schema for entropy-based compression routing result",
  "type": "object",
  "properties": {
    "entropyBitsPerByte": { "type": "number", "minimum": 0, "maximum": 8.0 },
    "estimatedRatio": { "type": "number", "minimum": 0 },
    "recommendedMethod": { "type": "integer", "enum": [0, 8] },
    "isStoreDirect": { "type": "boolean" }
  },
  "required": [
    "entropyBitsPerByte",
    "estimatedRatio",
    "recommendedMethod",
    "isStoreDirect"
  ]
}
