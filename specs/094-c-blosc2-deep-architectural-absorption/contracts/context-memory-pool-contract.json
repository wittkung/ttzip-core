{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContextMemoryPoolContract",
  "type": "object",
  "required": [
    "workerCount",
    "scratchpadCapacityBytes",
    "alignmentBytes",
    "totalAllocatedBytes",
    "iterationCount",
    "dynamicHeapAllocations",
    "zeroAllocationCompliant"
  ],
  "properties": {
    "workerCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "scratchpadCapacityBytes": {
      "type": "integer",
      "minimum": 4096
    },
    "alignmentBytes": {
      "type": "integer",
      "enum": [16, 64, 4096, 16384]
    },
    "totalAllocatedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "iterationCount": {
      "type": "integer",
      "minimum": 1
    },
    "dynamicHeapAllocations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 0
    },
    "zeroAllocationCompliant": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
