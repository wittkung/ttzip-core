{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NDimTensorSlicingContract",
  "type": "object",
  "required": [
    "rank",
    "globalDimensions",
    "chunkShape",
    "blockShape",
    "dataType",
    "sliceStart",
    "sliceEnd",
    "intersectingBlockCount",
    "totalBlockCount",
    "sliceDurationMs",
    "zeroCopyDirectView"
  ],
  "properties": {
    "rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "globalDimensions": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "chunkShape": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "blockShape": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "dataType": {
      "type": "string",
      "enum": ["<f4", "<f8", "<i4", "<i8", "<u1", "<u2", "<u4", "<u8"]
    },
    "sliceStart": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "sliceEnd": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "intersectingBlockCount": {
      "type": "integer",
      "minimum": 1
    },
    "totalBlockCount": {
      "type": "integer",
      "minimum": 1
    },
    "sliceDurationMs": {
      "type": "number",
      "minimum": 0.0
    },
    "zeroCopyDirectView": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
