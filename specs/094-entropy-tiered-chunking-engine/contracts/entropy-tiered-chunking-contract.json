{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EntropyTieredChunkingContract",
  "description": "Schema for entropy-based tiered chunking decision",
  "type": "object",
  "properties": {
    "entropy": { "type": "number", "minimum": 0.0, "maximum": 8.0 },
    "fileSizeBytes": { "type": "integer", "minimum": 0 },
    "recommendedBlockSizeBytes": { "type": "integer", "enum": [0, 131072, 524288, 2097152] },
    "compressionMethod": { "type": "integer", "enum": [0, 8] },
    "targetCacheTier": { "type": "string", "enum": ["L1_DATA", "L2_CLUSTER", "L2_LARGE", "DIRECT_STORE"] }
  },
  "required": [
    "entropy",
    "fileSizeBytes",
    "recommendedBlockSizeBytes",
    "compressionMethod",
    "targetCacheTier"
  ]
}
