{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StandardsHardeningSchema",
  "type": "object",
  "required": [
    "featureId",
    "spdxCompliance",
    "compilerFlags",
    "defensiveModel"
  ],
  "properties": {
    "featureId": {
      "type": "string",
      "enum": ["096-full-codebase-standards-and-defensive-hardening"]
    },
    "spdxCompliance": {
      "type": "object",
      "required": ["percentageTarget", "requiredIdentifier"],
      "properties": {
        "percentageTarget": { "type": "number", "minimum": 100.0, "maximum": 100.0 },
        "requiredIdentifier": { "type": "string", "enum": ["LicenseRef-TTZip-Source-Available-1.0"] }
      },
      "additionalProperties": false
    },
    "compilerFlags": {
      "type": "object",
      "required": ["strictFlagsEnabled", "zeroWarningsTarget"],
      "properties": {
        "strictFlagsEnabled": { "type": "boolean" },
        "zeroWarningsTarget": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "defensiveModel": {
      "type": "object",
      "required": ["poisonSentinel", "overflowProtection", "secureZeroMemory"],
      "properties": {
        "poisonSentinel": { "type": "string", "enum": ["0xDEADBEEFU"] },
        "overflowProtection": { "type": "boolean" },
        "secureZeroMemory": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
