{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SevenZipArchiveInspectionResult",
  "description": "Schema defining 7z archive zero-copy inspection structural metadata",
  "type": "object",
  "properties": {
    "archivePath": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path of inspected archive"
    },
    "fileSizeBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Total archive file size on disk in bytes"
    },
    "totalEntriesCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Total count of files and directories in the archive"
    },
    "totalUncompressedBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Sum of uncompressed file payload sizes"
    },
    "encryptionTier": {
      "type": "string",
      "enum": ["none", "dataOnly", "headerAndData"],
      "description": "Archive encryption classification"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "description": "Relative filesystem path inside the archive container"
          },
          "isDirectory": {
            "type": "boolean",
            "description": "Whether this entry represents a directory"
          },
          "uncompressedSizeBytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Uncompressed size in bytes"
          },
          "compressedSizeBytes": {
            "type": "integer",
            "minimum": 0,
            "description": "Packed size in bytes within the stream"
          },
          "crc32": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "32-bit CRC checksum of uncompressed stream"
          },
          "isEncrypted": {
            "type": "boolean",
            "description": "Whether this entry payload is AES-256 encrypted"
          }
        },
        "required": [
          "relativePath",
          "isDirectory",
          "uncompressedSizeBytes",
          "compressedSizeBytes",
          "crc32",
          "isEncrypted"
        ],
        "additionalProperties": false
      },
      "description": "List of individual entry descriptors"
    },
    "inspectionDurationMs": {
      "type": "number",
      "minimum": 0.0,
      "description": "Time elapsed during zero-copy inspection in milliseconds"
    }
  },
  "required": [
    "archivePath",
    "fileSizeBytes",
    "totalEntriesCount",
    "totalUncompressedBytes",
    "encryptionTier",
    "entries",
    "inspectionDurationMs"
  ],
  "additionalProperties": false
}
