{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AddressBarInterfaceContract",
  "description": "Strongly-typed contract definition for TTZip Unified Address and Search Bar operations, events, and navigation dispatching.",
  "definitions": {
    "AddressBarInputMode": {
      "type": "string",
      "enum": ["pathNavigation", "spotlightSearch"],
      "description": "Active input mode."
    },
    "PathResolutionType": {
      "type": "string",
      "enum": ["directory", "archive", "file", "notFound", "permissionRequired"],
      "description": "Destination classification."
    },
    "BreadcrumbSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "fullURL", "isRoot", "isLast"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Canonical path up to this breadcrumb segment."
        },
        "title": {
          "type": "string",
          "description": "Folder display name."
        },
        "fullURL": {
          "type": "string",
          "description": "Full file URL string."
        },
        "isRoot": {
          "type": "boolean",
          "description": "Whether this segment is root."
        },
        "isLast": {
          "type": "boolean",
          "description": "Whether this segment is the current folder."
        }
      }
    },
    "PathSuggestionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "displayName", "parentPath", "isDirectory", "isArchive", "systemIconName", "matchHighlightRange"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (canonical absolute path)."
        },
        "path": {
          "type": "string",
          "description": "Full normalized path."
        },
        "displayName": {
          "type": "string",
          "description": "Name displayed in UI."
        },
        "parentPath": {
          "type": "string",
          "description": "Parent directory path."
        },
        "isDirectory": {
          "type": "boolean",
          "description": "Whether candidate is a directory."
        },
        "isArchive": {
          "type": "boolean",
          "description": "Whether candidate is a recognized archive."
        },
        "systemIconName": {
          "type": "string",
          "description": "SF Symbol icon name."
        },
        "matchHighlightRange": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2,
          "description": "[startIndex, length] for text highlight."
        }
      }
    },
    "NavigatePathRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "rawPath", "baseDirectory"],
      "properties": {
        "action": { "type": "string", "const": "navigatePath" },
        "rawPath": { "type": "string", "minLength": 1 },
        "baseDirectory": { "type": "string", "minLength": 1 }
      }
    },
    "NavigatePathSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "sanitizedPath", "destinationType", "exists", "isDirectory", "isArchive"],
      "properties": {
        "success": { "type": "boolean", "const": true },
        "sanitizedPath": { "type": "string" },
        "destinationType": { "$ref": "#/definitions/PathResolutionType" },
        "exists": { "type": "boolean" },
        "isDirectory": { "type": "boolean" },
        "isArchive": { "type": "boolean" }
      }
    },
    "NavigatePathErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "error", "code", "rawPath"],
      "properties": {
        "success": { "type": "boolean", "const": false },
        "error": { "type": "string" },
        "code": { "type": "string", "enum": ["NOT_FOUND", "PERMISSION_DENIED", "INVALID_PATH"] },
        "rawPath": { "type": "string" }
      }
    },
    "AddressBarStateChangeEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventType", "isEditing", "text", "mode", "breadcrumbs"],
      "properties": {
        "eventType": { "type": "string", "const": "addressBarStateChanged" },
        "isEditing": { "type": "boolean" },
        "text": { "type": "string" },
        "mode": { "$ref": "#/definitions/AddressBarInputMode" },
        "breadcrumbs": {
          "type": "array",
          "items": { "$ref": "#/definitions/BreadcrumbSegment" }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/NavigatePathRequest" },
    { "$ref": "#/definitions/NavigatePathSuccessResponse" },
    { "$ref": "#/definitions/NavigatePathErrorResponse" },
    { "$ref": "#/definitions/AddressBarStateChangeEvent" }
  ]
}
