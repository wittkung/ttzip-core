{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PathAutocompletionSchemaContract",
  "description": "Strongly-typed contract definition for asynchronous path autocompletion queries and responses in TTZip.",
  "definitions": {
    "AutocompleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "prefix", "baseDirectory", "maxResults"],
      "properties": {
        "action": { "type": "string", "const": "queryAutocomplete" },
        "prefix": { "type": "string" },
        "baseDirectory": { "type": "string", "minLength": 1 },
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "AutocompleteSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "queryPrefix", "parentDirectory", "suggestions", "cachedHit", "latencyMs"],
      "properties": {
        "success": { "type": "boolean", "const": true },
        "queryPrefix": { "type": "string" },
        "parentDirectory": { "type": "string" },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "displayName", "parentPath", "isDirectory", "isArchive", "systemIconName", "matchHighlightRange"],
            "properties": {
              "id": { "type": "string" },
              "path": { "type": "string" },
              "displayName": { "type": "string" },
              "parentPath": { "type": "string" },
              "isDirectory": { "type": "boolean" },
              "isArchive": { "type": "boolean" },
              "systemIconName": { "type": "string" },
              "matchHighlightRange": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "cachedHit": { "type": "boolean" },
        "latencyMs": { "type": "number", "minimum": 0 }
      }
    },
    "AutocompleteErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "error", "code", "queryPrefix"],
      "properties": {
        "success": { "type": "boolean", "const": false },
        "error": { "type": "string" },
        "code": { "type": "string", "enum": ["PARENT_NOT_FOUND", "PERMISSION_DENIED", "QUERY_CANCELLED"] },
        "queryPrefix": { "type": "string" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/AutocompleteRequest" },
    { "$ref": "#/definitions/AutocompleteSuccessResponse" },
    { "$ref": "#/definitions/AutocompleteErrorResponse" }
  ]
}
