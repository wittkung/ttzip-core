{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CBridgeIntegrityContract",
  "type": "object",
  "required": ["bridgeModule", "codecType", "requestedLevel", "effectiveLevel", "isDirectNative", "hasMagicDegradation"],
  "properties": {
    "bridgeModule": {
      "type": "string",
      "enum": ["CTTZipStreamCoder", "CTTZipBridge_ZipWrite", "CTTZipBridge_GzParallel", "CTTZipExtract", "CTTZipBridge_Snappy"]
    },
    "codecType": {
      "type": "string",
      "enum": ["libdeflate", "liblzma", "zstd", "lz4", "bzip2", "snappy"]
    },
    "requestedLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 22
    },
    "effectiveLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 22
    },
    "isDirectNative": {
      "type": "boolean"
    },
    "hasMagicDegradation": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
