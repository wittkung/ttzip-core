{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZopfliEngineContract",
  "type": "object",
  "required": ["iterations", "blockSplitting", "maxSplits", "hasHistoryWarmup", "isZeroCLI"],
  "properties": {
    "iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "blockSplitting": {
      "type": "boolean"
    },
    "maxSplits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30
    },
    "hasHistoryWarmup": {
      "type": "boolean"
    },
    "isZeroCLI": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
