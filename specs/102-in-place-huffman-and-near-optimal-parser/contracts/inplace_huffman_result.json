{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InPlaceHuffmanResult",
  "type": "object",
  "required": [
    "num_symbols",
    "max_codeword_len",
    "used_symbol_count",
    "codeword_lengths",
    "reversed_codewords",
    "execution_micros"
  ],
  "properties": {
    "num_symbols": {
      "type": "integer",
      "minimum": 2,
      "maximum": 1024,
      "description": "Total alphabet size"
    },
    "max_codeword_len": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15,
      "description": "Maximum allowed codeword bit length"
    },
    "used_symbol_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024,
      "description": "Number of non-zero frequency symbols"
    },
    "codeword_lengths": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 15
      },
      "description": "Array of bit lengths for each symbol in alphabet"
    },
    "reversed_codewords": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Array of bit-reversed canonical codewords"
    },
    "execution_micros": {
      "type": "number",
      "minimum": 0.0,
      "description": "Tree generation execution duration in microseconds"
    }
  },
  "additionalProperties": false
}
