{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NearOptimalCompressionResult",
  "type": "object",
  "required": [
    "uncompressed_bytes",
    "compressed_bytes",
    "compression_level",
    "compression_ratio",
    "throughput_mbs",
    "passes_executed",
    "is_rfc1951_compliant"
  ],
  "properties": {
    "uncompressed_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Total original payload bytes"
    },
    "compressed_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Total compressed output bytes"
    },
    "compression_level": {
      "type": "integer",
      "minimum": 10,
      "maximum": 12,
      "description": "Near-optimal compression level (10-12)"
    },
    "compression_ratio": {
      "type": "number",
      "minimum": 0.0,
      "description": "Uncompressed / Compressed ratio"
    },
    "throughput_mbs": {
      "type": "number",
      "minimum": 0.0,
      "description": "Measured compression throughput in MB/s"
    },
    "passes_executed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "Number of dynamic programming optimization passes"
    },
    "is_rfc1951_compliant": {
      "type": "boolean",
      "description": "Assertion that output is 100% RFC 1951 compliant"
    }
  },
  "additionalProperties": false
}
