{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZipCompressionProfile",
  "description": "Schema for strong-typed transparent ZIP compression profile configuration",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "deflateLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "zopfliIterations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "blockSplitting": {
      "type": "boolean"
    },
    "maxBlockSplits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "earlyExitThreshold": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "targetThroughputFloorMBs": {
      "type": "number",
      "exclusiveMinimum": 0.0
    }
  },
  "required": [
    "id",
    "name",
    "level",
    "deflateLevel",
    "zopfliIterations",
    "blockSplitting",
    "maxBlockSplits",
    "earlyExitThreshold",
    "targetThroughputFloorMBs"
  ],
  "additionalProperties": false
}
