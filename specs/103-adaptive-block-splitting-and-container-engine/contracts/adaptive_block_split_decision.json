{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdaptiveBlockSplitDecision",
  "type": "object",
  "required": [
    "block_length",
    "should_split",
    "selected_block_type",
    "estimated_bit_cost",
    "observations_count"
  ],
  "properties": {
    "block_length": {
      "type": "integer",
      "minimum": 0,
      "description": "Current block length in uncompressed bytes"
    },
    "should_split": {
      "type": "boolean",
      "description": "Whether entropy shift triggers a block boundary"
    },
    "selected_block_type": {
      "type": "string",
      "enum": ["stored", "static_huffman", "dynamic_huffman"],
      "description": "Arbitrated optimal block type based on bit cost"
    },
    "estimated_bit_cost": {
      "type": "integer",
      "minimum": 0,
      "description": "Calculated total bit cost for the block"
    },
    "observations_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Total token observations collected"
    }
  },
  "additionalProperties": false
}
