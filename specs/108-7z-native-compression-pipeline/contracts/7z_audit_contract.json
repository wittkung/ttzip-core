{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SevenZipAuditContract",
  "description": "Strongly typed schema for 7z architecture asset inventory and external dependency audit records.",
  "definitions": {
    "AuditAssetRecord": {
      "type": "object",
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "sourceFilePath": {
          "type": "string",
          "minLength": 1
        },
        "lineRange": {
          "type": "string",
          "pattern": "^L[0-9]+-L[0-9]+$"
        },
        "currentDependency": {
          "type": "string",
          "enum": [
            "100% In-House Native C",
            "Vendor liblzma.a",
            "Sources/CTTZipBridge/fast-lzma2",
            "Vendor libarchive.a",
            "System CommonCrypto / NEON"
          ]
        },
        "targetDependency": {
          "type": "string",
          "enum": ["100% In-House Native C"]
        },
        "zipReusableFeature": {
          "type": "string",
          "minLength": 1
        },
        "targetThroughputMBps": {
          "type": "number",
          "minimum": 0.0
        }
      },
      "required": [
        "componentId",
        "sourceFilePath",
        "lineRange",
        "currentDependency",
        "targetDependency",
        "zipReusableFeature",
        "targetThroughputMBps"
      ],
      "additionalProperties": false
    },
    "AuditReport": {
      "type": "object",
      "properties": {
        "reportDate": {
          "type": "string"
        },
        "totalComponentsAudited": {
          "type": "integer",
          "minimum": 1
        },
        "inHouseComponentsCount": {
          "type": "integer",
          "minimum": 0
        },
        "externalDependencyComponentsCount": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AuditAssetRecord"
          },
          "minItems": 1
        }
      },
      "required": [
        "reportDate",
        "totalComponentsAudited",
        "inHouseComponentsCount",
        "externalDependencyComponentsCount",
        "records"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/AuditAssetRecord" },
    { "$ref": "#/definitions/AuditReport" }
  ]
}
