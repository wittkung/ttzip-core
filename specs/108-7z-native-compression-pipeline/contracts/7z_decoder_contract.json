{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SevenZipDecoderPipelineContract",
  "description": "Strongly typed contract for 7z native decoding pipeline request, response, and progress event models.",
  "definitions": {
    "DecoderRequest": {
      "type": "object",
      "properties": {
        "archivePath": {
          "type": "string",
          "minLength": 1
        },
        "destinationDir": {
          "type": "string",
          "minLength": 1
        },
        "skipMacJunk": {
          "type": "boolean"
        },
        "password": {
          "type": "string"
        },
        "verifyChecksum": {
          "type": "boolean"
        }
      },
      "required": [
        "archivePath",
        "destinationDir",
        "skipMacJunk",
        "verifyChecksum"
      ],
      "additionalProperties": false
    },
    "DecoderResponse": {
      "type": "object",
      "properties": {
        "statusCode": {
          "type": "integer"
        },
        "operationType": {
          "type": "string",
          "enum": ["decode"]
        },
        "totalInputBytes": {
          "type": "integer",
          "minimum": 0
        },
        "totalOutputBytes": {
          "type": "integer",
          "minimum": 0
        },
        "compressionRatio": {
          "type": "number",
          "minimum": 0.0
        },
        "durationMs": {
          "type": "number",
          "minimum": 0.0
        },
        "throughputMBps": {
          "type": "number",
          "minimum": 0.0
        },
        "filesProcessed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "statusCode",
        "operationType",
        "totalInputBytes",
        "totalOutputBytes",
        "compressionRatio",
        "durationMs",
        "throughputMBps",
        "filesProcessed"
      ],
      "additionalProperties": false
    },
    "DecoderProgressEvent": {
      "type": "object",
      "properties": {
        "eventType": {
          "type": "string",
          "enum": ["progress", "completed", "error"]
        },
        "bytesProcessed": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "percentage": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0
        },
        "currentFileName": {
          "type": "string"
        }
      },
      "required": [
        "eventType",
        "bytesProcessed",
        "totalBytes",
        "percentage",
        "currentFileName"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/DecoderRequest" },
    { "$ref": "#/definitions/DecoderResponse" },
    { "$ref": "#/definitions/DecoderProgressEvent" }
  ]
}
