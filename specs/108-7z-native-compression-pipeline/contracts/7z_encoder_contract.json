{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SevenZipEncoderPipelineContract",
  "description": "Strongly typed contract for 7z native compression pipeline request, response, and progress event models.",
  "definitions": {
    "EncoderRequest": {
      "type": "object",
      "properties": {
        "outputPath": {
          "type": "string",
          "minLength": 1
        },
        "inputPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "compressionLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "dictSize": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 67108864
        },
        "solidBlockSizeMb": {
          "type": "integer",
          "minimum": 16,
          "maximum": 1024
        },
        "enableNeonAcceleration": {
          "type": "boolean"
        },
        "password": {
          "type": "string"
        }
      },
      "required": [
        "outputPath",
        "inputPaths",
        "compressionLevel",
        "dictSize",
        "solidBlockSizeMb",
        "enableNeonAcceleration"
      ],
      "additionalProperties": false
    },
    "EncoderResponse": {
      "type": "object",
      "properties": {
        "statusCode": {
          "type": "integer"
        },
        "operationType": {
          "type": "string",
          "enum": ["encode"]
        },
        "totalInputBytes": {
          "type": "integer",
          "minimum": 0
        },
        "totalOutputBytes": {
          "type": "integer",
          "minimum": 0
        },
        "compressionRatio": {
          "type": "number",
          "minimum": 0.0
        },
        "durationMs": {
          "type": "number",
          "minimum": 0.0
        },
        "throughputMBps": {
          "type": "number",
          "minimum": 0.0
        },
        "filesProcessed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "statusCode",
        "operationType",
        "totalInputBytes",
        "totalOutputBytes",
        "compressionRatio",
        "durationMs",
        "throughputMBps",
        "filesProcessed"
      ],
      "additionalProperties": false
    },
    "EncoderProgressEvent": {
      "type": "object",
      "properties": {
        "eventType": {
          "type": "string",
          "enum": ["progress", "completed", "error"]
        },
        "bytesProcessed": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "percentage": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0
        },
        "currentFileName": {
          "type": "string"
        }
      },
      "required": [
        "eventType",
        "bytesProcessed",
        "totalBytes",
        "percentage",
        "currentFileName"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/EncoderRequest" },
    { "$ref": "#/definitions/EncoderResponse" },
    { "$ref": "#/definitions/EncoderProgressEvent" }
  ]
}
