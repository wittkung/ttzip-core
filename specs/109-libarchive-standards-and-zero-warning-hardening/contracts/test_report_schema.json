{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestExecutionReport",
  "description": "Structured in-process test execution metrics report from TTZipTestObserver",
  "type": "object",
  "required": [
    "totalSuites",
    "suitesPassed",
    "suitesFailed",
    "totalTests",
    "testsPassed",
    "testsSkipped",
    "testsFailed",
    "totalDurationSeconds",
    "failures"
  ],
  "additionalProperties": false,
  "properties": {
    "totalSuites": {
      "type": "integer",
      "minimum": 0
    },
    "suitesPassed": {
      "type": "integer",
      "minimum": 0
    },
    "suitesFailed": {
      "type": "integer",
      "minimum": 0
    },
    "totalTests": {
      "type": "integer",
      "minimum": 0
    },
    "testsPassed": {
      "type": "integer",
      "minimum": 0
    },
    "testsSkipped": {
      "type": "integer",
      "minimum": 0
    },
    "testsFailed": {
      "type": "integer",
      "minimum": 0
    },
    "totalDurationSeconds": {
      "type": "number",
      "minimum": 0.0
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "message", "testMethod"],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string"
          },
          "testMethod": {
            "type": "string"
          }
        }
      }
    }
  }
}
