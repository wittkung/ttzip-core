{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AArch64Compare256NeonContract",
  "description": "Hardware and interface contract for AArch64 2x-unrolled NEON compare256 match finder",
  "type": "object",
  "required": [
    "function_signature",
    "loop_stride_bytes",
    "reduction_mechanism",
    "fallback_pinpoint",
    "maximum_match_length",
    "performance_invariants"
  ],
  "properties": {
    "function_signature": {
      "type": "string",
      "enum": ["uint32_t compare256_neon_static(const uint8_t *src0, const uint8_t *src1)"]
    },
    "loop_stride_bytes": {
      "type": "integer",
      "enum": [32],
      "description": "Processes two 16-byte vector chunks (32 bytes total) per loop iteration"
    },
    "reduction_mechanism": {
      "type": "object",
      "required": ["vector_diff_op", "vector_merge_op", "horizontal_reduction_op"],
      "properties": {
        "vector_diff_op": {
          "type": "string",
          "enum": ["veorq_u8"]
        },
        "vector_merge_op": {
          "type": "string",
          "enum": ["vorrq_u8"]
        },
        "horizontal_reduction_op": {
          "type": "string",
          "enum": ["vmaxvq_u8"]
        }
      }
    },
    "fallback_pinpoint": {
      "type": "object",
      "required": ["lane_extraction_op", "count_trailing_zeros_op"],
      "properties": {
        "lane_extraction_op": {
          "type": "string",
          "enum": ["vgetq_lane_u64"]
        },
        "count_trailing_zeros_op": {
          "type": "string",
          "enum": ["zng_first_diff_byte64"]
        }
      }
    },
    "maximum_match_length": {
      "type": "integer",
      "enum": [256]
    },
    "performance_invariants": {
      "type": "object",
      "required": [
        "zero_regression_on_literals",
        "zero_stack_spilling",
        "maximum_text_growth_bytes"
      ],
      "properties": {
        "zero_regression_on_literals": {
          "type": "boolean",
          "enum": [true]
        },
        "zero_stack_spilling": {
          "type": "boolean",
          "enum": [true]
        },
        "maximum_text_growth_bytes": {
          "type": "integer",
          "maximum": 100
        }
      }
    }
  }
}
