{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestRunSummary",
  "description": "Executive summary report schema for TTZip full test run",
  "type": "object",
  "required": [
    "sessionID",
    "totalSuites",
    "totalCases",
    "passedCases",
    "failedCases",
    "skippedCases",
    "passRatePercent",
    "wallClockDurationMs",
    "architecture",
    "osVersion",
    "timestamp"
  ],
  "properties": {
    "sessionID": {
      "type": "string"
    },
    "totalSuites": {
      "type": "integer",
      "minimum": 0
    },
    "totalCases": {
      "type": "integer",
      "minimum": 0
    },
    "passedCases": {
      "type": "integer",
      "minimum": 0
    },
    "failedCases": {
      "type": "integer",
      "minimum": 0
    },
    "skippedCases": {
      "type": "integer",
      "minimum": 0
    },
    "passRatePercent": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "wallClockDurationMs": {
      "type": "number",
      "minimum": 0.0
    },
    "architecture": {
      "type": "string"
    },
    "osVersion": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
