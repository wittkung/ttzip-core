{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlignedDeflateEngineContract",
  "description": "Strict contract defining libdeflate-aligned compression pipeline and Apple Silicon acceleration profiles.",
  "definitions": {
    "CanonicalDeflateSequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "litrunlen_and_length",
        "offset",
        "offset_slot"
      ],
      "properties": {
        "litrunlen_and_length": {
          "type": "integer",
          "minimum": 0,
          "description": "Bitpacked: low 23 bits = literal run length, high 9 bits = match length"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768,
          "description": "Backward match distance in sliding dictionary window"
        },
        "offset_slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 29,
          "description": "Precalculated RFC 1951 distance slot index"
        }
      }
    },
    "CompactMatchfinderState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash3_tab_entries",
        "hash4_tab_entries",
        "next_tab_entries",
        "total_state_bytes",
        "window_order"
      ],
      "properties": {
        "hash3_tab_entries": {
          "type": "integer",
          "enum": [32768],
          "description": "Number of entries in 3-byte direct hash table"
        },
        "hash4_tab_entries": {
          "type": "integer",
          "enum": [65536],
          "description": "Number of entries in 4-byte hash bucket table"
        },
        "next_tab_entries": {
          "type": "integer",
          "enum": [32768],
          "description": "Number of entries in hash chain collision link table"
        },
        "total_state_bytes": {
          "type": "integer",
          "enum": [262144],
          "description": "Total state memory allocation in bytes (256 KB)"
        },
        "window_order": {
          "type": "integer",
          "enum": [15],
          "description": "Log2 of sliding window size"
        }
      }
    },
    "EngineOptimizationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "max_search_depth",
        "nice_match_len",
        "use_neon_lz_extend",
        "use_fused_bitstream",
        "use_unrolled_load",
        "target_throughput_mbs",
        "target_space_savings_pct"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "Compression level index"
        },
        "max_search_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64,
          "description": "Hash chain search depth limit"
        },
        "nice_match_len": {
          "type": "integer",
          "minimum": 4,
          "maximum": 258,
          "description": "Early match termination threshold"
        },
        "use_neon_lz_extend": {
          "type": "boolean",
          "description": "True when ARM64 128-bit NEON string extension is enabled"
        },
        "use_fused_bitstream": {
          "type": "boolean",
          "description": "True when 64-bit fused sequence bitstream packing is active"
        },
        "use_unrolled_load": {
          "type": "boolean",
          "description": "True when multi-candidate load unrolling is active"
        },
        "target_throughput_mbs": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "description": "Expected minimum throughput floor in MB/s"
        },
        "target_space_savings_pct": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0,
          "description": "Expected space savings percentage on 100MB corpora"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "matchfinder",
    "profile"
  ],
  "properties": {
    "sequence": {
      "$ref": "#/definitions/CanonicalDeflateSequence"
    },
    "matchfinder": {
      "$ref": "#/definitions/CompactMatchfinderState"
    },
    "profile": {
      "$ref": "#/definitions/EngineOptimizationProfile"
    }
  }
}
