{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BenchmarkDataPoint",
  "type": "object",
  "required": ["input_length", "baseline_ns", "candidate_ns", "speedup_pct", "status"],
  "additionalProperties": false,
  "properties": {
    "input_length": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "baseline_ns": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "candidate_ns": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "speedup_pct": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": ["SPEEDUP", "PARITY", "REGRESSION"]
    }
  }
}
