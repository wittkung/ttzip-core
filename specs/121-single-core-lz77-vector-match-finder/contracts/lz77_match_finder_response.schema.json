{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LZ77MatchFinderResponse",
  "description": "Response model for LZ77 match finder output statistics",
  "type": "object",
  "properties": {
    "tokens_emitted": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of literal and match tokens produced"
    },
    "literal_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of single-byte literal tokens"
    },
    "match_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of length/distance match tokens"
    },
    "elapsed_nanoseconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Measured execution duration in nanoseconds"
    }
  },
  "required": [
    "tokens_emitted",
    "literal_count",
    "match_count",
    "elapsed_nanoseconds"
  ],
  "additionalProperties": false
}
