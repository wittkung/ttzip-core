{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HuffmanCostEvaluationRequest",
  "description": "Request model for Huffman bit cost evaluation",
  "type": "object",
  "properties": {
    "litlen_symbol_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of literal/length symbols"
    },
    "offset_symbol_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of distance/offset symbols"
    },
    "chunk_size_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Size of current chunk in bytes"
    }
  },
  "required": [
    "litlen_symbol_count",
    "offset_symbol_count",
    "chunk_size_bytes"
  ],
  "additionalProperties": false
}
