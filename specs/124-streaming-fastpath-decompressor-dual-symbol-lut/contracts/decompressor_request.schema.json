{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DecompressorRequest",
  "description": "Request model for Deflate bitstream decompression",
  "type": "object",
  "properties": {
    "input_size_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Byte size of compressed input stream"
    },
    "output_capacity_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Byte capacity of destination buffer"
    }
  },
  "required": [
    "input_size_bytes",
    "output_capacity_bytes"
  ],
  "additionalProperties": false
}
