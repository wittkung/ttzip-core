{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deflate12TierCalibrationContract",
  "description": "Strict schema for native Deflate 12-tier monotonic parameters on Apple Silicon",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tiers"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "tiers": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "matchFinderType",
          "maxChainDepth",
          "niceMatchLength",
          "lookaheadSteps",
          "zopfliIterations",
          "enableBlockSplitting",
          "targetThroughputMinMBs"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "matchFinderType": {
            "type": "string",
            "enum": [
              "fast_hybrid_hash34",
              "fast_greedy_hash4",
              "compact_4way_lazy",
              "compact_chain_lazy",
              "deep_chain_lazy",
              "zopfli_dag"
            ]
          },
          "maxChainDepth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256
          },
          "niceMatchLength": {
            "type": "integer",
            "minimum": 32,
            "maximum": 258
          },
          "lookaheadSteps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "zopfliIterations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          },
          "enableBlockSplitting": {
            "type": "boolean"
          },
          "targetThroughputMinMBs": {
            "type": "number",
            "minimum": 0.1
          }
        }
      }
    }
  }
}