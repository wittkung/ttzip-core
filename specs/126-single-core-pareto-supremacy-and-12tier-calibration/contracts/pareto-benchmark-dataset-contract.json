{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParetoBenchmarkDatasetContract",
  "description": "Strict schema for multi-corpus Pareto frontier benchmark PK datasets and metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpusId",
    "datasetSha256",
    "originalSizeBytes",
    "ttzipPoints",
    "competitorPoints",
    "isStrictlyMonotonic",
    "paretoDominationScore",
    "chartExportPath"
  ],
  "properties": {
    "corpusId": {
      "type": "string",
      "enum": [
        "enwik8_100mb",
        "mixed_compound100mb",
        "structured_json100mb"
      ]
    },
    "datasetSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "originalSizeBytes": {
      "type": "integer",
      "minimum": 1048576
    },
    "ttzipPoints": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "toolId",
          "algorithm",
          "level",
          "throughputMBs",
          "compressedBytes",
          "spaceSavingsPct"
        ],
        "properties": {
          "toolId": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "throughputMBs": {
            "type": "number",
            "minimum": 0.01
          },
          "compressedBytes": {
            "type": "integer",
            "minimum": 1024
          },
          "spaceSavingsPct": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          }
        }
      }
    },
    "competitorPoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "toolId",
          "algorithm",
          "family",
          "level",
          "throughputMBs",
          "compressedBytes",
          "spaceSavingsPct"
        ],
        "properties": {
          "toolId": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "enum": [
              "libdeflate",
              "sevenZip",
              "appleNative",
              "minizipNg",
              "pigz",
              "other"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          },
          "throughputMBs": {
            "type": "number",
            "minimum": 0.01
          },
          "compressedBytes": {
            "type": "integer",
            "minimum": 1024
          },
          "spaceSavingsPct": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          }
        }
      }
    },
    "isStrictlyMonotonic": {
      "type": "boolean"
    },
    "paretoDominationScore": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "chartExportPath": {
      "type": "string",
      "minLength": 1
    }
  }
}