{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParetoFrontierBenchmarkReport",
  "type": "object",
  "required": [
    "corpusName",
    "corpusSizeBytes",
    "points",
    "isConvexHullEnclosed"
  ],
  "properties": {
    "corpusName": {
      "type": "string"
    },
    "corpusSizeBytes": {
      "type": "integer",
      "minimum": 1
    },
    "isConvexHullEnclosed": {
      "type": "boolean"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "software",
          "tierName",
          "compressedSizeBytes",
          "throughputMBps"
        ],
        "properties": {
          "software": {
            "type": "string"
          },
          "tierName": {
            "type": "string"
          },
          "compressedSizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "throughputMBps": {
            "type": "number",
            "minimum": 0.0
          },
          "isConvexHull": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
