{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PointwiseParetoDominanceReport",
  "description": "Validation schema for pointwise Pareto dominance verification between TTZip and competitor benchmarks",
  "type": "object",
  "required": [
    "featureId",
    "datasetName",
    "datasetSizeBytes",
    "totalCompetitorPoints",
    "strictlyDominatedPoints",
    "dominancePercentage",
    "evaluations"
  ],
  "properties": {
    "featureId": {
      "type": "string",
      "enum": ["128-strict-pointwise-pareto-dominance"]
    },
    "datasetName": {
      "type": "string",
      "enum": [
        "Structured Logs & JSON: 100MB",
        "Binary & Machine Code: 100MB",
        "Mixed Modality: 100MB Real-World Workspace",
        "Text & Web: enwik8 100MB"
      ]
    },
    "datasetSizeBytes": {
      "type": "integer",
      "minimum": 1
    },
    "totalCompetitorPoints": {
      "type": "integer",
      "minimum": 1
    },
    "strictlyDominatedPoints": {
      "type": "integer",
      "minimum": 0
    },
    "dominancePercentage": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "competitorName",
          "competitorLevel",
          "competitorThroughputMBs",
          "competitorCompressedSizeBytes",
          "dominatingTTZipTier",
          "ttzipThroughputMBs",
          "ttzipCompressedSizeBytes",
          "speedAdvantageRatio",
          "sizeAdvantageRatio",
          "isStrictlyDominated"
        ],
        "properties": {
          "competitorName": {
            "type": "string"
          },
          "competitorLevel": {
            "type": "integer"
          },
          "competitorThroughputMBs": {
            "type": "number",
            "minimum": 0.0
          },
          "competitorCompressedSizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "dominatingTTZipTier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12
          },
          "ttzipThroughputMBs": {
            "type": "number",
            "minimum": 0.0
          },
          "ttzipCompressedSizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "speedAdvantageRatio": {
            "type": "number",
            "minimum": 0.0
          },
          "sizeAdvantageRatio": {
            "type": "number",
            "minimum": 0.0
          },
          "isStrictlyDominated": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
