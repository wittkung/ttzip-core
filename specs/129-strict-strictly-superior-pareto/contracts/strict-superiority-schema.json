{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StrictDualAxisSuperiorityReport",
  "description": "Validation schema for strict simultaneous speed and size superiority verification",
  "type": "object",
  "required": [
    "featureId",
    "datasetName",
    "datasetSizeBytes",
    "totalCompetitorPoints",
    "strictlySuperiorPoints",
    "superiorityPercentage",
    "evaluations"
  ],
  "properties": {
    "featureId": {
      "type": "string",
      "enum": ["129-strict-strictly-superior-pareto"]
    },
    "datasetName": {
      "type": "string",
      "enum": [
        "Structured Logs & JSON: 100MB",
        "Binary & Machine Code: 100MB",
        "Mixed Modality: 100MB Real-World Workspace",
        "Text & Web: enwik8 100MB"
      ]
    },
    "datasetSizeBytes": {
      "type": "integer",
      "minimum": 1
    },
    "totalCompetitorPoints": {
      "type": "integer",
      "minimum": 1
    },
    "strictlySuperiorPoints": {
      "type": "integer",
      "minimum": 0
    },
    "superiorityPercentage": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "competitorLevel",
          "competitorThroughputMBs",
          "competitorCompressedSizeBytes",
          "superiorTTZipTier",
          "ttzipThroughputMBs",
          "ttzipCompressedSizeBytes",
          "speedAdvantageRatio",
          "sizeAdvantageRatio",
          "isStrictlySuperior"
        ],
        "properties": {
          "competitorLevel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "competitorThroughputMBs": {
            "type": "number",
            "minimum": 0.0
          },
          "competitorCompressedSizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "superiorTTZipTier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "ttzipThroughputMBs": {
            "type": "number",
            "minimum": 0.0
          },
          "ttzipCompressedSizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "speedAdvantageRatio": {
            "type": "number",
            "minimum": 1.0001
          },
          "sizeAdvantageRatio": {
            "type": "number",
            "minimum": 1.0001
          },
          "isStrictlySuperior": {
            "type": "boolean",
            "enum": [true]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
