{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BenchmarkSuiteReport",
  "type": "object",
  "required": [
    "timestamp",
    "platform",
    "os_version",
    "compiler",
    "macro_points",
    "micro_points",
    "total_points",
    "improved_points",
    "regressed_points",
    "verdict"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "os_version": {
      "type": "string",
      "minLength": 1
    },
    "compiler": {
      "type": "string",
      "minLength": 1
    },
    "macro_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "corpus",
          "level",
          "buffer_size",
          "baseline_time_ms",
          "candidate_time_ms",
          "delta_percent",
          "status"
        ],
        "properties": {
          "corpus": {
            "type": "string",
            "enum": [
              "text",
              "striped_rgb",
              "random",
              "dna",
              "literals",
              "short_match",
              "mixed",
              "realistic_rgb"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "buffer_size": {
            "type": "integer",
            "minimum": 1
          },
          "baseline_time_ms": {
            "type": "number",
            "minimum": 0.0
          },
          "candidate_time_ms": {
            "type": "number",
            "minimum": 0.0
          },
          "delta_percent": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "GAIN",
              "FLAT",
              "WARNING",
              "CRITICAL_REGRESSION"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "micro_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "match_length",
          "description",
          "baseline_latency_ns",
          "candidate_latency_ns",
          "delta_percent",
          "execution_stage"
        ],
        "properties": {
          "match_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256
          },
          "description": {
            "type": "string"
          },
          "baseline_latency_ns": {
            "type": "number",
            "minimum": 0.0
          },
          "candidate_latency_ns": {
            "type": "number",
            "minimum": 0.0
          },
          "delta_percent": {
            "type": "number"
          },
          "execution_stage": {
            "type": "string",
            "enum": [
              "SCALAR_SUBREGISTER",
              "DISCRETE_STEPPING",
              "UNROLLED_HIGHWAY",
              "TAIL_BOUNDARY"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "total_points": {
      "type": "integer",
      "minimum": 1
    },
    "improved_points": {
      "type": "integer",
      "minimum": 0
    },
    "regressed_points": {
      "type": "integer",
      "minimum": 0
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS_ALL_GREEN",
        "PASS_WITH_WARNINGS",
        "BLOCKED_REGRESSION"
      ]
    }
  },
  "additionalProperties": false
}
