{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeflateBenchMatrixReport",
  "description": "Strict schema for in-memory Deflate-Bench 50-point matrix evaluation output",
  "type": "object",
  "required": [
    "suite_timestamp",
    "total_points_evaluated",
    "total_duration_ms",
    "median_cv_percentage",
    "all_integrity_passed",
    "matrix_results"
  ],
  "properties": {
    "suite_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "total_points_evaluated": {
      "type": "integer",
      "minimum": 1
    },
    "total_duration_ms": {
      "type": "number",
      "minimum": 0.0
    },
    "median_cv_percentage": {
      "type": "number",
      "minimum": 0.0
    },
    "all_integrity_passed": {
      "type": "boolean"
    },
    "matrix_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "engine_name",
          "corpus_type",
          "payload_size_bytes",
          "compression_level",
          "compressed_size_bytes",
          "compression_ratio",
          "compress_duration_ns",
          "compress_throughput_mb_s",
          "decompress_duration_ns",
          "decompress_throughput_mb_s",
          "cv_percentage",
          "integrity_verified"
        ],
        "properties": {
          "engine_name": {
            "type": "string",
            "enum": [
              "libdeflate",
              "zlib-ng",
              "zstd",
              "lz4",
              "snappy"
            ]
          },
          "corpus_type": {
            "type": "string",
            "enum": [
              "text",
              "short_match",
              "dna",
              "random",
              "literals",
              "mixed",
              "realistic_rgb",
              "striped_rgb"
            ]
          },
          "payload_size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "compression_level": {
            "type": "integer"
          },
          "compressed_size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "compression_ratio": {
            "type": "number",
            "minimum": 0.1
          },
          "compress_duration_ns": {
            "type": "number",
            "minimum": 0.0
          },
          "compress_throughput_mb_s": {
            "type": "number",
            "minimum": 0.0
          },
          "decompress_duration_ns": {
            "type": "number",
            "minimum": 0.0
          },
          "decompress_throughput_mb_s": {
            "type": "number",
            "minimum": 0.0
          },
          "cv_percentage": {
            "type": "number",
            "minimum": 0.0
          },
          "integrity_verified": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}