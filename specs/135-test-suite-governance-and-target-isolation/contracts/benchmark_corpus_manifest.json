{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BenchmarkCorpusDescriptor",
  "type": "object",
  "required": [
    "corpusId",
    "displayName",
    "sizeBytes",
    "entropyEstimate",
    "sha256Fingerprint"
  ],
  "properties": {
    "corpusId": {
      "type": "string",
      "enum": [
        "text",
        "short_match",
        "dna",
        "random",
        "literals",
        "mixed",
        "realistic_rgb",
        "striped_rgb"
      ]
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1
    },
    "entropyEstimate": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 8.0
    },
    "sha256Fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}