{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SystemBinaryDescriptor",
  "type": "object",
  "required": [
    "binaryName",
    "resolvedPath",
    "resolutionSource",
    "isAvailable",
    "versionString"
  ],
  "properties": {
    "binaryName": {
      "type": "string",
      "minLength": 1
    },
    "resolvedPath": {
      "type": "string",
      "minLength": 1
    },
    "resolutionSource": {
      "type": "string",
      "enum": [
        "environment",
        "bundle",
        "path",
        "standard_directory",
        "unavailable"
      ]
    },
    "isAvailable": {
      "type": "boolean"
    },
    "versionString": {
      "type": "string"
    }
  },
  "additionalProperties": false
}