{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BenchmarkCliGateVerdict",
  "type": "object",
  "required": [
    "gatePassed",
    "exitCode",
    "evaluatedPoints",
    "regressionPointsCount",
    "diagnosticMessage"
  ],
  "properties": {
    "gatePassed": {
      "type": "boolean"
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0
    },
    "evaluatedPoints": {
      "type": "integer",
      "minimum": 1
    },
    "regressionPointsCount": {
      "type": "integer",
      "minimum": 0
    },
    "diagnosticMessage": {
      "type": "string"
    }
  },
  "additionalProperties": false
}