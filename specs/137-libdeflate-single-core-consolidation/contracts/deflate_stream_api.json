{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeflateStreamAPIContract",
  "description": "Strongly typed JSON schema contract for stateful streaming Deflate operations via zlib-ng pipeline",
  "definitions": {
    "StreamingDeflateChunkEvent": {
      "type": "object",
      "properties": {
        "chunkIndex": {
          "type": "integer",
          "minimum": 0
        },
        "inputBytesProcessed": {
          "type": "integer",
          "minimum": 0
        },
        "outputBytesEmitted": {
          "type": "integer",
          "minimum": 0
        },
        "isStreamEnd": {
          "type": "boolean"
        }
      },
      "required": ["chunkIndex", "inputBytesProcessed", "outputBytesEmitted", "isStreamEnd"],
      "additionalProperties": false
    }
  }
}
