{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompressionAlgorithmSpecificationContract",
  "description": "Strongly-typed schema for compression algorithms, dictionary configurations, match finders, and entropy models.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithmId",
    "displayName",
    "governingSpecification",
    "algorithmFamily",
    "matchFinderStrategy",
    "entropyCoderStrategy",
    "minWindowSizeBytes",
    "maxWindowSizeBytes",
    "minMatchLengthBytes",
    "maxMatchLengthBytes",
    "compressionSpeedRating",
    "decompressionSpeedRating",
    "memoryComplexityClass",
    "hardwareVectorPaths"
  ],
  "properties": {
    "algorithmId": {
      "type": "string",
      "enum": [
        "deflate",
        "lzma",
        "lzma2",
        "zstd",
        "bzip2",
        "lz4",
        "lz4hc",
        "brotli",
        "lzfse",
        "snappy",
        "lrzip",
        "lzx",
        "xpress",
        "ppmd",
        "store"
      ]
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "governingSpecification": {
      "type": "string",
      "minLength": 1
    },
    "algorithmFamily": {
      "type": "string",
      "enum": [
        "dictionaryLz77",
        "markovRangeCoding",
        "finiteStateEntropy",
        "blockSortingBwt",
        "statisticalContextModeling",
        "rawByteAligned",
        "uncompressedPassthrough"
      ]
    },
    "matchFinderStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "hashBytes",
        "parsingHeuristic"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "hashChain",
            "directBuckets",
            "binaryTree",
            "patriciaTrie",
            "rollingHashRzip",
            "swarWordMatching",
            "neonVectorMatch",
            "suffixSortBwt",
            "none"
          ]
        },
        "hashBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "parsingHeuristic": {
          "type": "string",
          "enum": [
            "greedy",
            "lazyEvaluation",
            "twoStepLazy",
            "optimalForwardDp",
            "zopfliIterativeEntropy",
            "contextStatistical",
            "none"
          ]
        }
      }
    },
    "entropyCoderStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fractionalBitsSupport",
        "interleavedStreamCount",
        "staticDictionaryAvailable"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "canonicalHuffman",
            "finiteStateEntropyANS",
            "binaryArithmeticRangeCoder",
            "subbotinRangeCoder",
            "noneRawBytes"
          ]
        },
        "fractionalBitsSupport": {
          "type": "boolean"
        },
        "interleavedStreamCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "staticDictionaryAvailable": {
          "type": "boolean"
        }
      }
    },
    "minWindowSizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "maxWindowSizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "minMatchLengthBytes": {
      "type": "integer",
      "minimum": 0
    },
    "maxMatchLengthBytes": {
      "type": "integer",
      "minimum": 0
    },
    "compressionSpeedRating": {
      "type": "string",
      "enum": [
        "ultraFast",
        "fast",
        "medium",
        "slow",
        "ultraSlow"
      ]
    },
    "decompressionSpeedRating": {
      "type": "string",
      "enum": [
        "extremeWireSpeed",
        "veryHigh",
        "high",
        "medium",
        "moderate"
      ]
    },
    "memoryComplexityClass": {
      "type": "string",
      "enum": [
        "constantLowBounded",
        "windowBounded",
        "heapScaleBounded",
        "ramScaleIntensive"
      ]
    },
    "hardwareVectorPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "arm64PmullCrc64",
          "armv8AcleCrc32",
          "armNeonAdler32DotProd",
          "armv8Aes256Interleaved",
          "armNeonSwarMatch",
          "armNeonByteShuffle",
          "armNeonBitGroom"
        ]
      }
    }
  }
}
