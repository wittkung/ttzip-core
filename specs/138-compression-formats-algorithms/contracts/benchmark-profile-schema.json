{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BenchmarkWorkloadProfileContract",
  "description": "Strongly-typed schema for multi-workload benchmark metrics and Pareto trade-off performance data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workloadId",
    "formatId",
    "compressionLevel",
    "encryptionEnabled",
    "packagingThroughputMBps",
    "extractionThroughputMBps",
    "compressionRatioPercent",
    "peakMemoryOccupancyMB"
  ],
  "properties": {
    "workloadId": {
      "type": "string",
      "enum": [
        "massiveSmallFiles",
        "structuredLogText",
        "highEntropyBinary",
        "largeDataBlock500MB"
      ]
    },
    "formatId": {
      "type": "string",
      "enum": [
        "sevenZip",
        "zip",
        "tar",
        "zst",
        "gz",
        "bz2",
        "xz",
        "lzip",
        "lz4",
        "brotli",
        "lrzip",
        "aar",
        "snappy",
        "wim",
        "dmg",
        "iso",
        "rar",
        "cab",
        "cpio",
        "xar"
      ]
    },
    "compressionLevel": {
      "type": "integer",
      "minimum": -5,
      "maximum": 22
    },
    "encryptionEnabled": {
      "type": "boolean"
    },
    "packagingThroughputMBps": {
      "type": "number",
      "minimum": 0.0
    },
    "extractionThroughputMBps": {
      "type": "number",
      "minimum": 0.0
    },
    "compressionRatioPercent": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 150.0
    },
    "peakMemoryOccupancyMB": {
      "type": "number",
      "minimum": 0.0
    }
  }
}
