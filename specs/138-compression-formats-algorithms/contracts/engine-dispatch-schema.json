{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HardwareKernelDispatchContract",
  "description": "Strongly-typed schema for Apple Silicon micro-kernel hardware acceleration and C bridge bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kernelId",
    "instructionSetFeatures",
    "vectorRegisterWidthBits",
    "unrollFactor",
    "peakThroughputMBps",
    "cBridgeSourceFile"
  ],
  "properties": {
    "kernelId": {
      "type": "string",
      "enum": [
        "arm64PmullCrc64",
        "armv8AcleCrc32",
        "armNeonAdler32DotProd",
        "armv8Aes256Interleaved",
        "armNeonSwarMatch",
        "armNeonByteShuffle",
        "armNeonBitGroom"
      ]
    },
    "instructionSetFeatures": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "FEAT_PMULL",
          "FEAT_CRC32",
          "FEAT_DOTPROD",
          "FEAT_AES",
          "FEAT_SHA256",
          "FEAT_NEON"
        ]
      },
      "minItems": 1
    },
    "vectorRegisterWidthBits": {
      "type": "integer",
      "minimum": 64,
      "maximum": 512
    },
    "unrollFactor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "peakThroughputMBps": {
      "type": "number",
      "minimum": 0.0
    },
    "cBridgeSourceFile": {
      "type": "string",
      "minLength": 1
    }
  }
}
