{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipMatrixDiffReport",
  "type": "object",
  "required": [
    "baselineTimestamp",
    "candidateTimestamp",
    "totalComparedPoints",
    "passedPoints",
    "regressedPoints",
    "overallVerdict",
    "points"
  ],
  "properties": {
    "baselineTimestamp": {
      "type": "integer"
    },
    "candidateTimestamp": {
      "type": "integer"
    },
    "totalComparedPoints": {
      "type": "integer",
      "minimum": 0
    },
    "passedPoints": {
      "type": "integer",
      "minimum": 0
    },
    "regressedPoints": {
      "type": "integer",
      "minimum": 0
    },
    "overallVerdict": {
      "type": "string",
      "enum": [
        "PASS",
        "WARN",
        "FAIL"
      ]
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "engine",
          "corpus",
          "sizeBytes",
          "level",
          "baselineCompressThroughputMBs",
          "candidateCompressThroughputMBs",
          "compressSpeedDeltaPercent",
          "baselineDecompressThroughputMBs",
          "candidateDecompressThroughputMBs",
          "decompressSpeedDeltaPercent",
          "ratioDeltaPercent",
          "verdict"
        ],
        "properties": {
          "engine": {
            "type": "string"
          },
          "corpus": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer"
          },
          "level": {
            "type": "integer"
          },
          "baselineCompressThroughputMBs": {
            "type": "number"
          },
          "candidateCompressThroughputMBs": {
            "type": "number"
          },
          "compressSpeedDeltaPercent": {
            "type": "number"
          },
          "baselineDecompressThroughputMBs": {
            "type": "number"
          },
          "candidateDecompressThroughputMBs": {
            "type": "number"
          },
          "decompressSpeedDeltaPercent": {
            "type": "number"
          },
          "ratioDeltaPercent": {
            "type": "number"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "SPEEDUP",
              "FLAT",
              "WARN_REGRESSION",
              "FAIL_REGRESSION"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}