{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipDeltaAuditReport",
  "type": "object",
  "required": [
    "headSha",
    "headBranch",
    "baseSha",
    "baseBranch",
    "architecture",
    "binaryDelta",
    "compressionPoints",
    "totalRegressions",
    "overallVerdict"
  ],
  "properties": {
    "headSha": {
      "type": "string"
    },
    "headBranch": {
      "type": "string"
    },
    "baseSha": {
      "type": "string"
    },
    "baseBranch": {
      "type": "string"
    },
    "architecture": {
      "type": "string"
    },
    "totalRegressions": {
      "type": "integer",
      "minimum": 0
    },
    "overallVerdict": {
      "type": "string",
      "enum": [
        "PASS",
        "WARN",
        "FAIL"
      ]
    },
    "binaryDelta": {
      "type": "object",
      "required": [
        "targetName",
        "baseRawSizeBytes",
        "headRawSizeBytes",
        "rawDeltaBytes",
        "rawDeltaPercent",
        "baseStrippedSizeBytes",
        "headStrippedSizeBytes",
        "strippedDeltaBytes",
        "strippedDeltaPercent",
        "textDeltaBytes",
        "dataDeltaBytes",
        "bssDeltaBytes",
        "addedSymbols",
        "removedSymbols"
      ],
      "properties": {
        "targetName": {
          "type": "string"
        },
        "baseRawSizeBytes": {
          "type": "integer"
        },
        "headRawSizeBytes": {
          "type": "integer"
        },
        "rawDeltaBytes": {
          "type": "integer"
        },
        "rawDeltaPercent": {
          "type": "number"
        },
        "baseStrippedSizeBytes": {
          "type": "integer"
        },
        "headStrippedSizeBytes": {
          "type": "integer"
        },
        "strippedDeltaBytes": {
          "type": "integer"
        },
        "strippedDeltaPercent": {
          "type": "number"
        },
        "textDeltaBytes": {
          "type": "integer"
        },
        "dataDeltaBytes": {
          "type": "integer"
        },
        "bssDeltaBytes": {
          "type": "integer"
        },
        "addedSymbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removedSymbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "compressionPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "engine",
          "corpus",
          "level",
          "uncompressedBytes",
          "baseCompressedBytes",
          "headCompressedBytes",
          "deltaBytes",
          "deltaPercent",
          "verdict"
        ],
        "properties": {
          "engine": {
            "type": "string"
          },
          "corpus": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "uncompressedBytes": {
            "type": "integer"
          },
          "baseCompressedBytes": {
            "type": "integer"
          },
          "headCompressedBytes": {
            "type": "integer"
          },
          "deltaBytes": {
            "type": "integer"
          },
          "deltaPercent": {
            "type": "number"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "OPTIMIZATION",
              "IDENTICAL",
              "DRIFT",
              "REGRESSION"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}