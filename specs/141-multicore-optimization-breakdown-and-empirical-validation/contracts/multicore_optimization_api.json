{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MultiCoreOptimizationBreakdownReport",
  "description": "Schema for TTZip 8-point isolated multi-core empirical benchmark results.",
  "type": "object",
  "required": [
    "totalPoints",
    "passedCount",
    "averageSpeedup",
    "allPositiveDelta",
    "results"
  ],
  "properties": {
    "totalPoints": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "passedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "averageSpeedup": {
      "type": "number",
      "minimum": 0.0
    },
    "allPositiveDelta": {
      "type": "boolean"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "pointId",
          "pointName",
          "layer",
          "baselineThroughputMBs",
          "optimizedThroughputMBs",
          "speedupRatio",
          "isPositiveDelta",
          "integrityPassed"
        ],
        "properties": {
          "pointId": {
            "type": "string",
            "pattern": "^OP-[1-8]$"
          },
          "pointName": {
            "type": "string",
            "minLength": 3
          },
          "layer": {
            "type": "string",
            "enum": [
              "Memory",
              "Codec",
              "Container",
              "Hashing",
              "I/O",
              "Scheduling"
            ]
          },
          "baselineThroughputMBs": {
            "type": "number",
            "minimum": 0.0
          },
          "optimizedThroughputMBs": {
            "type": "number",
            "minimum": 0.0
          },
          "speedupRatio": {
            "type": "number",
            "minimum": 0.0
          },
          "isPositiveDelta": {
            "type": "boolean"
          },
          "integrityPassed": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
