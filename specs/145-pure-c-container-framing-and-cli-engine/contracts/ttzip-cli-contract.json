{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipCLIContract",
  "description": "JSON Schema specification for TTZip standalone CLI commands and diagnostic reports",
  "type": "object",
  "required": [
    "command",
    "status",
    "version",
    "duration_ms",
    "throughput_mb_s"
  ],
  "properties": {
    "command": {
      "type": "string",
      "enum": ["compress", "extract", "list", "test", "benchmark"]
    },
    "status": {
      "type": "string",
      "enum": ["success", "error"]
    },
    "version": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0.0
    },
    "throughput_mb_s": {
      "type": "number",
      "minimum": 0.0
    },
    "processed_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "entries_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
