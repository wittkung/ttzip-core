{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipVFSContract",
  "description": "JSON Schema specification for TTZip Virtual Filesystem & Diagnostic Inspection",
  "type": "object",
  "required": [
    "archive_path",
    "total_entries",
    "total_uncompressed_bytes",
    "total_compressed_bytes",
    "compression_ratio",
    "is_healthy",
    "detected_format"
  ],
  "properties": {
    "archive_path": {
      "type": "string"
    },
    "total_entries": {
      "type": "integer",
      "minimum": 0
    },
    "total_uncompressed_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "total_compressed_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "compression_ratio": {
      "type": "number",
      "minimum": 0.0
    },
    "is_healthy": {
      "type": "boolean"
    },
    "detected_format": {
      "type": "string",
      "enum": ["zip", "7z", "tar", "gz", "xz", "zst", "unknown"]
    }
  },
  "additionalProperties": false
}
