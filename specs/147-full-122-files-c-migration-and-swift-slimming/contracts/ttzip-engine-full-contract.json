{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipEngineFullContract",
  "description": "Unified JSON schema specification for TTZip 122-file full C engine migration and thin-binding API",
  "type": "object",
  "required": [
    "operation",
    "status",
    "archive_type",
    "total_files",
    "total_bytes",
    "duration_ms",
    "throughput_mb_s"
  ],
  "properties": {
    "operation": {
      "type": "string",
      "enum": ["archive_create", "archive_extract", "archive_inspect", "entry_preview", "split_volume", "inplace_append"]
    },
    "status": {
      "type": "string",
      "enum": ["success", "error", "partial"]
    },
    "archive_type": {
      "type": "string",
      "enum": ["zip", "7z", "tar", "gzip", "xz", "zstd", "bzip2", "rar"]
    },
    "total_files": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0.0
    },
    "throughput_mb_s": {
      "type": "number",
      "minimum": 0.0
    },
    "error_message": {
      "type": "string"
    },
    "recovery_record_percent": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    }
  },
  "additionalProperties": false
}
