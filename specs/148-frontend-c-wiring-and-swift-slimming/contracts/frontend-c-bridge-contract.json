{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrontendCBridgeContract",
  "description": "JSON schema for Frontend C-Microkernel Bridge interactions",
  "type": "object",
  "required": [
    "action",
    "status",
    "item_count",
    "duration_micros"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["natural_sort", "magic_sniff", "memory_preview", "tree_filter"]
    },
    "status": {
      "type": "string",
      "enum": ["success", "failure"]
    },
    "item_count": {
      "type": "integer",
      "minimum": 0
    },
    "duration_micros": {
      "type": "number",
      "minimum": 0.0
    },
    "detected_mime": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
