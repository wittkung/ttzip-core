{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuickstartSDKContract",
  "description": "JSON schema definition for Quickstart C SDK test execution",
  "type": "object",
  "required": [
    "example_name",
    "version",
    "tests_passed",
    "total_tests",
    "status"
  ],
  "properties": {
    "example_name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "tests_passed": {
      "type": "integer",
      "minimum": 0
    },
    "total_tests": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    }
  },
  "additionalProperties": false
}
