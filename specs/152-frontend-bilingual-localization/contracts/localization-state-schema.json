{
  "": "http://json-schema.org/draft-07/schema#",
  "title": "LocalizationStateEventSchema",
  "description": "Contract for reactive application localization state mutations and queries in TTZip.",
  "type": "object",
  "required": [
    "eventType",
    "language",
    "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "eventType": {
      "type": "string",
      "enum": [
        "LANGUAGE_CHANGED",
        "LOCALE_INITIALIZED",
        "UNITS_FORMAT_CHANGED"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "zh-Hans",
        "zh-Hant",
        "ja",
        "de",
        "fr",
        "es"
      ]
    },
    "timestamp": {
      "type": "number",
      "description": "Unix epoch timestamp in seconds"
    },
    "byteUnitStyle": {
      "type": "string",
      "enum": [
        "metricSI",
        "binaryIEC"
      ]
    }
  }
}