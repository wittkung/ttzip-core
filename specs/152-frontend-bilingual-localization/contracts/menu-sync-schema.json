{
  "": "http://json-schema.org/draft-07/schema#",
  "title": "AppKitMenuSyncSchema",
  "description": "Contract for synchronizing native AppKit menu bar items with active localized catalogs.",
  "type": "object",
  "required": [
    "menuIdentifier",
    "language",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "menuIdentifier": {
      "type": "string",
      "enum": [
        "app",
        "file",
        "edit",
        "view",
        "window",
        "help",
        "finderExtension"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "zh-Hans",
        "zh-Hant",
        "ja",
        "de",
        "fr",
        "es"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "selector",
          "rawKey",
          "localizedTitle"
        ],
        "additionalProperties": false,
        "properties": {
          "selector": {
            "type": "string",
            "description": "Objective-C selector string e.g. orderFrontStandardAboutPanel:"
          },
          "rawKey": {
            "type": "string",
            "pattern": "^[a-z]+(\\.[a-z0-9_]+)+$"
          },
          "localizedTitle": {
            "type": "string",
            "minLength": 1
          },
          "keyEquivalent": {
            "type": "string"
          }
        }
      }
    }
  }
}