{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoggingEventContract",
  "description": "JSON schema for TTZip structured telemetry and diagnostic log records",
  "type": "object",
  "required": [
    "timestamp_ms",
    "level",
    "subsystem",
    "message",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "level": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warning",
        "error"
      ]
    },
    "subsystem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "metadata": {
      "type": "object",
      "required": [
        "file",
        "line",
        "function",
        "thread_id"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "thread_id": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
