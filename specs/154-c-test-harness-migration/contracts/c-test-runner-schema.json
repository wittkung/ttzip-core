{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CTestRunnerReport",
  "description": "Schema for TTZip C test runner telemetry and execution summary.",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "platform",
    "sanitizers_enabled",
    "total_suites",
    "all_passed",
    "suites"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "sanitizers_enabled": {
      "type": "boolean"
    },
    "total_suites": {
      "type": "integer",
      "minimum": 1
    },
    "all_passed": {
      "type": "boolean"
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "suite_name",
          "total_tests",
          "passed_tests",
          "failed_tests",
          "skipped_tests",
          "total_assertions",
          "total_duration_nanos",
          "pass_rate",
          "test_cases"
        ],
        "additionalProperties": false,
        "properties": {
          "suite_name": {
            "type": "string",
            "minLength": 1
          },
          "total_tests": {
            "type": "integer",
            "minimum": 0
          },
          "passed_tests": {
            "type": "integer",
            "minimum": 0
          },
          "failed_tests": {
            "type": "integer",
            "minimum": 0
          },
          "skipped_tests": {
            "type": "integer",
            "minimum": 0
          },
          "total_assertions": {
            "type": "integer",
            "minimum": 0
          },
          "total_duration_nanos": {
            "type": "integer",
            "minimum": 0
          },
          "pass_rate": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 100.0
          },
          "test_cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "suite_name",
                "status",
                "duration_nanos",
                "assert_count"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "suite_name": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": ["passed", "failed", "skipped"]
                },
                "duration_nanos": {
                  "type": "integer",
                  "minimum": 0
                },
                "assert_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "fail_expr": {
                  "type": "string"
                },
                "fail_msg": {
                  "type": "string"
                },
                "fail_file": {
                  "type": "string"
                },
                "fail_line": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
