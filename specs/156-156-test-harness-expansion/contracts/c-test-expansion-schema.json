{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExpandedTestSuiteReport",
  "description": "Schema for expanded TTZip C test runner telemetry covering all 13 microkernel engines.",
  "type": "object",
  "required": [
    "schema_version",
    "total_suites",
    "total_assertions",
    "total_duration_ms",
    "engine_metrics"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "total_suites": {
      "type": "integer",
      "minimum": 13
    },
    "total_assertions": {
      "type": "integer",
      "minimum": 500
    },
    "total_duration_ms": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 50.0
    },
    "engine_metrics": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "engine_name",
          "operation",
          "throughput_mbs",
          "lossless_verified",
          "zero_leak_verified"
        ],
        "additionalProperties": false,
        "properties": {
          "engine_name": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "throughput_mbs": {
            "type": "number",
            "minimum": 0.0
          },
          "lossless_verified": {
            "type": "boolean"
          },
          "zero_leak_verified": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
