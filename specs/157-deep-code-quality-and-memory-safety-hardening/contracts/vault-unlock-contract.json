{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VaultUnlockContract",
  "description": "JSON schema for TTZip password vault master unlock request and response payloads",
  "type": "object",
  "required": [
    "request",
    "response"
  ],
  "additionalProperties": false,
  "properties": {
    "request": {
      "type": "object",
      "required": [
        "request_id",
        "timestamp_ms",
        "iteration_count",
        "is_async_offloaded"
      ],
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0
        },
        "iteration_count": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 100000
        },
        "is_async_offloaded": {
          "type": "boolean"
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "request_id",
        "success",
        "duration_ms",
        "error_code"
      ],
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}$"
        },
        "success": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0.0
        },
        "error_code": {
          "type": "string",
          "enum": [
            "NONE",
            "INVALID_PASSWORD",
            "CORRUPTED_VAULT",
            "CANCELLED"
          ]
        }
      }
    }
  }
}
