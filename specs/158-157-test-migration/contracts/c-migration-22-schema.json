{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FullMigrationReport",
  "description": "Schema for complete 22-file Swift microkernel test migration to C11.",
  "type": "object",
  "required": [
    "schema_version",
    "total_pruned_files",
    "total_c_suites",
    "total_c_duration_ms",
    "migration_clusters"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "total_pruned_files": {
      "type": "integer",
      "enum": [22]
    },
    "total_c_suites": {
      "type": "integer",
      "minimum": 19
    },
    "total_c_duration_ms": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 50.0
    },
    "migration_clusters": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "c_test_suite_path",
          "swift_files_pruned",
          "total_assertions"
        ],
        "additionalProperties": false,
        "properties": {
          "cluster_id": {
            "type": "string",
            "enum": [
              "adler_crc64",
              "entropy_evaluator",
              "matchfinder_advanced",
              "blosc_slicing",
              "crypto_lz4_snappy"
            ]
          },
          "c_test_suite_path": {
            "type": "string",
            "minLength": 1
          },
          "swift_files_pruned": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "total_assertions": {
            "type": "integer",
            "minimum": 10
          }
        }
      }
    }
  }
}
