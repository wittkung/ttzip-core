{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BenchmarkReport",
  "description": "Schema for TTZip native C11 benchmark execution telemetry.",
  "type": "object",
  "required": [
    "schema_version",
    "total_benchmarks",
    "total_duration_ms",
    "results",
    "pareto_points"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "total_benchmarks": {
      "type": "integer",
      "minimum": 1
    },
    "total_duration_ms": {
      "type": "number",
      "minimum": 0.0
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "category",
          "src_size",
          "dst_size",
          "elapsed_nanos",
          "throughput_mbs",
          "compression_ratio",
          "mips_score",
          "passed"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": ["Codec", "Checksum", "VFS", "Stress"]
          },
          "src_size": {
            "type": "integer",
            "minimum": 0
          },
          "dst_size": {
            "type": "integer",
            "minimum": 0
          },
          "elapsed_nanos": {
            "type": "integer",
            "minimum": 0
          },
          "throughput_mbs": {
            "type": "number",
            "minimum": 0.0
          },
          "compression_ratio": {
            "type": "number",
            "minimum": 0.0
          },
          "mips_score": {
            "type": "number",
            "minimum": 0.0
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "pareto_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "codec_name",
          "ratio_pct",
          "speed_mbs",
          "is_pareto_optimal"
        ],
        "additionalProperties": false,
        "properties": {
          "codec_name": {
            "type": "string",
            "minLength": 1
          },
          "ratio_pct": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 200.0
          },
          "speed_mbs": {
            "type": "number",
            "minimum": 0.0
          },
          "is_pareto_optimal": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
