{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PasswordVerifierPayload",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "enum": ["ZIP_TRADITIONAL", "ZIP_WINZIP_AES", "7Z_AES256"]
    },
    "candidateCount": {
      "type": "integer",
      "minimum": 1
    },
    "attemptsEvaluated": {
      "type": "integer",
      "minimum": 0
    },
    "isPasswordFound": {
      "type": "boolean"
    },
    "foundPassword": {
      "type": "string"
    }
  },
  "required": [
    "format",
    "candidateCount",
    "attemptsEvaluated",
    "isPasswordFound"
  ],
  "additionalProperties": false
}
