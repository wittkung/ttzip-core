{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ZipExtraFieldsPayload",
  "type": "object",
  "properties": {
    "extendedTimestamp": {
      "type": "object",
      "properties": {
        "modTime": { "type": "integer" },
        "accTime": { "type": "integer" },
        "createTime": { "type": "integer" }
      },
      "required": ["modTime"],
      "additionalProperties": false
    },
    "unicodePath": {
      "type": "string"
    },
    "posixPermissions": {
      "type": "object",
      "properties": {
        "uid": { "type": "integer", "minimum": 0 },
        "gid": { "type": "integer", "minimum": 0 }
      },
      "required": ["uid", "gid"],
      "additionalProperties": false
    },
    "zip64Info": {
      "type": "object",
      "properties": {
        "uncompressedSize": { "type": "integer", "minimum": 0 },
        "compressedSize": { "type": "integer", "minimum": 0 },
        "relativeOffset": { "type": "integer", "minimum": 0 },
        "diskNumber": { "type": "integer", "minimum": 0 }
      },
      "required": ["uncompressedSize", "compressedSize"],
      "additionalProperties": false
    },
    "winZipAES": {
      "type": "object",
      "properties": {
        "version": { "type": "integer" },
        "vendorId": { "type": "integer" },
        "strength": { "type": "integer", "enum": [128, 192, 256] },
        "actualMethod": { "type": "integer" }
      },
      "required": ["version", "vendorId", "strength", "actualMethod"],
      "additionalProperties": false
    }
  },
  "required": [],
  "additionalProperties": false
}
