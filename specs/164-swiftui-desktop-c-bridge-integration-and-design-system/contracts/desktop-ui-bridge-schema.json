{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipDesktopUIBridgeSchema",
  "description": "Strict JSON schema for TTZip C-to-SwiftUI progress event streaming, virtual tree projection, and layout alignment constraints.",
  "type": "object",
  "required": [
    "event_type",
    "timestamp",
    "progress_event",
    "layout_geometry",
    "virtual_tree_stats"
  ],
  "additionalProperties": false,
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "progress_snapshot",
        "tree_projected",
        "layout_sync",
        "single_item_extracted"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "progress_event": {
      "type": "object",
      "required": [
        "operation_type",
        "current_file_name",
        "completed_files",
        "total_files",
        "bytes_processed",
        "total_bytes",
        "fraction_completed",
        "instantaneous_mbs",
        "is_cancelled"
      ],
      "additionalProperties": false,
      "properties": {
        "operation_type": {
          "type": "string",
          "enum": [
            "compress",
            "extract",
            "inspect",
            "verify"
          ]
        },
        "current_file_name": {
          "type": "string"
        },
        "completed_files": {
          "type": "integer",
          "minimum": 0
        },
        "total_files": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_processed": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "fraction_completed": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "instantaneous_mbs": {
          "type": "number",
          "minimum": 0.0
        },
        "estimated_time_remaining_sec": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0
        },
        "is_cancelled": {
          "type": "boolean"
        }
      }
    },
    "layout_geometry": {
      "type": "object",
      "required": [
        "sidebar_width_pt",
        "workspace_min_width_pt",
        "inspector_width_pt",
        "top_inset_padding_pt",
        "header_bar_height_pt",
        "golden_rule_y_offset_pt",
        "kintsugi_gold_color_hex"
      ],
      "additionalProperties": false,
      "properties": {
        "sidebar_width_pt": {
          "type": "number",
          "minimum": 140.0,
          "maximum": 280.0
        },
        "workspace_min_width_pt": {
          "type": "number",
          "minimum": 450.0
        },
        "inspector_width_pt": {
          "type": "number",
          "minimum": 200.0,
          "maximum": 400.0
        },
        "top_inset_padding_pt": {
          "type": "number",
          "minimum": 0.0
        },
        "header_bar_height_pt": {
          "type": "number",
          "minimum": 0.0
        },
        "golden_rule_y_offset_pt": {
          "type": "number",
          "minimum": 0.0
        },
        "kintsugi_gold_color_hex": {
          "type": "string"
        }
      }
    },
    "virtual_tree_stats": {
      "type": "object",
      "required": [
        "total_nodes_in_arena",
        "visible_projected_rows",
        "estimated_memory_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "total_nodes_in_arena": {
          "type": "integer",
          "minimum": 0
        },
        "visible_projected_rows": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_memory_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}