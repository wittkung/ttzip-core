{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppleSiliconTopologySchedulingSchema",
  "description": "Strict JSON schema for Apple Silicon P/E-Core topology detection and heterogeneous QoS dispatch contracts.",
  "type": "object",
  "required": [
    "topology",
    "qos_policy",
    "chunk_slicing"
  ],
  "additionalProperties": false,
  "properties": {
    "topology": {
      "type": "object",
      "required": [
        "nperflevels",
        "p_cores",
        "p_l2_cache_bytes",
        "p_cpus_per_l2",
        "e_cores",
        "e_l2_cache_bytes",
        "e_cpus_per_l2",
        "cacheline_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "nperflevels": {
          "type": "integer",
          "minimum": 1
        },
        "p_cores": {
          "type": "integer",
          "minimum": 1
        },
        "p_l2_cache_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "p_cpus_per_l2": {
          "type": "integer",
          "minimum": 0
        },
        "e_cores": {
          "type": "integer",
          "minimum": 0
        },
        "e_l2_cache_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "e_cpus_per_l2": {
          "type": "integer",
          "minimum": 0
        },
        "cacheline_bytes": {
          "type": "integer",
          "enum": [
            64,
            128
          ]
        }
      }
    },
    "qos_policy": {
      "type": "object",
      "required": [
        "qos_tier",
        "target_qos_class",
        "worker_thread_count",
        "energy_saving_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "qos_tier": {
          "type": "string",
          "enum": [
            "performance",
            "efficiency",
            "all_cores"
          ]
        },
        "target_qos_class": {
          "type": "string",
          "enum": [
            "QOS_CLASS_USER_INTERACTIVE",
            "QOS_CLASS_USER_INITIATED",
            "QOS_CLASS_UTILITY",
            "QOS_CLASS_BACKGROUND",
            "DEFAULT"
          ]
        },
        "worker_thread_count": {
          "type": "integer",
          "minimum": 1
        },
        "energy_saving_mode": {
          "type": "boolean"
        }
      }
    },
    "chunk_slicing": {
      "type": "object",
      "required": [
        "p_core_optimal_chunk_bytes",
        "e_core_optimal_chunk_bytes",
        "alignment_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "p_core_optimal_chunk_bytes": {
          "type": "integer",
          "minimum": 262144,
          "maximum": 8388608
        },
        "e_core_optimal_chunk_bytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 2097152
        },
        "alignment_bytes": {
          "type": "integer",
          "enum": [
            128,
            4096
          ]
        }
      }
    }
  }
}