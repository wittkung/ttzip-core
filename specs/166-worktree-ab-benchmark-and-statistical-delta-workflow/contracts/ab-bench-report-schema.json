{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipABBenchmarkReportSchema",
  "description": "Strict JSON schema for TTZip Git Worktree A/B benchmark reports and statistical delta calculations.",
  "type": "object",
  "required": [
    "session",
    "metrics",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "session": {
      "type": "object",
      "required": [
        "session_id",
        "timestamp",
        "baseline_ref",
        "baseline_commit",
        "candidate_ref",
        "candidate_commit",
        "sample_runs",
        "platform",
        "overall_verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "baseline_ref": {
          "type": "string"
        },
        "baseline_commit": {
          "type": "string"
        },
        "candidate_ref": {
          "type": "string"
        },
        "candidate_commit": {
          "type": "string"
        },
        "sample_runs": {
          "type": "integer",
          "minimum": 1
        },
        "platform": {
          "type": "string"
        },
        "overall_verdict": {
          "type": "string",
          "enum": [
            "PASSED_NO_REGRESSION",
            "REGRESSION_DETECTED"
          ]
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "metric_name",
          "unit",
          "baseline_mean",
          "baseline_std",
          "candidate_mean",
          "candidate_std",
          "delta_percent",
          "t_statistic",
          "degrees_of_freedom",
          "p_value",
          "verdict"
        ],
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "codec_throughput",
              "checksum_throughput",
              "container_io",
              "peak_rss"
            ]
          },
          "metric_name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "baseline_mean": {
            "type": "number"
          },
          "baseline_std": {
            "type": "number"
          },
          "candidate_mean": {
            "type": "number"
          },
          "candidate_std": {
            "type": "number"
          },
          "delta_percent": {
            "type": "number"
          },
          "t_statistic": {
            "type": "number"
          },
          "degrees_of_freedom": {
            "type": "number"
          },
          "p_value": {
            "type": "number"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "SIGNIFICANT_SPEEDUP",
              "SIGNIFICANT_REGRESSION",
              "NOISE_FLAT"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_metrics_evaluated",
        "speedups_count",
        "regressions_count",
        "noise_count"
      ],
      "additionalProperties": false,
      "properties": {
        "total_metrics_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "speedups_count": {
          "type": "integer",
          "minimum": 0
        },
        "regressions_count": {
          "type": "integer",
          "minimum": 0
        },
        "noise_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}