{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipCryptoContract",
  "description": "Schema defining Apple Silicon ARM64 hardware-accelerated SIMD, Checksum, and Crypto pipelines",
  "type": "object",
  "required": ["algorithm", "hardwareAcceleration", "vectorWidthBits", "state"],
  "properties": {
    "algorithm": {
      "type": "string",
      "enum": [
        "crc32_pmull_fold12",
        "adler32_udot_nmax5552",
        "aes256_cbc_neon8way",
        "aes256_ctr_neon8way",
        "sha256_kdf_arm64"
      ]
    },
    "hardwareAcceleration": {
      "type": "string",
      "enum": ["arm64NeonCrypto", "x86Avx2AesNi", "scalarFallback"]
    },
    "vectorWidthBits": {
      "type": "integer",
      "enum": [64, 128, 256, 512]
    },
    "throughputFloorMBps": {
      "type": "number",
      "minimum": 500.0
    },
    "state": {
      "type": "object",
      "required": ["keyLengthBytes", "ivLengthBytes", "roundsCount", "isZeroizedOnDrop"],
      "properties": {
        "keyLengthBytes": { "type": "integer", "enum": [0, 16, 24, 32] },
        "ivLengthBytes": { "type": "integer", "enum": [0, 12, 16] },
        "roundsCount": { "type": "integer", "minimum": 0 },
        "isZeroizedOnDrop": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
