{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipGlueFFIContract",
  "description": "Strong-typed schema defining C-ABI / FFI boundary for TTZip Rust Glue operations",
  "type": "object",
  "required": ["version", "action", "requestId", "payload"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "type": "string",
      "enum": ["inspectArchive", "extractArchive", "createArchive"]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": { "const": "inspectArchive" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["archivePath"],
            "properties": {
              "archivePath": { "type": "string", "minLength": 1 },
              "password": { "type": ["string", "null"] },
              "detectEncoding": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": { "const": "extractArchive" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["archivePath", "destinationPath", "options"],
            "properties": {
              "archivePath": { "type": "string", "minLength": 1 },
              "destinationPath": { "type": "string", "minLength": 1 },
              "options": {
                "type": "object",
                "required": ["threadBudget", "overwriteExisting", "preservePermissions", "dryRun"],
                "properties": {
                  "password": { "type": ["string", "null"] },
                  "threadBudget": { "type": "integer", "minimum": 1, "maximum": 256 },
                  "overwriteExisting": { "type": "boolean" },
                  "preservePermissions": { "type": "boolean" },
                  "dryRun": { "type": "boolean" },
                  "selectedEntries": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": { "const": "createArchive" }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["sourcePaths", "destinationPath", "format", "level", "encryption", "threadBudget"],
            "properties": {
              "sourcePaths": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "destinationPath": { "type": "string", "minLength": 1 },
              "format": {
                "type": "string",
                "enum": ["zip", "sevenZip", "tar", "tarGz", "tarBz2", "tarXz", "tarZstd"]
              },
              "level": {
                "type": "integer",
                "enum": [0, 1, 3, 6, 9, 12]
              },
              "encryption": {
                "type": "string",
                "enum": ["none", "zipCrypto", "aes128", "aes192", "aes256"]
              },
              "password": { "type": ["string", "null"] },
              "threadBudget": { "type": "integer", "minimum": 1, "maximum": 256 },
              "solidBlockSizeMb": { "type": "integer", "minimum": 0, "maximum": 4096 }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "definitions": {
    "FFIResponse": {
      "type": "object",
      "required": ["requestId", "status", "statusMessage", "durationMs"],
      "properties": {
        "requestId": { "type": "string", "format": "uuid" },
        "status": {
          "type": "string",
          "enum": ["success", "cancelled", "error"]
        },
        "statusCode": { "type": "integer" },
        "statusMessage": { "type": "string" },
        "durationMs": { "type": "number", "minimum": 0 },
        "processedEntriesCount": { "type": "integer", "minimum": 0 },
        "totalUncompressedBytes": { "type": "integer", "minimum": 0 },
        "totalCompressedBytes": { "type": "integer", "minimum": 0 },
        "errorDetails": {
          "type": ["object", "null"],
          "properties": {
            "errorCode": { "type": "integer" },
            "errorDomain": { "type": "string" },
            "failingPath": { "type": ["string", "null"] },
            "panicPayload": { "type": ["string", "null"] }
          },
          "required": ["errorCode", "errorDomain"]
        }
      },
      "additionalProperties": false
    }
  }
}
