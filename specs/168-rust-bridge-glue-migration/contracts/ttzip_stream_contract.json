{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TTZipStreamContract",
  "description": "Schema defining micro-buffering stream pull/push pipeline and chunking invariants",
  "type": "object",
  "required": ["streamId", "streamMode", "bufferCapacityBytes", "maxResidentMemoryMb", "alignmentBytes"],
  "properties": {
    "streamId": {
      "type": "string",
      "format": "uuid"
    },
    "streamMode": {
      "type": "string",
      "enum": ["readSequential", "readSeekable", "writeSequential", "writeChunkedArena"]
    },
    "bufferCapacityBytes": {
      "type": "integer",
      "enum": [65536, 131072, 1048576, 2097152],
      "description": "64KB, 128KB, 1MB, or 2MB micro-buffers"
    },
    "maxResidentMemoryMb": {
      "type": "integer",
      "maximum": 64,
      "minimum": 4,
      "description": "Hard limit on task RSS resident memory"
    },
    "alignmentBytes": {
      "type": "integer",
      "enum": [16, 64, 128, 16384],
      "description": "SIMD 16B/64B or Apple Silicon 16KB Page alignment"
    },
    "compressionCodec": {
      "type": "string",
      "enum": ["raw", "deflate", "zstd", "lzma2", "lz4", "snappy", "lzfse"]
    },
    "streamState": {
      "type": "object",
      "required": ["bytesConsumed", "bytesWritten", "isEof", "hasError"],
      "properties": {
        "bytesConsumed": { "type": "integer", "minimum": 0 },
        "bytesWritten": { "type": "integer", "minimum": 0 },
        "isEof": { "type": "boolean" },
        "hasError": { "type": "boolean" },
        "lastErrorMsg": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
