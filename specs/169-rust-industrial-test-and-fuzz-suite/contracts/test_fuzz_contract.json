{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FuzzTestContract",
  "description": "Schema defining coverage-guided mutation fuzzing boundaries and invariants",
  "type": "object",
  "required": ["fuzzTarget", "mutationStrategies", "totalMutations", "maxMemoryMb", "allowedOutcome"],
  "properties": {
    "fuzzTarget": {
      "type": "string",
      "enum": ["zipCentralDirectory", "sevenzHeaderVarint", "safeExtractPathTraversals", "streamFaultInjection"]
    },
    "mutationStrategies": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["bitFlip", "byteTruncation", "offsetOverflow", "pathTraversalInjection", "corruptMagic"]
      }
    },
    "totalMutations": {
      "type": "integer",
      "minimum": 1000
    },
    "maxMemoryMb": {
      "type": "integer",
      "maximum": 64
    },
    "allowedOutcome": {
      "type": "string",
      "enum": ["gracefulErrorOrSuccess", "strictErrorRejectOnly"]
    }
  },
  "additionalProperties": false
}
