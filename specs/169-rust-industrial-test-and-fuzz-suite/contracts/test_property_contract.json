{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PropertyTestContract",
  "description": "Schema defining property-based test invariant parameters and assertion outcomes",
  "type": "object",
  "required": ["testCategory", "iterationsCount", "minPayloadBytes", "maxPayloadBytes", "assertionInvariant"],
  "properties": {
    "testCategory": {
      "type": "string",
      "enum": ["codecsRoundtrip", "archiveTreeHierarchy", "winzipAesEncryption", "sevenzAesEncryption"]
    },
    "iterationsCount": {
      "type": "integer",
      "minimum": 50
    },
    "minPayloadBytes": {
      "type": "integer",
      "minimum": 0
    },
    "maxPayloadBytes": {
      "type": "integer",
      "maximum": 52428800
    },
    "assertionInvariant": {
      "type": "string",
      "enum": ["losslessExactByteMatch", "directoryStructureIdentical", "correctPasswordSuccessAndWrongPasswordReject"]
    }
  },
  "additionalProperties": false
}
