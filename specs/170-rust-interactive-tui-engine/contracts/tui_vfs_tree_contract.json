{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TUIVfsTreeContract",
  "description": "Schema defining virtual file system tree structure and fuzzy search match highlights",
  "type": "object",
  "required": ["rootPath", "totalEntriesCount", "totalUncompressedBytes", "nodes"],
  "properties": {
    "rootPath": { "type": "string" },
    "totalEntriesCount": { "type": "integer", "minimum": 0 },
    "totalUncompressedBytes": { "type": "integer", "minimum": 0 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "relativePath", "isDirectory", "uncompressedSize", "compressedSize", "crc32", "isEncrypted"],
        "properties": {
          "name": { "type": "string" },
          "relativePath": { "type": "string" },
          "isDirectory": { "type": "boolean" },
          "uncompressedSize": { "type": "integer", "minimum": 0 },
          "compressedSize": { "type": "integer", "minimum": 0 },
          "crc32": { "type": "integer" },
          "isEncrypted": { "type": "boolean" },
          "matchIndices": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
