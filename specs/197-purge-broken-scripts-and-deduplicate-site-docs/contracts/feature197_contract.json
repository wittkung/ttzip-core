{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature197Contract",
  "description": "Contract for Feature 197 broken scripts purge and website deduplication.",
  "type": "object",
  "required": [
    "broken_scripts_purged",
    "site_dir_purged",
    "docs_loose_duplicates_purged",
    "zero_regression"
  ],
  "properties": {
    "broken_scripts_purged": {
      "type": "boolean",
      "enum": [true]
    },
    "site_dir_purged": {
      "type": "boolean",
      "enum": [true]
    },
    "docs_loose_duplicates_purged": {
      "type": "boolean",
      "enum": [true]
    },
    "zero_regression": {
      "type": "boolean",
      "enum": [true]
    }
  },
  "additionalProperties": false
}
