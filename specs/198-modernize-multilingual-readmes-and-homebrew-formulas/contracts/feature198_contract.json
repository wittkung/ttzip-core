{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature198Contract",
  "description": "Contract for Feature 198 multilingual README modernization and Formula synchronization.",
  "type": "object",
  "required": [
    "chinese_install_script_purged",
    "homebrew_formulas_synchronized",
    "multilingual_readmes_aligned",
    "zero_regression"
  ],
  "properties": {
    "chinese_install_script_purged": {
      "type": "boolean",
      "enum": [true]
    },
    "homebrew_formulas_synchronized": {
      "type": "boolean",
      "enum": [true]
    },
    "multilingual_readmes_aligned": {
      "type": "boolean",
      "enum": [true]
    },
    "zero_regression": {
      "type": "boolean",
      "enum": [true]
    }
  },
  "additionalProperties": false
}
