{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature199Contract",
  "description": "Contract for Feature 199 obsolete examples and hidden build dirs purge.",
  "type": "object",
  "required": [
    "examples_purged",
    "hidden_build_dirs_purged",
    "zero_regression"
  ],
  "properties": {
    "examples_purged": {
      "type": "boolean",
      "enum": [true]
    },
    "hidden_build_dirs_purged": {
      "type": "boolean",
      "enum": [true]
    },
    "zero_regression": {
      "type": "boolean",
      "enum": [true]
    }
  },
  "additionalProperties": false
}
