{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LocalCiGateReport",
  "type": "object",
  "required": [
    "totalStages",
    "passedStages",
    "failedStages",
    "totalDurationSeconds",
    "isSuccess",
    "stages"
  ],
  "properties": {
    "totalStages": { "type": "integer", "minimum": 1 },
    "passedStages": { "type": "integer", "minimum": 0 },
    "failedStages": { "type": "integer", "minimum": 0 },
    "totalDurationSeconds": { "type": "number", "minimum": 0.0 },
    "isSuccess": { "type": "boolean" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stageIndex",
          "name",
          "command",
          "status",
          "durationSeconds"
        ],
        "properties": {
          "stageIndex": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "command": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skip"] },
          "durationSeconds": { "type": "number", "minimum": 0.0 },
          "diagnosticMessage": { "type": ["string", "null"] }
        }
      }
    }
  }
}
