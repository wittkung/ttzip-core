{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PresentationCoordinatorContract",
  "type": "object",
  "required": ["activeModal", "isModalActive"],
  "properties": {
    "activeModal": {
      "type": "object",
      "required": ["tier", "kind"],
      "properties": {
        "tier": {
          "type": "integer",
          "enum": [0, 1, 2, 3]
        },
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "globalSearch",
            "omnibarQuickPeeker",
            "compressConfig",
            "archiveInspector",
            "preferences",
            "passwordPrompt",
            "fatalRecoveryAlert"
          ]
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "isModalActive": {
      "type": "boolean"
    }
  }
}
