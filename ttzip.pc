prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: ttzip
Description: High-performance native archiving and compression engine
Version: 1.0.0
Libs: -L${libdir} -lttzip_engine
Libs.private: -larchive -lbz2 -lz -llzma -lpthread -framework Security -framework CoreFoundation
Cflags: -I${includedir}
