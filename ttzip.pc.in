prefix=@PREFIX@
exec_prefix=${prefix}
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: ttzip
Description: High-performance native archiving and compression engine
Version: @VERSION@
Libs: -L${libdir} -lttzip_engine
Libs.private: @LIBS_PRIVATE@
Cflags: -I${includedir}
