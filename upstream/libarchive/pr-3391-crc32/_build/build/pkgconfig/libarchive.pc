prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libarchive
Description: library that can create and read several streaming archive formats
Version: 3.9.0
Cflags: -I${includedir}
Cflags.private: -DLIBARCHIVE_STATIC
Libs: -L${libdir} -larchive
Libs.private:  -lz -lbz2 -llzma -lb2 -llz4 -lzstd -liconv -lcharset -lxml2 -L/usr/lib -lxml2 -lz -lpthread -licucore -lm
Requires.private: 
